{
  "name": "wechat-mini-program-backend",
  "version": "1.0.0",
  "description": "微信小程序后端 API，使用 Node.js + Express + SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "keywords": [
    "wechat",
    "mini-program",
    "express",
    "sqlite",
    "api"
  ],
  "author": "Developer",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "better-sqlite3": "^8.5.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}

{
  \"name\": \"option-trading-backend\",
  \"version\": \"1.0.0\",
  \"description\": \"期权交易平台后端服务 - 完整的期权交易、报价、风险管理系统\",
  \"main\": \"app.js\",
  \"scripts\": {
    \"start\": \"node app.js\",
    \"dev\": \"nodemon app.js\",
    \"test\": \"jest\",
    \"test:watch\": \"jest --watch\",
    \"test:coverage\": \"jest --coverage\",
    \"lint\": \"eslint . --ext .js\",
    \"lint:fix\": \"eslint . --ext .js --fix\",
    \"docker:build\": \"docker build -t option-trading-backend .\",
    \"docker:run\": \"docker run -p 3000:3000 option-trading-backend\",
    \"migrate\": \"node scripts/migrate.js\",
    \"seed\": \"node scripts/seed.js\",
    \"backup\": \"node scripts/backup.js\",
    \"logs\": \"tail -f logs/combined.log\",
    \"logs:error\": \"tail -f logs/error.log\"
  },
  \"keywords\": [
    \"option\",
    \"trading\",
    \"finance\",
    \"derivatives\",
    \"black-scholes\",
    \"risk-management\",
    \"real-time\",
    \"socket.io\",
    \"express\",
    \"mongodb\",
    \"redis\"
  ],
  \"author\": \"Option Trading Platform Team\",
  \"license\": \"MIT\",
  \"engines\": {
    \"node\": \">=16.0.0\",
    \"npm\": \">=8.0.0\"
  },
  \"dependencies\": {
    \"express\": \"^4.18.2\",
    \"mongoose\": \"^7.5.0\",
    \"socket.io\": \"^4.7.2\",
    \"cors\": \"^2.8.5\",
    \"helmet\": \"^7.0.0\",
    \"compression\": \"^1.7.4\",
    \"express-rate-limit\": \"^6.10.0\",
    \"express-slow-down\": \"^1.6.0\",
    \"express-validator\": \"^7.0.1\",
    \"jsonwebtoken\": \"^9.0.2\",
    \"bcryptjs\": \"^2.4.3\",
    \"ioredis\": \"^5.3.2\",
    \"dotenv\": \"^16.3.1\",
    \"winston\": \"^3.10.0\",
    \"winston-daily-rotate-file\": \"^4.7.1\",
    \"uuid\": \"^9.0.0\",
    \"moment\": \"^2.29.4\",
    \"lodash\": \"^4.17.21\",
    \"multer\": \"^1.4.5-lts.1\",
    \"sharp\": \"^0.32.5\",
    \"axios\": \"^1.5.0\",
    \"nodemailer\": \"^6.9.4\",
    \"crypto\": \"^1.0.1\",
    \"zlib\": \"^1.0.5\"
  },
  \"devDependencies\": {
    \"nodemon\": \"^3.0.1\",
    \"jest\": \"^29.6.4\",
    \"supertest\": \"^6.3.3\",
    \"eslint\": \"^8.47.0\",
    \"eslint-config-prettier\": \"^9.0.0\",
    \"eslint-plugin-prettier\": \"^5.0.0\",
    \"prettier\": \"^3.0.2\",
    \"@types/node\": \"^20.5.0\",
    \"husky\": \"^8.0.3\",
    \"lint-staged\": \"^14.0.1\"
  },
  \"jest\": {
    \"testEnvironment\": \"node\",
    \"coverageDirectory\": \"coverage\",
    \"collectCoverageFrom\": [
      \"**/*.js\",
      \"!**/node_modules/**\",
      \"!**/coverage/**\",
      \"!**/logs/**\"
    ],
    \"testMatch\": [
      \"**/__tests__/**/*.test.js\",
      \"**/?(*.)+(spec|test).js\"
    ]
  },
  \"lint-staged\": {
    \"*.js\": [
      \"eslint --fix\",
      \"prettier --write\"
    ]
  },
  \"husky\": {
    \"hooks\": {
      \"pre-commit\": \"lint-staged\",
      \"pre-push\": \"npm test\"
    }
  },
  \"repository\": {
    \"type\": \"git\",
    \"url\": \"https://github.com/your-org/option-trading-backend.git\"
  },
  \"bugs\": {
    \"url\": \"https://github.com/your-org/option-trading-backend/issues\"
  },
  \"homepage\": \"https://github.com/your-org/option-trading-backend#readme\"
}