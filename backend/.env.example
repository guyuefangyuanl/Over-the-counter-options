# 应用配置
APP_NAME=Option Trading Platform
APP_VERSION=1.0.0
APP_DESCRIPTION=期权交易平台后端服务
NODE_ENV=development
DEBUG=false
PORT=3000
HOST=0.0.0.0

# API配置
API_PREFIX=/api
API_VERSION=v1

# 跨域配置
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=true

# 安全配置
TRUST_PROXY=true
CSP_ENABLED=false

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-please-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-please-change-in-production
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
JWT_ISSUER=option-trading-platform
JWT_AUDIENCE=option-trading-users

# 数据库配置
DB_HOST=localhost
DB_PORT=27017
DB_NAME=option_trading
DB_USER=
DB_PASSWORD=
DB_AUTH_SOURCE=admin
DB_REPLICA_SET=
DB_SSL=false
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_MAX_IDLE_TIME=30000
DB_SERVER_SELECTION_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000
DB_READ_PREFERENCE=primary
DB_WRITE_CONCERN=majority
DB_JOURNAL=true
DB_WRITE_TIMEOUT=5000

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=option_trading:
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_RETRY_DELAY=100
REDIS_MAX_RETRIES=3
REDIS_MAX_POOL_SIZE=10
REDIS_MIN_POOL_SIZE=2

# 微信配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_MCH_ID=your_wechat_mch_id
WECHAT_API_KEY=your_wechat_api_key
WECHAT_NOTIFY_URL=https://yourdomain.com/api/payment/notify
WECHAT_MINI_APP_ID=your_mini_program_app_id
WECHAT_MINI_SECRET=your_mini_program_secret

# 短信配置
SMS_PROVIDER=aliyun
# 阿里云短信配置
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=your_sms_sign_name
ALIYUN_SMS_TEMPLATE_CODE=your_sms_template_code
# 腾讯云短信配置
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_SMS_SDK_APP_ID=your_tencent_sms_sdk_app_id
TENCENT_SMS_SIGN_NAME=your_tencent_sms_sign_name
TENCENT_SMS_TEMPLATE_ID=your_tencent_sms_template_id

# 邮件配置
EMAIL_SERVICE=qq
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_email_password
EMAIL_FROM=your_email@qq.com
EMAIL_VERIFICATION_TEMPLATE=verification
EMAIL_PASSWORD_RESET_TEMPLATE=password-reset
EMAIL_NOTIFICATION_TEMPLATE=notification

# 文件存储配置
STORAGE_PROVIDER=local
# 本地存储配置
LOCAL_UPLOAD_DIR=./uploads
LOCAL_PUBLIC_URL=/uploads
MAX_FILE_SIZE=10485760
# 阿里云OSS配置
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ACCESS_KEY_ID=your_oss_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
ALIYUN_OSS_BUCKET=your_oss_bucket
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_CUSTOM_DOMAIN=
# 腾讯云COS配置
TENCENT_COS_SECRET_ID=your_cos_secret_id
TENCENT_COS_SECRET_KEY=your_cos_secret_key
TENCENT_COS_REGION=ap-beijing
TENCENT_COS_BUCKET=your_cos_bucket

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_DIR=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_CONSOLE_ENABLED=true
LOG_COLORIZE=true
LOG_REMOTE_ENABLED=false
LOG_REMOTE_URL=
LOG_REMOTE_API_KEY=

# 缓存配置
CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=1000
CACHE_MARKET_DATA_TTL=60
CACHE_USER_SESSION_TTL=1800
CACHE_API_RESPONSE_TTL=300

# 健康检查配置
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000

# 性能监控配置
PERFORMANCE_MONITORING_ENABLED=false
PERFORMANCE_SAMPLE_RATE=0.1

# 错误追踪配置
ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_DSN=

# 加密配置
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=your-32-character-encryption-key

# 请求限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_SKIP_SUCCESS=false

# 管理员配置
ADMIN_OPEN_IDS=admin_openid_1,admin_openid_2

# API密钥配置（用于第三方集成）
VALID_API_KEYS=api_key_1,api_key_2

# 静态文件配置
STATIC_DIR=./public
STATIC_PATH=/static
UPLOAD_DIR=./uploads

# 生产环境专用配置（请在生产环境中设置）
# MONGODB_URI=mongodb://username:password@host:port/database
# REDIS_URL=redis://username:password@host:port
# JWT_SECRET=your-production-jwt-secret
# JWT_REFRESH_SECRET=your-production-refresh-secret