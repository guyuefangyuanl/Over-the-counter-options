# ===========================================
# 股票交易系统 - 环境变量配置示例
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改下面的配置值
# 3. 不要将 .env 提交到版本控制系统
# ===========================================

# 应用配置
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# 数据库配置
DB_PATH=./trading.db

# JWT配置（用于用户认证）
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 日志配置
LOG_LEVEL=debug

# API配置
API_VERSION=v1
API_RATE_LIMIT=100

# WebSocket配置
WS_HEARTBEAT_INTERVAL=30000

# 第三方API密钥（如果需要）
STOCK_API_KEY=your-api-key-here
STOCK_API_URL=https://api.stockdata.com

# Redis配置（如果使用缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 邮件配置（如果需要通知）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password
