{
  "name": "stock-trading-backend",
  "version": "1.0.0",
  "description": "股票交易后端服务",
  "main": "app.js",
  "scripts": {
    "start": "python app.py",
    "dev:flask": "python app.py",
    "dev:ui": "npm run dev --prefix admin-ui",
    "dev:node-ui": "npm run dev:ui",
    "dev": "concurrently \"npm run dev:flask\" \"npm run dev:ui\"",
    "check:urls": "node scripts/check-hardcoded-urls.js",
    "deploy:functions": "node scripts/deploy-cloudfunctions.js",
    "monitor:functions": "node scripts/monitor-cloudfunctions.js",
    "dashboard": "open admin-web/cloud-functions-dashboard.html",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "stock",
    "trading",
    "websocket"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "better-sqlite3": "^12.4.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "miniprogram-automator": "^0.12.1",
    "nodemon": "^3.1.9"
  }
}
