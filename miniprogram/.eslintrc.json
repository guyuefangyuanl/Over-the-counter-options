{
  "env": { "es6": true, "browser": true, "node": true },
  "extends": ["eslint:recommended"],
  "parserOptions": { "ecmaVersion": 2020, "sourceType": "module" },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-undef": "error",
    "no-console": ["off"],
    "eqeqeq": ["error", "always"],
    "curly": "error",
    "no-var": "error",
    "prefer-const": "warn"
  },
  "ignorePatterns": ["pages/inquiry/*.md", "**/__tests__/**"]
}