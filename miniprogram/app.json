{
  "lazyCodeLoading": "requiredComponents",
  "pages": [
    "pages/index/index",
    "pages/quotes/quotes",
    "pages/quotes/inquiry-complete",
    "pages/account/account",
    "pages/profile/profile",
    "pages/login/login"
  ],
  "subPackages": [
    {
      "root": "subpackages/quotes",
      "name": "quotes",
      "pages": [
        "search/search",
        "search-stock/search-stock",
        "stock-detail/stock-detail"
      ]
    },
    {
      "root": "subpackages/tools",
      "name": "tools",
      "pages": [
        "calculator/calculator",
        "chart/chart",
        "option-matrix/option-matrix",
        "workspace/workspace",
        "workbench/workbench",
        "data-explanation/data-explanation"
      ]
    },
    {
      "root": "subpackages/user",
      "name": "user",
      "pages": [
        "orders/orders",
        "transaction/transaction",
        "user-info/user-info",
        "risk/risk",
        "member/member",
        "position/position",
        "inquiry-history/inquiry-history",
        "feedback/feedback",
        "login-history/login-history"
      ]
    },
    {
      "root": "subpackages/info",
      "name": "info",
      "pages": [
        "knowledge/knowledge",
        "knowledge-detail/knowledge-detail",
        "news/news"
      ]
    },
    {
      "root": "subpackages/agreement",
      "name": "agreement",
      "pages": [
        "user-agreement/user-agreement",
        "privacy-policy/privacy-policy"
      ]
    },
    {
      "root": "subpackages/inquiry",
      "name": "inquiry",
      "pages": [
        "inquiry/inquiry",
        "inquiry/detail/detail"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["quotes", "tools"]
    },
    "pages/quotes/quotes": {
      "network": "all",
      "packages": ["inquiry"]
    },
    "pages/account/account": {
      "network": "all",
      "packages": ["user"]
    }
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#409EFF",
    "navigationBarTitleText": "期权大师",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#f5f7fa"
  },
  "tabBar": {
    "custom": true,
    "color": "#999999",
    "selectedColor": "#409EFF",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "images/home.png",
        "selectedIconPath": "images/home.png"
      },
      {
        "pagePath": "pages/quotes/quotes",
        "text": "报价",
        "iconPath": "images/inquiry.png",
        "selectedIconPath": "images/inquiry.png"
      },
      {
        "pagePath": "pages/account/account",
        "text": "账户",
        "iconPath": "images/account-active.png",
        "selectedIconPath": "images/account-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "images/profile.png",
        "selectedIconPath": "images/profile.png"
      }
    ]
  },
  "permission": {
    "scope.userLocation": {
      "desc": "您的位置信息将用于小程序位置接口的效果展示"
    }
  },
  "requiredBackgroundModes": [
    "audio"
  ],
  "networkTimeout": {
    "request": 60000,
    "downloadFile": 10000
  },
  "debug": false,
  "sitemapLocation": "sitemap.json"
}