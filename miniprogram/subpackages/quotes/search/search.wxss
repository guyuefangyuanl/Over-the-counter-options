
/* pages/search/search.wxss */
page {
  height: 100%;
  background-color: #F7F7F7;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.search-page {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* 1. 顶部固定搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EFEFEF;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.search-bar__input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #F7F7F7;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-bar__icon {
  margin-right: 16rpx;
  color: #999;
}

.search-bar__input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}

.search-bar__clear {
  padding: 10rpx;
}

.search-bar__cancel {
  margin-left: 24rpx;
  font-size: 30rpx;
  color: #07C160;
  font-weight: 500;
}

/* 2. 主体内容区域 */
.search-content {
  flex: 1;
  padding-top: 104rpx; /* 预留出搜索栏高度 */
  box-sizing: border-box;
}

/* 2.1 历史记录 */
.history-section {
  padding: 32rpx 24rpx;
}

.history-section__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.history-section__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.history-section__clear-btn {
  padding: 10rpx;
}

.history-section__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-section__tag {
  background-color: #f2f2f2;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

/* 2.2 快速查询 */
.quick-query-section {
  padding: 24rpx;
}

.quick-query-card {
  background-color: #E6F0FF;
  border-radius: 12rpx;
  padding: 32rpx 24rpx;
}

.quick-query-header {
  font-size: 32rpx;
  font-weight: bold;
  color: #3B82F6;
  margin-bottom: 24rpx;
}

.quick-query-list {
  background-color: #FFFFFF;
  border-radius: 8rpx;
  overflow: hidden;
}

.quick-query-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #F0F0F0;
}

.quick-query-item:last-child {
  border-bottom: none;
}

.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid #CCC;
  border-right: 2rpx solid #CCC;
  transform: rotate(45deg);
}

/* 2.2 搜索建议 */
.suggestions-list {
  background-color: #FFFFFF;
  border-top: 1rpx solid #EFEFEF;
}

.suggestions-list__item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #F7F7F7;
}

.suggestions-list__item:last-child {
  border-bottom: none;
}

.suggestions-list__icon {
  margin-right: 16rpx;
  color: #999;
}

/* 2.3 搜索结果 */
.results-section {
  padding: 24rpx;
}

/* 加载中 */
.results-section__loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 100rpx;
  color: #999;
  font-size: 26rpx;
}

.loading-indicator {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #E0E0E0;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态 */
.results-section__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 100rpx;
  color: #999;
  font-size: 28rpx;
}

.results-section__empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

/* 结果列表 */
.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EFEFEF;
}

.result-item__left {
  display: flex;
  flex-direction: column;
}

.result-item__name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.result-item__code {
  font-size: 24rpx;
  color: #999;
}

.result-item__right {
  text-align: right;
}

.result-item__price {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.result-item__change {
  font-size: 24rpx;
  color: #999;
}

.is-rise {
  color: #E54D42 !important;
}

.is-fall {
  color: #39B54A !important;
}
