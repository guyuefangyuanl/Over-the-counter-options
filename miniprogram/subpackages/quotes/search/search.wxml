
<!-- pages/search/search.wxml -->
<view class="search-page">
  <!-- 1. 顶部固定搜索栏 -->
  <view class="search-bar">
    <view class="search-bar__input-wrapper">
      <icon class="search-bar__icon" type="search" size="16"></icon>
      <input 
        class="search-bar__input" 
        placeholder="搜索个股、指数、ETF期权" 
        value="{{inputValue}}"
        focus
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onConfirm"
      />
      <icon wx:if="{{inputValue}}" class="search-bar__clear" type="clear" size="16" bindtap="onClearInput"></icon>
    </view>
    <view class="search-bar__cancel" bindtap="onCancel">取消</view>
  </view>

  <!-- 2. 主体内容区域 -->
  <scroll-view class="search-content" scroll-y>

    <!-- 2.1 历史记录 -->
    <view wx:if="{{historyVisible && history.length > 0}}" class="history-section">
      <view class="history-section__header">
        <text class="history-section__title">搜索历史</text>
        <view class="history-section__clear-btn" bindtap="onClearHistory">
          <icon type="clear" size="14" color="#999"></icon>
        </view>
      </view>
      <view class="history-section__tags">
        <text 
          wx:for="{{history}}"
          wx:key="*this"
          class="history-section__tag"
          data-query="{{item}}"
          bindtap="onTagTap"
        >{{item}}</text>
      </view>
    </view>

    <!-- 2.2 快速查询 (根据设计图新增) -->
    <view wx:if="{{historyVisible}}" class="quick-query-section">
      <view class="quick-query-card">
        <view class="quick-query-header">快速查询</view>
        <view class="quick-query-list">
          <view class="quick-query-item" bindtap="onQuickQuery" data-type="otc">
            <text>沪深场外个股期权</text>
            <view class="arrow-right"></view>
          </view>
          <view class="quick-query-item" bindtap="onQuickQuery" data-type="vanilla">
            <text>香草期权</text>
            <view class="arrow-right"></view>
          </view>
          <view class="quick-query-item" bindtap="onQuickQuery" data-type="exchange">
            <text>沪深场内期权</text>
            <view class="arrow-right"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 2.2 搜索建议 -->
    <view wx:if="{{showSuggestions}}" class="suggestions-list">
      <view 
        wx:for="{{suggestions}}"
        wx:key="id"
        class="suggestions-list__item"
        data-query="{{item.text}}"
        bindtap="onConfirm"
      >
        <icon class="suggestions-list__icon" type="search" size="14"></icon>
        <text>{{item.text}}</text>
      </view>
    </view>

    <!-- 2.3 搜索结果 -->
    <view wx:if="{{showResults}}" class="results-section">
      <!-- 加载中 -->
      <view wx:if="{{isLoading}}" class="results-section__loading">
        <view class="loading-indicator"></view>
        <text>正在加载...</text>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{isNoResult}}" class="results-section__empty">
        <image class="results-section__empty-img" src="/images/icons/empty-box.png" mode="aspectFit"></image>
        <text>没有找到相关内容</text>
      </view>

      <!-- 结果卡片 -->
      <view wx:if="{{!isLoading && !isNoResult}}" class="results-section__cards">
        <view 
          wx:for="{{results}}"
          wx:key="id"
          class="result-item"
          bindtap="onResultTap"
          data-item="{{item}}"
        >
          <view class="result-item__left">
            <view class="result-item__name">{{item.name}}</view>
            <view class="result-item__code">{{item.code}}</view>
          </view>
          <view class="result-item__right">
            <view class="result-item__price {{item.changePercent > 0 ? 'is-rise' : (item.changePercent < 0 ? 'is-fall' : '')}}">{{item.price || '--'}}</view>
            <view class="result-item__change {{item.changePercent > 0 ? 'is-rise' : (item.changePercent < 0 ? 'is-fall' : '')}}">{{item.changePercent ? (item.changePercent > 0 ? '+' : '') + item.changePercent + '%' : '--'}}</view>
          </view>
        </view>
      </view>
    </view>

  </scroll-view>
</view>
