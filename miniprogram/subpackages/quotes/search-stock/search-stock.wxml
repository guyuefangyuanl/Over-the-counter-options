<!-- 搜索股票页面 - 优化版 -->
<view class="search-stock-container">
  <!-- 顶部搜索栏 -->
  <view class="search-header">
    <view class="search-input-wrapper">
      <icon class="search-icon-icon" type="search" size="14" color="#999"></icon>
      <input
        class="search-input"
        placeholder="搜索股票代码或名称"
        value="{{keyword}}"
        bindinput="onInput"
        bindconfirm="onSearchConfirm"
        focus="{{true}}"
        confirm-type="search"
        placeholder-class="search-placeholder"
      />
      <icon 
        wx:if="{{keyword}}" 
        class="search-clear" 
        type="clear" 
        size="14" 
        bindtap="onClearInput"
      ></icon>
    </view>
    <text class="cancel-btn" bindtap="goBack">取消</text>
  </view>

  <!-- 搜索历史 -->
  <view class="search-history" wx:if="{{showHistory && searchHistory.length > 0}}">
    <view class="history-header">
      <text class="history-title">搜索历史</text>
      <text class="history-clear" bindtap="clearSearchHistory">清空</text>
    </view>
    <view class="history-tags">
      <text
        class="history-tag"
        wx:for="{{searchHistory}}"
        wx:key="*this"
        data-keyword="{{item}}"
        bindtap="onHistoryTap"
      >{{item}}</text>
    </view>
  </view>

  <!-- 搜索结果 -->
  <scroll-view 
    scroll-y 
    class="search-results" 
    wx:if="{{showResults}}"
    bindscrolltolower="loadMoreResults"
  >
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{loading && results.length === 0}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">搜索中...</text>
    </view>

    <!-- 结果列表 -->
    <view wx:if="{{results.length > 0}}">
      <view
        class="stock-item"
        wx:for="{{results}}"
        wx:key="code"
        bindtap="onSelectStock"
        data-item="{{item}}"
      >
        <view class="stock-left">
          <text class="stock-name">{{item.name}}</text>
          <text class="stock-code">{{item.displayCode || item.code}}</text>
        </view>
        <view class="stock-right">
          <text class="stock-price {{item.changePercent >= 0 ? 'up' : 'down'}}">{{item.price}}</text>
          <text class="stock-change {{item.changePercent >= 0 ? 'up' : 'down'}}">
            {{item.changePercent >= 0 ? '+' : ''}}{{item.changePercent}}%
          </text>
        </view>
      </view>
      
      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{hasMore}}">
        <text class="load-more-text">{{loading ? '加载中...' : '上拉加载更多'}}</text>
      </view>
      
      <!-- 没有更多 -->
      <view class="no-more" wx:if="{{!hasMore && results.length > 0}}">
        <text class="no-more-text">已加载全部结果</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:elif="{{!loading && results.length === 0}}">
      <text class="empty-icon">📈</text>
      <text class="empty-text">未找到相关股票</text>
      <text class="empty-hint">请检查输入的股票代码或名称</text>
    </view>
  </scroll-view>

  <!-- 热门推荐（初始状态） -->
  <scroll-view scroll-y class="hot-stocks-container" wx:elif="{{!keyword && !showHistory}}">
    <view class="hot-stocks">
      <view class="hot-header">
        <text class="hot-title">热门股票</text>
        <text class="hot-subtitle">实时行情</text>
      </view>
      <view class="hot-list">
        <view
          class="hot-item"
          wx:for="{{hotStocks}}"
          wx:key="code"
          bindtap="onSelectStock"
          data-item="{{item}}"
        >
          <view class="hot-left">
            <text class="hot-name">{{item.name}}</text>
            <text class="hot-code-tag">{{item.displayCode || item.code}}</text>
          </view>
          <view class="hot-center">
            <text class="hot-price">{{item.price}}</text>
          </view>
          <view class="hot-right">
            <text class="hot-change {{item.changePercent >= 0 ? 'up' : 'down'}}">
              {{item.changePercent >= 0 ? '+' : ''}}{{item.changePercent}}%
            </text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>