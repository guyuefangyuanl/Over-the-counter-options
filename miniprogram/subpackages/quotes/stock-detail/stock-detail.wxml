<!-- miniprogram/pages/stock-detail/stock-detail.wxml -->
<view class="container">
  <!-- 1. 顶部自定义导航栏 -->
  <view class="custom-nav">
    <view class="back-btn" bindtap="onBack">
      <image style="position: relative; left: -248rpx; top: -130rpx" class="nav-icon" src="/images/询价/u395.svg" mode="aspectFit" />
    </view>
    <view class="nav-title" style="position: relative; left: -266rpx; top: -130rpx">期权报价</view>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view scroll-y class="main-scroll">
    <!-- 2. 搜索与客服区域 -->
    <view class="top-action-bar">
      <view class="search-section" bindtap="goToSearch" style="position: relative; left: -10rpx; top: -19rpx">
        <image class="search-icon" src="/images/询价/u475.svg" mode="aspectFit" />
        <input class="search-input" placeholder=" " disabled />
        <view class="search-clear-btn" wx:if="{{searchKeyword}}" catchtap="onClearSearch">
          <text>×</text>
        </view>
      </view>
      <view class="service-section" bindtap="onContactService">
        <image class="service-icon" src="/images/询价/u405.png" mode="aspectFit" />
        <text class="service-label">客服</text>
      </view>
    </view>

    <!-- 3. 股票信息卡片 -->
    <view class="stock-info-card">
      <view class="stock-left">
        <text class="stock-name">{{stock.name}}</text>
        <text class="stock-code">{{stock.code}}</text>
      </view>
      <view class="stock-center">
        <text class="stock-price up">{{stock.price}}</text>
        <text class="stock-change up">{{stock.changePercent}}%</text>
      </view>
      <view class="stock-right" bindtap="toggleFavorite">
        <view class="heart-icon {{isFavorite ? 'active' : ''}}"></view>
      </view>
    </view>

    <!-- 4. 筛选工具栏 -->
    <view class="filter-toolbar">
      <view class="filter-group">
        <text class="filter-title">报价日</text>
        <picker bindchange="onDateChange" value="{{selectedDateIndex}}" range="{{dateRange}}">
          <view class="filter-dropdown">
            <text class="{{selectedDateIndex === 0 ? 'placeholder' : ''}}">{{selectedDate}}</text>
            <image class="dropdown-arrow" src="/images/询价/u432.svg" mode="aspectFit" />
          </view>
        </picker>
      </view>
      <view class="filter-group">
        <text class="filter-title">交易商</text>
        <picker bindchange="onTraderChange" value="{{selectedTraderIndex}}" range="{{traderRange}}">
          <view class="filter-dropdown">
            <text class="{{selectedTraderIndex === 0 ? 'placeholder' : ''}}">{{selectedTrader}}</text>
            <image class="dropdown-arrow" src="/images/询价/u432.svg" mode="aspectFit" />
          </view>
        </picker>
      </view>
    </view>

    <!-- 5. 业务类型切换 -->
    <view class="biz-tabs-row">
      <view class="biz-tabs">
        <view class="biz-tab {{activeTab === 'vanilla' ? 'active' : ''}}" bindtap="switchTab" data-tab="vanilla">香草</view>
        <view class="biz-tab {{activeTab === 'snowball' ? 'active' : ''}}" bindtap="switchTab" data-tab="snowball">雪球</view>
      </view>
      <view class="action-buttons">
        <view class="action-btn" bindtap="goCalculator">计算器</view>
        <view class="action-btn" bindtap="goWorkspace">工作台</view>
      </view>
    </view>

    <!-- 6. 报价矩阵表格 -->
    <view class="quote-matrix-container">
      <scroll-view class="matrix-scroll-view" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
        <view class="quote-table">
          <!-- 表头 -->
          <view class="table-header">
            <view class="table-th sticky-col first-col">结构/期限</view>
            <view class="table-th" wx:for="{{terms}}" wx:key="*this">{{item}}</view>
          </view>
          <!-- 表体 -->
          <view class="table-row" wx:for="{{matrixData}}" wx:key="strike" wx:for-item="row">
            <view class="table-td sticky-col first-col">{{row.strike}}</view>
            <view class="table-td" 
                  wx:for="{{row.values}}" 
                  wx:for-item="cell" 
                  wx:key="term"
                  bindtap="onCellTap"
                  data-strike="{{row.strike}}"
                  data-term="{{cell.term}}">
              <text class="rate-text {{cell.value === '--' ? 'disabled' : ''}}">{{cell.value}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 下单弹窗 -->
    <view class="modal-overlay" wx:if="{{showOrderModal}}" bindtap="closeOrderModal">
      <view class="order-popup" catchtap="stopBubble">
        <view class="popup-table">
          <view class="popup-row {{orderForm.direction === '买入' ? 'highlight-bg' : 'highlight-bg-red'}}">
            <view class="popup-label">方向<text class="req-star">*</text></view>
            <view class="popup-value">
              <picker bindchange="onDirectionChange" value="{{orderForm.direction === '买入' ? 0 : 1}}" range="{{['买入', '卖出']}}">
                <view class="popup-picker">
                  <text>{{orderForm.direction}}</text>
                  <view class="white-arrow-down"></view>
                </view>
              </picker>
            </view>
          </view>
          <view class="popup-row">
            <view class="popup-label">交易商</view>
            <view class="popup-value">{{orderForm.trader}}</view>
          </view>
          <view class="popup-row">
            <view class="popup-label">标的资产</view>
            <view class="popup-value">{{stock.name}} {{stock.code}}</view>
          </view>
          <view class="popup-row">
            <view class="popup-label">结构期限</view>
            <view class="popup-value">{{orderForm.strike}} - {{orderForm.term}}</view>
          </view>
          <view class="popup-row">
            <view class="popup-label">期权费率</view>
            <view class="popup-value input-group">
              <input class="popup-input" type="digit" value="{{orderForm.rate}}" bindinput="onRateInput" />
              <text class="input-unit">%</text>
            </view>
          </view>
          <view class="popup-row">
            <view class="popup-label">名义本金<text class="req-star">*</text></view>
            <view class="popup-value input-group">
              <input class="popup-input" type="digit" value="{{orderForm.notional}}" bindinput="onNotionalInput" />
              <text class="input-unit">万元</text>
            </view>
          </view>
          <view class="popup-row">
            <view class="popup-label">买入价格<text class="req-star">*</text></view>
            <view class="popup-value input-group">
              <input class="popup-input" type="digit" value="{{orderForm.price}}" placeholder="不输入默认为市价" bindinput="onPriceInput" />
              <text class="input-unit">元</text>
            </view>
          </view>
        </view>
        <view class="popup-footer">
          <button class="popup-btn-cancel" bindtap="closeOrderModal">取消</button>
          <button class="popup-btn-confirm" bindtap="copyOrderText">转发文本</button>
        </view>
      </view>
    </view>

    <!-- 转发预览弹窗 -->
    <view class="modal-overlay" wx:if="{{showPreviewModal}}" bindtap="closePreviewModal">
      <view class="preview-popup" catchtap="stopBubble">
        <view class="preview-header">
          <view class="preview-actions">
            <view class="action-icon" bindtap="copyOrderTextOnly">
              <image src="/images/询价/u395.svg" mode="aspectFit" style="transform: rotate(90deg);" />
            </view>
            <view class="action-icon" bindtap="saveImage">
              <image src="/images/询价/u432.svg" mode="aspectFit" />
            </view>
          </view>
          <text class="preview-title">转发下单图片</text>
          <view class="preview-close" bindtap="closePreviewModal">×</view>
        </view>
        <image class="preview-img" src="{{previewImage}}" mode="widthFix" />
        <view class="preview-footer">
          <button class="share-btn" open-type="share">发送给朋友</button>
          <button class="save-btn" bindtap="saveImage">保存到相册</button>
        </view>
      </view>
    </view>

    <!-- 用于生成图片的隐藏画布 -->
    <canvas canvas-id="orderCanvas" style="width: 375px; height: 500px; position: absolute; left: -1000px; top: -1000px;"></canvas>
  </scroll-view>
</view>
