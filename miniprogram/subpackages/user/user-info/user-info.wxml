<!--pages/user-info/user-info.wxml-->
<view class="user-info-container">
  <!-- 头像区域 -->
  <view class="avatar-section">
    <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image
        class="avatar-image"
        src="{{userInfo.avatar || '/images/default-avatar.png'}}"
        mode="aspectFill"
        binderror="onAvatarError"
      ></image>
      <view class="avatar-edit" wx:if="{{!isAvatarUploading}}">
        <text>更换头像</text>
      </view>
      <view class="avatar-loading" wx:if="{{isAvatarUploading}}">
        <text>上传中...</text>
      </view>
    </button>
  </view>

  <!-- 信息列表 -->
  <view class="info-section">
    <view class="info-card">
      <!-- 昵称 -->
      <view class="info-item">
        <text class="info-label">昵称</text>
        <input
          class="info-input"
          type="nickname"
          placeholder="请输入昵称"
          value="{{userInfo.nickname}}"
          bindblur="onNicknameChange"
        />
      </view>

      <!-- 手机号 -->
      <view class="info-item" bindtap="bindPhone">
        <text class="info-label">手机号</text>
        <view class="info-value-wrapper">
          <text class="info-value">{{userInfo.phone || '未绑定'}}</text>
          <text class="info-arrow">></text>
        </view>
      </view>

      <!-- 邮箱 -->
      <view class="info-item">
        <text class="info-label">邮箱</text>
        <input
          class="info-input"
          type="text"
          placeholder="请输入邮箱"
          value="{{userInfo.email}}"
          bindblur="onEmailChange"
        />
      </view>
    </view>

    <view class="info-card">
      <!-- 用户ID -->
      <view class="info-item">
        <text class="info-label">用户ID</text>
        <text class="info-value">{{userInfo.openid || '--'}}</text>
      </view>

      <!-- 注册时间 -->
      <view class="info-item">
        <text class="info-label">注册时间</text>
        <text class="info-value">{{userInfo.createTime || '--'}}</text>
      </view>
    </view>
  </view>

  <!-- 协议链接 -->
  <view class="agreement-section">
    <view class="agreement-item" bindtap="showUserAgreement">
      <text>用户协议</text>
      <text class="agreement-arrow">></text>
    </view>
    <view class="agreement-item" bindtap="showPrivacyPolicy">
      <text>隐私政策</text>
      <text class="agreement-arrow">></text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>
  </view>
</view>