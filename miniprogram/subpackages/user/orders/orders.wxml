<!--pages/orders/orders.wxml-->
<view class="orders-container">
  <!-- 状态筛选栏 -->
  <view class="status-tabs">
    <scroll-view scroll-x class="tabs-scroll">
      <view class="tabs-wrapper">
        <view
          wx:for="{{statusOptions}}"
          wx:key="value"
          class="tab-item {{activeStatus === item.value ? 'active' : ''}}"
          data-status="{{item.value}}"
          bindtap="switchStatus"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 订单列表 -->
  <view class="orders-list" wx:if="{{orders.length > 0}}">
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="_id"
    >
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-id">订单编号: {{item.orderId || item._id}}</text>
        <view class="order-status status-{{item.status}}">
          {{item.statusLabel || (item.status === 'pending' ? '待处理' : item.status === 'processing' ? '处理中' : item.status === 'completed' ? '已完成' : item.status === 'cancelled' ? '已取消' : item.status)}}
        </view>
      </view>

      <!-- 订单内容 -->
      <view class="order-content">
        <view class="order-row">
          <text class="label">标的</text>
          <text class="value">{{item.underlying || item.stockName || '--'}}</text>
        </view>
        <view class="order-row">
          <text class="label">期权类型</text>
          <text class="value">{{item.optionType === 'call' ? '看涨' : item.optionType === 'put' ? '看跌' : item.optionType || '--'}}</text>
        </view>
        <view class="order-row">
          <text class="label">期限</text>
          <text class="value">{{item.term || '--'}}</text>
        </view>
        <view class="order-row">
          <text class="label">名义本金</text>
          <text class="value">{{item.notionalAmount || '--'}} 万元</text>
        </view>
      </view>

      <!-- 订单金额 -->
      <view class="order-amount">
        <text class="amount-label">期权费</text>
        <text class="amount-value">¥{{item.premium || '0.00'}}</text>
      </view>

      <!-- 订单时间 -->
      <view class="order-time">
        {{item.createdAt || '--'}}
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions">
        <view class="btn btn-detail" data-id="{{item._id}}" bindtap="goToOrderDetail">
          查看详情
        </view>
        <view
          wx:if="{{item.status === 'pending'}}"
          class="btn btn-cancel"
          data-id="{{item._id}}"
          bindtap="cancelOrder"
        >
          取消订单
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrapper" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && orders.length > 0 && !loading}}">
    <text>没有更多了</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{isEmpty && !loading}}">
    <image class="empty-icon" src="/images/empty-order.png" mode="aspectFit"></image>
    <text class="empty-text">暂无订单</text>
    <view class="empty-btn" bindtap="refreshOrders">刷新试试</view>
  </view>

  <!-- 错误状态 -->
  <view class="error-state" wx:if="{{error && !loading && orders.length === 0}}">
    <text class="error-text">加载失败，请稍后重试</text>
    <view class="retry-btn" bindtap="refreshOrders">重新加载</view>
  </view>
</view>