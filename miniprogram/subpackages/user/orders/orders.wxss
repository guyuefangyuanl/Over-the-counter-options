/* pages/orders/orders.wxss */

.orders-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 状态筛选栏 */
.status-tabs {
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #eee;
}

.tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.tabs-wrapper {
  display: inline-flex;
  padding: 20rpx 0;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin: 0 16rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #409EFF;
  color: #fff;
}

/* 订单列表 */
.orders-list {
  padding: 24rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-id {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.status-pending {
  background-color: #fdf6ec;
  color: #E6A23C;
}

.status-processing {
  background-color: #ecf5ff;
  color: #409EFF;
}

.status-completed {
  background-color: #f0f9eb;
  color: #67C23A;
}

.status-cancelled {
  background-color: #f4f4f5;
  color: #909399;
}

/* 订单内容 */
.order-content {
  padding: 20rpx 0;
}

.order-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.order-row .label {
  font-size: 28rpx;
  color: #999;
}

.order-row .value {
  font-size: 28rpx;
  color: #333;
}

/* 订单金额 */
.order-amount {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.amount-label {
  font-size: 28rpx;
  color: #666;
}

.amount-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #F56C6C;
}

/* 订单时间 */
.order-time {
  font-size: 24rpx;
  color: #999;
  padding-top: 16rpx;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}

.btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  text-align: center;
}

.btn-detail {
  background-color: #409EFF;
  color: #fff;
}

.btn-cancel {
  background-color: #fff;
  color: #F56C6C;
  border: 1rpx solid #F56C6C;
}

/* 加载状态 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background-color: #409EFF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.error-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.retry-btn {
  padding: 16rpx 48rpx;
  background-color: #409EFF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
}