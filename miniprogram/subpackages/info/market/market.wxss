/* pages/market/market.wxss */

.market-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* 行情卡片 */
.quote-card {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.quote-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.quote-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.stock-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.stock-code {
  font-size: 26rpx;
  color: #999;
}

.favorite-btn {
  padding: 8rpx 24rpx;
  border: 1rpx solid #409EFF;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #409EFF;
}

.favorite-btn.active {
  background-color: #409EFF;
  color: #fff;
}

.quote-main {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.quote-price {
  font-size: 56rpx;
  font-weight: 600;
}

.quote-change {
  font-size: 32rpx;
}

.quote-main .up {
  color: #F56C6C;
}

.quote-main .down {
  color: #67C23A;
}

.quote-detail {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.detail-item {
  text-align: center;
}

.detail-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
}

.detail-value.up {
  color: #F56C6C;
}

.detail-value.down {
  color: #67C23A;
}

/* K线图区域 */
.chart-section {
  background-color: #fff;
  margin-bottom: 16rpx;
}

.chart-header {
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.chart-tabs {
  display: flex;
  gap: 24rpx;
}

.chart-tab {
  font-size: 28rpx;
  color: #666;
  padding: 8rpx 0;
}

.chart-tab.active {
  color: #409EFF;
  font-weight: 500;
  border-bottom: 4rpx solid #409EFF;
}

.chart-placeholder {
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

/* 期权报价 */
.options-section {
  background-color: #fff;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.options-list {
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.option-item:last-child {
  border-bottom: none;
}

.option-type {
  width: 80rpx;
  font-size: 26rpx;
  color: #409EFF;
}

.option-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 24rpx;
  color: #666;
}

.option-premium {
  width: 100rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 500;
  color: #F56C6C;
}

.option-broker {
  width: 100rpx;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

/* 加载状态 */
.loading-placeholder {
  padding: 40rpx;
  text-align: center;
  color: #999;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.action-btn.primary {
  background-color: #409EFF;
  color: #fff;
}