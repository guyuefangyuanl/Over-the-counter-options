/* pages/knowledge/knowledge.wxss */

/* ====== 全局容器 ====== */
.knowledge-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ====== 搜索栏 ====== */
.search-bar {
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 44rpx;
  padding: 16rpx 24rpx;
  transition: all 0.3s ease;
}

.search-input-wrap:focus-within {
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(64, 158, 255, 0.15);
}

.search-icon-text {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #303133;
}

.search-placeholder {
  color: #c0c4cc;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dcdfe6;
  border-radius: 50%;
  font-size: 20rpx;
  color: #ffffff;
  margin-left: 12rpx;
}

/* ====== 分类标签 ====== */
.category-scroll {
  background: #ffffff;
  white-space: nowrap;
  border-bottom: 1rpx solid #f0f2f5;
}

.category-list {
  display: inline-flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #606266;
  background: #f5f7fa;
  border-radius: 32rpx;
  transition: all 0.25s ease;
  position: relative;
}

.category-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, #409EFF 0%, #66b1ff 100%);
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.35);
}

.category-text {
  line-height: 1.2;
}

.category-count {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 16rpx;
  min-width: 32rpx;
  text-align: center;
}

.category-item.active .category-count {
  background: rgba(255, 255, 255, 0.25);
}

/* ====== 搜索结果提示 ====== */
.search-result-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #ecf5ff;
  font-size: 26rpx;
}

.result-text {
  color: #606266;
}

.highlight {
  color: #409EFF;
  font-weight: 600;
}

.clear-filter {
  color: #409EFF;
  font-size: 24rpx;
}

/* ====== 骨架屏 ====== */
.skeleton-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.skeleton-card {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 24rpx;
  gap: 20rpx;
}

.skeleton-cover {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  flex-shrink: 0;
}

.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skeleton-tag {
  width: 100rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-title {
  height: 36rpx;
  width: 80%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-summary {
  height: 28rpx;
  width: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-meta {
  height: 24rpx;
  width: 50%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ====== 文章列表 ====== */
.article-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.article-card {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.25s ease;
}

.article-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 封面图 */
.article-cover-wrap {
  width: 160rpx;
  height: 140rpx;
  flex-shrink: 0;
  overflow: hidden;
  margin: 24rpx 0 24rpx 24rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.article-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 文章内容 */
.article-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 20rpx 24rpx 20rpx 16rpx;
  min-width: 0;
}

.article-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.article-category-tag {
  font-size: 22rpx;
  color: #409EFF;
  background: rgba(64, 158, 255, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.article-views {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #909399;
}

.views-icon {
  font-size: 20rpx;
}

.views-num {
  font-size: 22rpx;
}

.article-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  line-height: 1.4;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-summary {
  font-size: 24rpx;
  color: #909399;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.article-date {
  font-size: 22rpx;
  color: #c0c4cc;
}

.article-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.action-text {
  font-size: 22rpx;
  color: #409EFF;
}

.action-arrow {
  font-size: 28rpx;
  color: #409EFF;
  font-weight: 300;
}

/* ====== 空状态 ====== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 96rpx;
  color: #dcdfe6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.empty-desc {
  font-size: 26rpx;
  color: #909399;
}

.empty-action {
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #409EFF 0%, #66b1ff 100%);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(64, 158, 255, 0.3);
}

/* ====== 加载更多 ====== */
.load-more-wrap {
  display: flex;
  justify-content: center;
  padding: 32rpx;
}

.load-more-btn {
  padding: 16rpx 48rpx;
  background: #ffffff;
  border: 1rpx solid #409EFF;
  color: #409EFF;
  border-radius: 44rpx;
  font-size: 26rpx;
  transition: all 0.25s ease;
}

.load-more-btn:active {
  background: #ecf5ff;
}

/* ====== 底部提示 ====== */
.bottom-tip {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #c0c4cc;
}

/* ====== 响应式适配 ====== */
@media (max-width: 360px) {
  .article-cover-wrap {
    width: 120rpx;
    height: 100rpx;
    margin-left: 16rpx;
  }

  .article-title {
    font-size: 28rpx;
  }

  .article-summary {
    font-size: 22rpx;
    -webkit-line-clamp: 1;
  }

  .category-item {
    padding: 12rpx 20rpx;
    font-size: 24rpx;
  }
}