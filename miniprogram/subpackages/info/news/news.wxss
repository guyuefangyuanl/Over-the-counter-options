/* pages/news/news.wxss */

.news-container {
  min-height: 100vh;
  background-color: #f5f7fa;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #fff;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background-color: #f5f7fa;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.search-cancel {
  font-size: 28rpx;
  color: #409EFF;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.tabs-scroll {
  flex: 1;
  white-space: nowrap;
}

.tabs-wrapper {
  display: inline-flex;
  gap: 16rpx;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f7fa;
  border-radius: 24rpx;
}

.tab-item.active {
  background-color: #409EFF;
  color: #fff;
}

.search-btn {
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  color: #409EFF;
}

/* 资讯列表 */
.articles-list {
  padding: 24rpx;
}

.article-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.article-main {
  display: flex;
  gap: 20rpx;
}

.article-image {
  width: 180rpx;
  height: 120rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.article-image image {
  width: 100%;
  height: 100%;
}

.article-content {
  flex: 1;
  min-width: 0;
}

.article-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.article-summary {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.article-category {
  padding: 4rpx 12rpx;
  background-color: #ecf5ff;
  color: #409EFF;
  border-radius: 4rpx;
}

/* 加载状态 */
.loading-wrapper {
  text-align: center;
  padding: 24rpx;
  color: #999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 24rpx;
  color: #999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.refresh-btn {
  padding: 16rpx 48rpx;
  background-color: #409EFF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
}