/* pages/analysis/analysis.wxss */

.analysis-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* 区块样式 */
.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

/* 市场指数 */
.index-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.index-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.index-name {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.index-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.index-change {
  font-size: 24rpx;
}

.index-change.up {
  color: #F56C6C;
}

.index-change.down {
  color: #67C23A;
}

/* 市场情绪 */
.sentiment-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.sentiment-gauge {
  margin-bottom: 16rpx;
}

.gauge-bar {
  position: relative;
  height: 16rpx;
  background: linear-gradient(to right, #67C23A 0%, #E6A23C 50%, #F56C6C 100%);
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.gauge-pointer {
  position: absolute;
  top: -8rpx;
  width: 32rpx;
  height: 32rpx;
  background-color: #fff;
  border: 4rpx solid #409EFF;
  border-radius: 50%;
  transform: translateX(-50%);
}

.gauge-labels {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.sentiment-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.sentiment-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #409EFF;
}

.sentiment-text {
  font-size: 32rpx;
  color: #333;
}

.sentiment-trend {
  font-size: 26rpx;
  color: #999;
}

/* 热门标的 */
.hot-stocks-scroll {
  width: 100%;
  white-space: nowrap;
}

.hot-stocks-list {
  display: inline-flex;
  gap: 16rpx;
}

.hot-stock-card {
  display: inline-block;
  width: 200rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.stock-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-code {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.stock-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.stock-change {
  font-size: 24rpx;
}

.stock-change.up {
  color: #F56C6C;
}

.stock-change.down {
  color: #67C23A;
}

/* 分析文章 */
.articles-list {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.article-card {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.article-card:last-child {
  border-bottom: none;
}

.article-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.article-summary {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.article-meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999;
}

/* 加载状态 */
.loading-placeholder {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 40rpx;
  text-align: center;
  color: #999;
}

.loading-more {
  text-align: center;
  padding: 24rpx;
  color: #999;
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 24rpx;
  color: #999;
  font-size: 26rpx;
}