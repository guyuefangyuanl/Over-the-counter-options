<!--pages/workspace/workspace.wxml-->
<view class="container">
  <!-- 用户信息头部 -->
  <view class="user-header">
    <view class="user-info">
      <image src="/images/avatar-default.png" class="user-avatar"></image>
      <view class="user-details">
        <view class="user-name">
          {{userInfo.name}}
          <text class="vip-badge" wx:if="{{userInfo.isVip}}">VIP</text>
        </view>
        <view class="account-id">账户：{{userInfo.accountId}}</view>
      </view>
    </view>
    <view class="refresh-btn {{showRefreshAnimation ? 'rotating' : ''}}" bindtap="refreshWorkspaceData">
      <image src="/images/refresh.png" class="refresh-icon"></image>
    </view>
  </view>

  <!-- 资产概览 -->
  <view class="asset-overview">
    <view class="section-title">资产概览</view>
    <view class="asset-grid">
      <view class="asset-item">
        <view class="asset-label">总资产（元）</view>
        <view class="asset-value main">{{portfolioSummary.totalAssets}}</view>
      </view>
      <view class="asset-item">
        <view class="asset-label">可用资金（元）</view>
        <view class="asset-value">{{portfolioSummary.availableFunds}}</view>
      </view>
      <view class="asset-item">
        <view class="asset-label">持仓市值（元）</view>
        <view class="asset-value">{{portfolioSummary.totalPositions}}</view>
      </view>
      <view class="asset-item">
        <view class="asset-label">今日盈亏（元）</view>
        <view class="asset-value {{portfolioSummary.todayPnL >= 0 ? 'profit' : 'loss'}}">
          {{portfolioSummary.todayPnL}}
        </view>
      </view>
    </view>
    
    <view class="total-pnl">
      <view class="pnl-label">累计盈亏</view>
      <view class="pnl-value {{portfolioSummary.totalPnL >= 0 ? 'profit' : 'loss'}}">
        {{portfolioSummary.totalPnL}}
        <text class="pnl-percent">({{portfolioSummary.totalPnLPercent}}%)</text>
      </view>
    </view>
  </view>

  <!-- 持仓概览 -->
  <view class="position-overview">
    <view class="section-header">
      <view class="section-title">持仓概览</view>
      <view class="view-all" bindtap="viewPositionDetail">查看详情 ></view>
    </view>
    
    <view class="position-stats">
      <view class="stat-item">
        <view class="stat-number">{{positionOverview.activePositions}}</view>
        <view class="stat-label">存续持仓</view>
      </view>
      <view class="stat-item">
        <view class="stat-number warning">{{positionOverview.nearExpiry}}</view>
        <view class="stat-label">近期到期</view>
      </view>
      <view class="stat-item">
        <view class="stat-number">{{positionOverview.totalScale}}万</view>
        <view class="stat-label">总规模</view>
      </view>
      <view class="stat-item">
        <view class="stat-number" style="color: {{getRiskLevelColor(positionOverview.riskLevel)}}">
          {{getRiskLevelText(positionOverview.riskLevel)}}
        </view>
        <view class="stat-label">风险等级</view>
      </view>
    </view>
  </view>

  <!-- 市场行情 -->
  <view class="market-overview">
    <view class="section-header">
      <view class="section-title">市场行情</view>
    </view>
    
    <!-- 主要指数 -->
    <view class="main-index">
      <view class="index-info">
        <view class="index-name">{{marketData.mainIndex.name}}</view>
        <view class="index-code">{{marketData.mainIndex.code}}</view>
      </view>
      <view class="index-price">
        <view class="price">{{marketData.mainIndex.price}}</view>
        <view class="change {{marketData.mainIndex.change >= 0 ? 'profit' : 'loss'}}">
          {{marketData.mainIndex.change}} ({{marketData.mainIndex.changePercent}}%)
        </view>
      </view>
    </view>
    
    <!-- 指数列表 -->
    <view class="index-list">
      <view class="index-item" wx:for="{{marketData.indexList}}" wx:key="name">
        <view class="name">{{item.name}}</view>
        <view class="price">{{item.price}}</view>
        <view class="change {{item.change >= 0 ? 'profit' : 'loss'}}">
          {{item.changePercent}}%
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="section-title">快捷操作</view>
    <view class="action-grid">
      <view class="action-item" 
            wx:for="{{quickActions}}" 
            wx:key="id"
            data-action="{{item}}"
            bindtap="onQuickAction">
        <image src="{{item.icon}}" class="action-icon"></image>
        <text class="action-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 最近交易 -->
  <view class="recent-transactions">
    <view class="section-header">
      <view class="section-title">最近交易</view>
      <view class="view-all" bindtap="viewTransactionHistory">查看全部 ></view>
    </view>
    
    <view class="transaction-list">
      <view class="transaction-item" wx:for="{{recentTransactions}}" wx:key="id">
        <view class="transaction-left">
          <view class="transaction-type">{{item.type}}</view>
          <view class="transaction-detail">{{item.product}} · {{item.underlying}}</view>
          <view class="transaction-time">{{item.time}}</view>
        </view>
        <view class="transaction-right">
          <view class="transaction-scale">{{item.scale}}万</view>
          <view class="transaction-price">{{item.price}}</view>
          <view class="transaction-status">{{item.status}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 风险提示 -->
  <view class="risk-notice">
    <image src="/images/warning.png" class="warning-icon"></image>
    <text class="risk-text">期权有风险，投资须谨慎。请充分了解产品风险后进行投资。</text>
  </view>
</view>
