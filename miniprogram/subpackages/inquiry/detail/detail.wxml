<wxs src="./detail.wxs" module="utils" />

<view class="detail-container">
  <view class="header">
    <view class="left" bindtap="goBack">
      <van-icon name="arrow-left" color="#fff" size="20px" />
    </view>
    <view class="title">期权报价</view>
    <view class="tools">
      <view class="tool" bindtap="goCalculator">计算器</view>
      <view class="tool" bindtap="goWorkspace">工作台</view>
    </view>
  </view>

  <view class="search-row">
    <input 
      class="search-input" 
      placeholder="搜索标的名称/代码" 
      value="{{keyword}}" 
      bindinput="onKeywordInput" 
      bindconfirm="onKeywordConfirm"
    />
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{isLoading}}">
    <van-loading size="24px" type="spinner">加载中...</van-loading>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{isEmpty && !isLoading}}">
    <van-icon name="search" size="60px" color="#c0c4cc" />
    <text class="empty-text">未找到相关标的，请搜索</text>
  </view>

  <!-- 产品信息 -->
  <block wx:if="{{product && !isLoading}}">
    <view class="product-row">
      <view class="product-name">{{product.name}}</view>
      <view class="product-code">{{product.code}}</view>
      <view 
        class="product-change {{product.changePercent > 0 ? 'rise' : (product.changePercent < 0 ? 'fall' : '')}}"
      >
        {{utils.formatChange(product.changePercent)}}
      </view>
    </view>

    <view class="filters">
      <view class="structure-tabs">
        <view 
          class="tab {{structure==='vanilla'?'active':''}}" 
          data-structure="vanilla" 
          bindtap="switchStructure"
        >
          香草
        </view>
        <view 
          class="tab {{structure==='snowball'?'active':''}}" 
          data-structure="snowball" 
          bindtap="switchStructure"
        >
          雪球
        </view>
      </view>
      <view class="term-tabs">
        <block wx:for="{{terms}}" wx:key="*this">
          <view 
            class="tab {{term===item?'active':''}}" 
            data-term="{{item}}" 
            bindtap="switchTerm"
          >
            {{item}}
          </view>
        </block>
      </view>
    </view>

    <scroll-view class="grid-wrapper" scroll-x scroll-y>
      <view class="grid">
        <view class="grid-header">
          <view class="cell strike">行权价</view>
          <block wx:for="{{terms}}" wx:key="*this">
            <view class="cell">{{item}}</view>
          </block>
        </view>
        <block wx:for="{{strikes}}" wx:for-index="rowIdx" wx:key="*this">
          <view class="grid-row">
            <view class="cell strike">{{item}}%</view>
            <block wx:for="{{terms}}" wx:for-index="colIdx" wx:key="*this">
              <view class="cell rate">{{rateMatrix[rowIdx][colIdx]}}</view>
            </block>
          </view>
        </block>
      </view>
    </scroll-view>
  </block>
</view>
