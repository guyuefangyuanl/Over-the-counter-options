/* 热门产品卡片组件样式 */
.section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.section-title-icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.hot-icon {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border-radius: 6rpx;
}

.more-btn {
  font-size: 24rpx;
  color: #409EFF;
}

/* 产品列表 */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-card {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option-info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.market-badge {
  font-size: 18rpx;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  color: #fff;
  background: #E91E63;
}

.market-badge.sh {
  background: #E91E63;
}

.market-badge.sz {
  background: #E91E63;
}

.option-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.option-code {
  font-size: 22rpx;
  color: #409EFF;
}

.option-structure {
  font-size: 22rpx;
  color: #333;
}

.option-tags {
  display: flex;
}

.tag-vanilla {
  font-size: 20rpx;
  color: #E6A23C;
  background: #FDF6EC;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

/* 增强卡片样式 */
.enhanced-card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.enhanced-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* 入场动画 */
.option-card {
  animation: slideIn 0.3s ease both;
}

.option-card:nth-child(1) { animation-delay: 0.05s; }
.option-card:nth-child(2) { animation-delay: 0.1s; }
.option-card:nth-child(3) { animation-delay: 0.15s; }
.option-card:nth-child(4) { animation-delay: 0.2s; }
.option-card:nth-child(5) { animation-delay: 0.25s; }

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}