.market-header {
  position: relative;
  padding: 10rpx 20rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e5e5e5;
}
.market-indexes {
  white-space: nowrap;
}
.market-index-item {
  display: inline-block;
  margin-right: 28rpx;
  text-align: center;
}
.market-index-name {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 2rpx;
}
.market-index-value {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 2rpx;
}
.market-index-change {
  font-size: 22rpx;
  font-weight: 500;
}
.is-rise { color: #F53F3F; }
.is-fall { color: #00B42A; }
.current-time {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #909399;
}
.market-header { position: relative; padding: 16rpx 32rpx; background-color: #ffffff; border-bottom: 1rpx solid #e5e5e5; }
.market-indexes { white-space: nowrap; }
.market-index-item { display: inline-block; margin-right: 40rpx; text-align: center; }
.market-index-name { font-size: 24rpx; color: #909399; margin-bottom: 6rpx; }
.market-index-value { font-size: 28rpx; font-weight: 600; margin-bottom: 6rpx; }
.market-index-change { font-size: 22rpx; font-weight: 500; }
.is-rise { color: #F53F3F; }
.is-fall { color: #00B42A; }
.current-time { position: absolute; right: 32rpx; top: 50%; transform: translateY(-50%); font-size: 24rpx; color: #909399; }
