<wxs src="../../pages/inquiry/inquiry.wxs" module="utils" />
<view class="cards-grid">
  <block wx:for="{{list}}" wx:key="id">
    <view class="stock-item {{selectedSet[item.id] ? 'is-selected' : ''}}" hover-class="item-hover" bindtap="onRowTap" data-id="{{item.id}}">
      <view class="card-header">
        <text class="stock-code">{{item.code}}</text>
        <text class="stock-name">{{item.name}}</text>
      </view>
      <view class="card-metrics">
        <view class="metric">
          <text class="label">涨跌幅</text>
          <text class="value num {{item.changePercent > 0 ? 'is-rise' : (item.changePercent < 0 ? 'is-fall' : '')}}">{{utils.formatChange(item.changePercent)}}</text>
        </view>
        <view class="metric">
          <text class="label">平值</text>
          <text class="value num">{{item.rates['100']}}%</text>
        </view>
        <view class="metric">
          <text class="label">虚值105</text>
          <text class="value num">{{item.rates['105']}}%</text>
        </view>
        <view class="metric">
          <text class="label">虚值110</text>
          <text class="value num">{{item.rates['110']}}%</text>
        </view>
      </view>
      <view class="card-actions" wx:if="{{!isEditing}}">
        <van-icon class="fav-icon {{favoritesById[item.id] ? 'is-fav' : ''}} {{animatingFavoriteId === item.id ? 'fav-anim' : ''}} {{disableFavoriteActions ? 'is-disabled' : ''}}" name="{{favoritesById[item.id] ? 'star' : 'star-o'}}" size="20px" bind:click="onToggleFavorite" data-id="{{item.id}}" />
        <van-button type="primary" size="mini" bindtap="onInquiry" data-id="{{item.id}}">询价</van-button>
      </view>
    </view>
  </block>
  <view class="empty-state" wx:if="{{!list.length}}">
    <image src="../../images/empty.svg" class="empty-icon" mode="aspectFit" lazy-load="true" />
    <text class="empty-text">暂无数据</text>
  </view>
</view>
