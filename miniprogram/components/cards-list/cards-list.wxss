.cards-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; padding: 16rpx; }
.stock-item { display: flex; flex-direction: column; background-color: #ffffff; border: 1rpx solid #E5E6EB; border-radius: 16rpx; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06); padding: 16rpx; min-height: 160rpx; animation: slideUp 0.4s ease-out both; will-change: transform, opacity; }
.item-hover { transform: scale(0.98); opacity: 0.9; }
@keyframes slideUp { from { transform: translateY(20rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.cards-grid .stock-item:nth-child(1)  { animation-delay: 0.03s; }
.cards-grid .stock-item:nth-child(2)  { animation-delay: 0.06s; }
.cards-grid .stock-item:nth-child(3)  { animation-delay: 0.09s; }
.cards-grid .stock-item:nth-child(4)  { animation-delay: 0.12s; }
.cards-grid .stock-item:nth-child(5)  { animation-delay: 0.15s; }
.cards-grid .stock-item:nth-child(6)  { animation-delay: 0.18s; }
.cards-grid .stock-item:nth-child(7)  { animation-delay: 0.21s; }
.cards-grid .stock-item:nth-child(8)  { animation-delay: 0.24s; }
.cards-grid .stock-item:nth-child(9)  { animation-delay: 0.27s; }
.cards-grid .stock-item:nth-child(10) { animation-delay: 0.30s; }
.card-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12rpx; }
.stock-code { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.stock-name { font-size: 24rpx; color: #86909C; }
.card-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; margin-bottom: 12rpx; }
.metric { display: flex; flex-direction: column; gap: 6rpx; background: #F7F8FA; border: 1rpx solid #E5E6EB; border-radius: 12rpx; padding: 10rpx; }
.metric .label { font-size: 22rpx; color: #86909C; }
.metric .value { font-size: 28rpx; color: #1D2129; text-align: right; }
.is-rise { color: #F53F3F; }
.is-fall { color: #00B42A; }
.num { text-align: right; font-family: 'DIN Alternate', monospace; }
.card-actions { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; }
.fav-icon { color: #C0C4CC; font-size: 32rpx; transition: transform 0.2s ease; }
.fav-icon:active { transform: scale(0.92); }
.fav-icon.is-fav { color: #FFD54F; }
.fav-icon.is-disabled { opacity: 0.4; pointer-events: none; }
.stock-item.is-selected { border-color: #2D8CF0; box-shadow: 0 8rpx 20rpx rgba(45, 140, 240, 0.18), 0 0 0 3rpx rgba(45, 140, 240, 0.28); transform: scale(1.01); }
@media (max-width: 375px) { .cards-grid { grid-template-columns: repeat(1, 1fr); } .metric .value { font-size: 26rpx; } }

@media (orientation: landscape) {
  .cards-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (min-width: 1024px) and (orientation: landscape) {
  .cards-grid { grid-template-columns: repeat(4, 1fr); }
}
