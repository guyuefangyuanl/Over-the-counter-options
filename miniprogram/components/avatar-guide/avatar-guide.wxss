/* 头像引导组件样式 */
.avatar-guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-guide-container {
  width: 90%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头部 */
.guide-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.guide-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

/* 步骤内容 */
.guide-step {
  padding: 32rpx;
}

.step-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
  text-align: center;
}

/* 头像预览 */
.avatar-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-preview.small {
  margin-bottom: 24rpx;
}

.preview-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #f0f0f0;
}

.avatar-preview.small .preview-image {
  width: 120rpx;
  height: 120rpx;
}

.preview-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.change-avatar {
  font-size: 24rpx;
  color: #409EFF;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  background: #ecf5ff;
  border-radius: 24rpx;
}

/* 头像选项 */
.avatar-options {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.option-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  min-width: 160rpx;
}

.option-item:active {
  background: #e9ecef;
}

.option-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.option-text {
  font-size: 24rpx;
  color: #666;
}

/* 默认头像选择 */
.default-avatars {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.default-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  text-align: center;
}

.default-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.default-item {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  overflow: hidden;
  transition: all 0.2s ease;
}

.default-item.selected {
  border-color: #409EFF;
  transform: scale(1.1);
}

.default-avatar-img {
  width: 100%;
  height: 100%;
}

/* 昵称输入 */
.nickname-input-wrapper {
  position: relative;
  margin-bottom: 24rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 100rpx 0 24rpx;
  font-size: 30rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.nickname-input:focus {
  border-color: #409EFF;
}

.nickname-count {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #999;
}

/* 提示 */
.nickname-tips {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.nickname-tips text {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮 */
.guide-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.btn-skip,
.btn-prev {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border-radius: 44rpx;
  background: #f5f5f5;
  color: #666;
}

.btn-next,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border-radius: 44rpx;
  background: #409EFF;
  color: #fff;
}

.btn-next:active,
.btn-confirm:active {
  background: #337ecc;
}

.btn-confirm.loading {
  background: #a0cfff;
  pointer-events: none;
}