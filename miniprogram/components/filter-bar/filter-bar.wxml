<view class="filters-section">
  <view class="search-row">
    <view class="search-input-wrap">
      <image src="../../images/icons/search.png" class="search-icon" mode="aspectFit" lazy-load="true" bindtap="onOpenSearch" />
      <input class="search-input" placeholder="搜索股票名称/代码" value="{{keyword}}" bindinput="onInput" bindconfirm="onConfirm" />
      <image wx:if="{{keyword}}" src="../../images/close.svg" class="clear-icon" bindtap="onClear" mode="aspectFit" lazy-load="true" />
    </view>
    <view class="search-btn" bindtap="onOpenSearch">搜索</view>
  </view>

  <view class="filter-tabs-group">
    <text class="filter-label">期限</text>
    <view class="term-tabs">
      <view class="term-tab {{activeTerm === '1M' ? 'is-active' : ''}}" data-term="1M" bindtap="onSwitchTerm">1M</view>
      <view class="term-tab {{activeTerm === '2M' ? 'is-active' : ''}}" data-term="2M" bindtap="onSwitchTerm">2M</view>
      <view class="term-tab {{activeTerm === '3M' ? 'is-active' : ''}}" data-term="3M" bindtap="onSwitchTerm">3M</view>
      <view class="term-tab {{activeTerm === '6M' ? 'is-active' : ''}}" data-term="6M" bindtap="onSwitchTerm">6M</view>
    </view>
  </view>

  <view class="filter-tabs-group">
    <text class="filter-label">结构</text>
    <view class="structure-tabs">
      <view class="structure-tab {{activeStructure === 'vanilla' ? 'is-active' : ''}}" data-structure="vanilla" bindtap="onSwitchStructure">香草</view>
      <view class="structure-tab {{activeStructure === 'snowball' ? 'is-active' : ''}}" data-structure="snowball" bindtap="onSwitchStructure">雪球</view>
    </view>
  </view>

  <view class="data-explain-trigger" bindtap="onInfo">
    <text>数据说明</text>
    <image src="../../images/info.png" class="icon-small" mode="aspectFit" lazy-load="true" />
  </view>
</view>
