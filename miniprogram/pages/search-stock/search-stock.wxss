/* 搜索股票页面样式 */
.search-stock-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-top: 20rpx;
}

/* 顶部搜索栏 */
.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e5e5e5;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 0 20rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  border: none;
  background: transparent;
  outline: none;
}

.search-icon {
  font-size: 32rpx;
  color: #999999;
  margin-left: 10rpx;
}

.cancel-btn {
  font-size: 30rpx;
  color: #007aff;
  white-space: nowrap;
}

/* 搜索结果 */
.search-results {
  background-color: #ffffff;
  min-height: calc(100vh - 120rpx);
}

.stock-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: #ffffff;
}

.stock-item:active {
  background-color: #f5f5f5;
}

.stock-left {
  display: flex;
  flex-direction: column;
}

.stock-name {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.stock-code {
  font-size: 26rpx;
  color: #999999;
}

.stock-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.stock-price {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stock-change {
  font-size: 26rpx;
}

.up {
  color: #ff3b30;
}

.down {
  color: #30b767;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  color: #cccccc;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
}

/* 热门股票 */
.hot-stocks {
  background-color: #ffffff;
  margin-top: 20rpx;
}

.hot-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.hot-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.hot-list {
  padding: 0 30rpx;
}

.hot-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-item:active {
  background-color: #f5f5f5;
}

.hot-name {
  font-size: 30rpx;
  color: #333333;
}

.hot-code {
  font-size: 26rpx;
  color: #999999;
}