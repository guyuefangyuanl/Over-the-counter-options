<!-- pages/account/account.wxml -->
<view class="page">
  <!-- 顶部导航栏 (自定义) -->
  <view class="nav-bar">
    <view class="nav-bar__content">
      <view class="account-trigger" bindtap="toggleAccountSelector">
        <text class="account-trigger__name">{{selectedAccount.name}}</text>
        <view class="account-trigger__icon {{showAccountSelector ? 'is-active' : ''}}"></view>
      </view>
    </view>
    
    <!-- 账户选择下拉菜单 -->
    <view class="account-dropdown {{showAccountSelector ? 'is-visible' : ''}}">
      <view class="account-dropdown__mask" bindtap="toggleAccountSelector"></view>
      <view class="account-dropdown__list">
        <view 
          class="account-dropdown__item {{item.id === selectedAccount.id ? 'is-selected' : ''}}" 
          wx:for="{{accounts}}" 
          wx:key="id" 
          data-id="{{item.id}}" 
          bindtap="switchAccount"
        >
          <text class="account-dropdown__text">{{item.name}}</text>
          <text class="account-dropdown__sub">{{item.id}}</text>
          <view class="account-dropdown__check" wx:if="{{item.id === selectedAccount.id}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 页面主体内容 -->
  <scroll-view class="main-content" scroll-y enable-back-to-top refresher-enabled bindrefresherrefresh="onPullDownRefresh">
    
    <!-- 用户资料区域 -->
    <view class="user-profile-card" wx:if="{{userInfo}}">
        <button class="user-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="user-avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        </button>
        <view class="user-info-box">
            <input type="nickname" class="user-nickname" placeholder="点击输入昵称" value="{{userInfo.nickname}}" bindblur="onNicknameChange" />
            <text class="user-id">ID: {{userInfo.openid}}</text>
        </view>
    </view>

    <!-- 资产概览卡片 -->
    <view class="asset-card">
      <view class="asset-card__header">
        <text class="asset-card__label">存续名义本金(元)</text>
        <view class="asset-card__action" bindtap="handleAddPosition">
          <text>+ 录入</text>
        </view>
      </view>
      <view class="asset-card__amount">{{overview.totalScale}}</view>
      
      <view class="asset-card__row">
        <view class="asset-metric">
          <text class="asset-metric__label">存续净收益</text>
          <text class="asset-metric__value {{overview.totalProfit >= 0 ? 'color-profit' : 'color-loss'}}">
            {{overview.totalProfit > 0 ? '+' : ''}}{{overview.totalProfit}}
          </text>
        </view>
        <view class="asset-metric">
          <text class="asset-metric__label">完结净收益</text>
          <text class="asset-metric__value {{overview.completedProfit >= 0 ? 'color-profit' : 'color-loss'}}">
            {{overview.completedProfit > 0 ? '+' : ''}}{{overview.completedProfit}}
          </text>
        </view>
      </view>

      <!-- 成本折叠区域 -->
      <view class="cost-panel">
        <view class="cost-panel__header" bindtap="toggleCostDetails">
          <text class="cost-panel__title">投入成本: {{costDetails.total}}</text>
          <view class="cost-panel__arrow {{isCostExpanded ? 'is-expanded' : ''}}"></view>
        </view>
        <view class="cost-panel__body {{isCostExpanded ? 'is-expanded' : ''}}">
          <view class="cost-row">
            <text class="cost-row__label">权利金</text>
            <text class="cost-row__value">{{costDetails.optionFee}}</text>
          </view>
          <view class="cost-row">
            <text class="cost-row__label">交易手续费</text>
            <text class="cost-row__value">{{costDetails.commission}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 持仓列表区域 -->
    <view class="positions-section">
      <view class="tabs">
        <view 
          class="tabs__item {{activeTab === 'continuing' ? 'is-active' : ''}}" 
          data-tab="continuing" 
          bindtap="switchTab"
        >存续中</view>
        <view 
          class="tabs__item {{activeTab === 'expiring' ? 'is-active' : ''}}" 
          data-tab="expiring" 
          bindtap="switchTab"
        >临近到期</view>
        <view 
          class="tabs__item {{activeTab === 'closed' ? 'is-active' : ''}}" 
          data-tab="closed" 
          bindtap="switchTab"
        >已完结</view>
      </view>

      <view class="positions-list" wx:if="{{filteredPositions.length > 0}}">
        <view class="position-card" wx:for="{{filteredPositions}}" wx:key="id">
          <view class="position-card__header">
            <view class="position-card__name-box">
              <text class="position-card__name">{{item.productName}}</text>
              <text class="position-card__tag">{{item.dealer}}</text>
            </view>
            <text class="position-card__status {{item.status === 'CONTINUING' ? 'color-primary' : 'color-regular'}}">{{item.statusText}}</text>
          </view>

          <view class="position-card__body">
            <view class="position-grid">
              <view class="position-item">
                <text class="position-item__label">名义本金</text>
                <text class="position-item__value">{{item.notional}}</text>
              </view>
              <view class="position-item">
                <text class="position-item__label">剩余天数</text>
                <text class="position-item__value">{{item.daysLeft}}天</text>
              </view>
              <view class="position-item">
                <text class="position-item__label">成交价</text>
                <text class="position-item__value">{{item.fillPrice}}</text>
              </view>
              <view class="position-item">
                <text class="position-item__label">当前价</text>
                <text class="position-item__value">{{item.currentPrice}}</text>
              </view>
              <view class="position-item">
                <text class="position-item__label">收益率</text>
                <text class="position-item__value {{item.pnlRate >= 0 ? 'color-profit' : 'color-loss'}}">{{item.pnlRate}}%</text>
              </view>
              <view class="position-item">
                <text class="position-item__label">账面盈亏</text>
                <text class="position-item__value {{item.pnl >= 0 ? 'color-profit' : 'color-loss'}}">{{item.pnl}}</text>
              </view>
            </view>
          </view>

          <view class="position-card__footer">
            <view class="btn-group">
              <view class="btn-small btn-outline" data-id="{{item.id}}" data-action="modify" bindtap="handlePositionAction">修改</view>
              <view class="btn-small btn-outline" data-id="{{item.id}}" data-action="close" bindtap="handlePositionAction">平仓记账</view>
              <view class="btn-small btn-primary" data-id="{{item.id}}" data-action="close-live" bindtap="handlePositionAction">平仓下单</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <image class="empty-state__image" src="/images/empty-state.png" mode="aspectFit"></image>
        <text class="empty-state__text">暂无相关持仓数据</text>
      </view>
    </view>
    
    <!-- 底部安全距离 -->
    <view class="safe-area-bottom"></view>
  </scroll-view>
</view>