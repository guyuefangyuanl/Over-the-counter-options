/* pages/account/account.wxss */

/* ========== 1. 变量定义 ========== */
page {
  /* Colors */
  --primary: #4298EF;
  --primary-light: #EBF5FF;
  --success: #03B615;
  --danger: #F56C6C;
  --warning: #E6A23C;

  --text-primary: #303133;
  --text-regular: #606266;
  --text-secondary: #909399;
  --text-placeholder: #C0C4CC;
  --text-white: #FFFFFF;

  --bg-page: #F5F7FA;
  --bg-card: #FFFFFF;
  --bg-hover: #F2F3F5;
  --bg-secondary: #FAFAFA;

  --border: #DCDFE6;
  --border-light: #E4E7ED;

  /* Spacing */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 40rpx;

  /* Radius */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  /* Shadows */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* ========== 2. 页面基础 ========== */
.page {
  min-height: 100vh;
  background-color: var(--bg-page);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
}

/* ========== 3. 导航栏 ========== */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.nav-bar__content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--spacing-md);
}

.nav-bar__left,
.nav-bar__right {
  width: 60rpx;
}

.nav-bar__back {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid var(--text-primary);
  border-bottom: 4rpx solid var(--text-primary);
  transform: rotate(45deg);
}

.nav-bar__center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.nav-bar__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ========== 4. 账户选择器 ========== */
.account-selector {
  background-color: var(--bg-card);
  padding: var(--spacing-sm) var(--spacing-md);
  border-bottom: 1rpx solid var(--border-light);
}

.account-selector__trigger {
  display: flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-sm);
  background-color: var(--bg-hover);
  border-radius: var(--radius-sm);
  width: fit-content;
}

.account-selector__name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.account-selector__id {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: var(--spacing-xs);
}

.account-selector__arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid var(--text-secondary);
  margin-left: var(--spacing-sm);
  transition: transform 0.2s ease;
}

.account-selector__arrow.is-active {
  transform: rotate(180deg);
}

/* 账户下拉菜单 */
.account-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  height: 100vh;
  visibility: hidden;
  transition: visibility 0.2s;
  z-index: 200;
}

.account-dropdown.is-visible {
  visibility: visible;
}

.account-dropdown__mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.2s;
}

.account-dropdown.is-visible .account-dropdown__mask {
  opacity: 1;
}

.account-dropdown__list {
  position: relative;
  background-color: var(--bg-card);
  border-bottom-left-radius: var(--radius-lg);
  border-bottom-right-radius: var(--radius-lg);
  padding: var(--spacing-sm) 0;
  transform: translateY(-100%);
  transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.account-dropdown.is-visible .account-dropdown__list {
  transform: translateY(0);
}

.account-dropdown__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: 28rpx;
}

.account-dropdown__item:active {
  background-color: var(--bg-hover);
}

.account-dropdown__item.is-selected {
  color: var(--primary);
  background-color: var(--primary-light);
}

.account-dropdown__text {
  flex: 1;
}

.account-dropdown__check {
  width: 12rpx;
  height: 24rpx;
  border-bottom: 4rpx solid var(--primary);
  border-right: 4rpx solid var(--primary);
  transform: rotate(45deg);
}

/* ========== 5. 主内容区 ========== */
.main-content {
  flex: 1;
  padding: var(--spacing-md);
  box-sizing: border-box;
}

/* ========== 6. 资产概览表格 ========== */
.asset-table {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.asset-table__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  border-bottom: 1rpx solid var(--border-light);
}

.asset-table__row:last-child {
  border-bottom: none;
}

.asset-table__label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.asset-table__value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  font-family: 'DIN Alternate', 'Roboto', sans-serif;
}

.asset-table__value--large {
  font-size: 36rpx;
  font-weight: 700;
}

/* ========== 7. Tab切换区域 ========== */
.positions-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.tabs__item {
  font-size: 26rpx;
  color: var(--text-regular);
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-sm);
  background-color: var(--bg-card);
  transition: all 0.2s;
}

.tabs__item.is-active {
  color: var(--text-white);
  background-color: var(--primary);
  font-weight: 500;
}

/* 数据说明入口 */
.data-info-trigger {
  display: flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-sm);
}

.data-info-trigger__text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.data-info-trigger__icon {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid var(--text-secondary);
  margin-left: var(--spacing-xs);
}

/* ========== 8. 持仓卡片 ========== */
.positions-list {
  padding-top: var(--spacing-xs);
}

.position-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.position-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md);
  border-bottom: 1rpx solid var(--border-light);
}

.position-card__type {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.position-card__type-tag {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.position-card__scale {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.position-card__actions {
  display: flex;
  align-items: center;
}

.action-icon {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: var(--spacing-xs);
}

.action-icon__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: var(--text-secondary);
}

/* 投入成本区域 */
.position-card__cost {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md);
}

.cost-trigger {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.cost-trigger__label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.cost-trigger__arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid var(--text-secondary);
  border-right: 2rpx solid var(--text-secondary);
  transform: rotate(135deg);
  transition: transform 0.2s;
}

.cost-trigger__arrow.is-expanded {
  transform: rotate(-45deg);
}

.cost-trigger__value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 成本详情 */
.cost-detail {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-out;
  background-color: var(--bg-secondary);
}

.cost-detail.is-expanded {
  max-height: 600rpx;
}

.cost-detail__row {
  display: flex;
  justify-content: space-between;
  padding: var(--spacing-sm) var(--spacing-md);
  border-bottom: 1rpx solid var(--border-light);
}

.cost-detail__row:last-child {
  border-bottom: none;
}

.cost-detail__label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.cost-detail__value {
  font-size: 24rpx;
  color: var(--text-primary);
  font-family: 'DIN Alternate', sans-serif;
}

/* 操作按钮组 */
.position-card__footer {
  padding: var(--spacing-sm) var(--spacing-md);
  border-top: 1rpx solid var(--border-light);
}

.btn-group {
  display: flex;
  justify-content: flex-end;
  gap: var(--spacing-sm);
}

.btn-small {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  line-height: 1.4;
}

.btn-outline {
  border: 1rpx solid var(--border);
  color: var(--text-primary);
  background-color: var(--bg-card);
}

.btn-primary {
  background: var(--primary);
  color: var(--text-white);
  border: 1rpx solid var(--primary);
}

.btn-danger {
  background: transparent;
  color: var(--danger);
  border: 1rpx solid var(--danger);
}

/* ========== 9. 录持仓按钮 ========== */
.add-position-btn {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4298EF 0%, #3370FF 100%);
  box-shadow: 0 8rpx 24rpx rgba(66, 152, 239, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.add-position-btn__text {
  font-size: 26rpx;
  color: var(--text-white);
  font-weight: 500;
}

/* ========== 10. 辅助类 ========== */
.color-profit { color: var(--success); }
.color-loss { color: var(--danger); }
.color-primary { color: var(--primary); }
.color-regular { color: var(--text-regular); }

/* ========== 11. 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state__text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ========== 12. 列表底部 ========== */
.list-footer {
  display: flex;
  justify-content: center;
  padding: var(--spacing-lg) 0;
}

.list-footer__text {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

/* ========== 13. 安全区域 ========== */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
  height: 120rpx; /* 为底部按钮留出空间 */
}

/* ========== 14. 错误提示 ========== */
.error-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
}

.error-tip__text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
}

/* ========== 15. 数据说明弹窗 ========== */
.data-info-popup {
  padding: var(--spacing-md);
}

.data-info-popup__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-md);
  border-bottom: 1rpx solid var(--border-light);
}

.data-info-popup__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.data-info-popup__content {
  padding: var(--spacing-sm) 0;
}

.data-info-item {
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--border-light);
}

.data-info-item:last-child {
  border-bottom: none;
}

.data-info-item__label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.data-info-item__desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ========== 16. 弹窗表单样式 ========== */
.inquiry-form-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid var(--border-light);
  flex-shrink: 0;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.form-content {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 32rpx;
}

.form-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.field-unit {
  font-size: 24rpx;
  color: var(--text-regular);
}

.form-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--border-light);
  background: var(--bg-card);
  flex-shrink: 0;
}

/* ========== 17. 平仓确认弹窗样式 ========== */
.close-position-dialog {
  padding: var(--spacing-lg);
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.dialog-content {
  margin-bottom: var(--spacing-lg);
}

.position-info {
  background: var(--bg-secondary);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
}

.product-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.position-detail {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.close-type-info {
  display: flex;
  align-items: center;
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
}

.type-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.type-value {
  font-size: 26rpx;
  color: var(--text-primary);
}

.dialog-footer {
  display: flex;
  gap: var(--spacing-md);
}

.dialog-footer van-button {
  flex: 1;
}

/* ========== 18. 操作菜单样式 ========== */
.action-menu {
  padding: var(--spacing-md) 0;
}

.action-menu__item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
  border-bottom: 1rpx solid var(--border-light);
}

.action-menu__item:last-child {
  border-bottom: none;
}

.action-menu__text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.action-menu__item--primary .action-menu__text {
  color: var(--primary);
}

.action-menu__item--danger .action-menu__text {
  color: var(--danger);
}

.action-menu__item--cancel {
  margin-top: var(--spacing-sm);
  background-color: var(--bg-secondary);
}

/* ========== 19. 持仓高亮样式 ========== */
.position-card--highlight {
  border: 2rpx solid var(--primary);
  box-shadow: 0 0 0 4rpx rgba(66, 152, 239, 0.15);
  animation: positionHighlight 2s ease forwards;
}

@keyframes positionHighlight {
  0%   { box-shadow: 0 0 0 6rpx rgba(66, 152, 239, 0.35); border-color: var(--primary); }
  60%  { box-shadow: 0 0 0 4rpx rgba(66, 152, 239, 0.20); border-color: var(--primary); }
  100% { box-shadow: none; border-color: transparent; }
}