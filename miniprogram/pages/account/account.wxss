/* pages/account/account.wxss */

/*
  优化说明:
  1. 全面替换硬编码颜色为 app.wxss 的全局 CSS 变量，统一视觉风格。
  2. 重构动画，避免对 `all` 和 `max-height` 进行过渡，提升性能。
  3. 统一命名规范，使用 is-* 状态类。
  4. 复用全局工具类，减少代码冗余。
*/

page {
  --profit-color: #03B615;
  --loss-color: #FF4444;
}

page { --primary-color:#3370FF; --profit-color:#F54F52; --loss-color:#00B866; --bg-page:#F5F7FA; --bg-card:#FFFFFF; --text-primary:#1F2329; --text-regular:#646A73; --shadow:0 4rpx 16rpx rgba(0,0,0,0.04); }
.page { background: var(--bg-page); min-height: 100vh; color: var(--text-primary); }
.custom-nav { position: relative; padding: 24rpx; display: flex; align-items: center; background: var(--bg-card); box-shadow: var(--shadow); }
.account-selector { display:flex; align-items:center; gap: 12rpx; font-size: 30rpx; }
.account-selector__name { font-weight: 600; }
.account-selector__id { color: var(--text-regular); }
.account-selector__arrow { margin-left: auto; transition: transform .3s ease; }
.account-selector__arrow.is-open { transform: rotate(180deg); }
.account-selector__dropdown { position:absolute; left:24rpx; right:24rpx; top:100%; background: var(--bg-card); border-radius: 12rpx; box-shadow: var(--shadow); transform: translateY(-10rpx); opacity:0; pointer-events:none; transition: transform .2s ease, opacity .2s ease; }
.account-selector__dropdown.is-open { transform: translateY(0); opacity:1; pointer-events:auto; }
.account-selector__item { padding: 24rpx; border-bottom: 1rpx solid #EDF0F5; font-size: 28rpx; }
.account-selector__item:last-child { border-bottom: none; }

.action-bar { padding: 24rpx; }
.btn { height: 88rpx; border-radius: 12rpx; display:flex; align-items:center; justify-content:center; font-size: 32rpx; }
.btn--primary { background: var(--primary-color); color:#fff; }

.card { background: var(--bg-card); border-radius: 16rpx; margin: 24rpx; box-shadow: var(--shadow); }
.card__header { padding: 24rpx; }
.card__body { padding: 24rpx; }
.overview-card__metrics { display:flex; gap: 24rpx; }
.metric { flex:1; display:flex; flex-direction:column; gap: 8rpx; }
.metric__label { font-size: 26rpx; color: var(--text-regular); }
.metric__value { font-size: 40rpx; font-family: "DIN Alternate", sans-serif; }
.text--profit { color: var(--profit-color); }
.text--loss { color: var(--loss-color); }

.cost-section__header { display:flex; align-items:center; gap: 16rpx; }
.cost-section__title { font-size: 28rpx; color: var(--text-regular); }
.cost-section__total { margin-left:auto; font-size: 32rpx; font-family: "DIN Alternate", sans-serif; }
.cost-section__arrow { transition: transform .3s ease; }
.cost-section__arrow.is-open { transform: rotate(180deg); }
.cost-section__content { overflow:hidden; max-height:0; transition: max-height .3s ease; }
.cost-section__content.is-open { max-height: 400rpx; }
.cost-item { display:flex; justify-content:space-between; padding: 16rpx 0; }
.cost-item__label { color: var(--text-regular); font-size: 26rpx; }
.cost-item__value { font-size: 30rpx; font-family: "DIN Alternate", sans-serif; }

.content-section { background: transparent; margin-top: 12rpx; }
.tabs { display:flex; gap: 24rpx; padding: 0 24rpx; }
.tab-item { font-size: 30rpx; color: var(--text-regular); padding: 24rpx 0; }
.tab-item.is-active { color: var(--text-primary); font-weight: 600; border-bottom: 4rpx solid var(--primary-color); }

.position-list { padding: 0 12rpx; }
.position-card__header { display:flex; justify-content:space-between; align-items:center; }
.position-card__title { font-size: 30rpx; font-weight: 600; }
.position-card__scale { font-size: 26rpx; color: var(--text-regular); }
.position-card__grid { display:grid; grid-template-columns: repeat(3,1fr); gap: 16rpx; padding: 16rpx 0; }
.grid-item { background:#FAFBFC; border-radius: 12rpx; padding: 16rpx; }
.grid-item__label { font-size: 24rpx; color: var(--text-regular); }
.grid-item__value { font-size: 28rpx; font-family: "DIN Alternate", sans-serif; }
.position-card__footer { display:flex; justify-content:space-between; align-items:center; padding-top: 8rpx; }
.position-card__status { font-size: 26rpx; color: var(--text-regular); }
.position-card__actions { display:flex; gap: 24rpx; }
.action-text { font-size: 28rpx; color: var(--text-regular); }
.action-text--primary { color: var(--primary-color); }

.empty-state { display:flex; flex-direction:column; align-items:center; justify-content:center; padding: 80rpx 0; }
.empty-state__icon { font-size: 64rpx; }
.empty-state__text { font-size: 28rpx; color: var(--text-regular); margin-top: 12rpx; }

/* 页面头部: 模拟手机状态栏和标题，通常由小程序原生导航栏替代 */
.header {
  background-color: var(--white);
  padding: 20rpx 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

/* 账户选择器 */
.account-selector {
  margin: 30rpx;
  position: relative;
}

.selector-container {
  background-color: var(--white);
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--card-shadow, 0 2rpx 8rpx rgba(0,0,0,0.1));
}

.account-input {
  flex: 1;
  font-size: 32rpx;
  color: var(--text-color-primary);
}

.dropdown-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 20rpx;
  transition: transform 0.3s ease;
}

.dropdown-icon.is-open {
  transform: rotate(180deg);
}

.dropdown-list {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background-color: var(--white);
  border-radius: 12rpx;
  box-shadow: var(--card-shadow-lg, 0 4rpx 12rpx rgba(0,0,0,0.15));
  z-index: 1000;
  margin-top: 10rpx;
  opacity: 0;
  transform: translateY(-10rpx);
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none; /* 隐藏时不可点击 */
}

.dropdown-list.is-open {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.dropdown-item {
  padding: 24rpx 30rpx;
  font-size: 32rpx;
  color: var(--text-color-primary);
  border-bottom: 1rpx solid var(--border-color, #f0f0f0);
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item:active {
  background-color: var(--background-color);
}

/* 录持仓按钮: 复用全局 .btn-primary 样式 */
.add-position-btn {
  margin: 0 30rpx 30rpx;
}

/* 账户概览: 复用全局 .card 样式 */
.account-overview {
  margin: 0 30rpx;
  overflow: hidden;
}

.tab-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color, #f0f0f0);
}

.tab-list {
  display: flex;
  gap: 40rpx;
}

.tab-item {
  font-size: 28rpx;
  color: var(--text-color-regular);
  padding-bottom: 10rpx;
  position: relative;
}

.tab-item.is-active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.is-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

.data-explanation {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--text-color-regular);
}

.info-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 账户统计 */
.account-stats {
  padding: 30rpx;
}

.stat-row {
  margin-bottom: 30rpx;
}

.stat-row:last-child {
  margin-bottom: 0;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-label {
  font-size: 28rpx;
  color: var(--text-color-regular);
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color-primary);
}

.stat-value.is-main {
  color: var(--primary-color);
  font-size: 36rpx;
}

.stat-value.is-profit {
  color: var(--profit-color);
}

.stat-value.is-loss {
  color: var(--loss-color);
}

/* 投入成本 */
.cost-section {
  border-top: 1rpx solid var(--border-color, #f0f0f0);
}

.cost-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  gap: 20rpx;
}

.cost-title {
  font-size: 28rpx;
  color: var(--text-color-regular);
}

.cost-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-color-primary);
  font-weight: 600;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  transition: transform 0.3s ease;
}

.arrow-icon.is-open {
  transform: rotate(180deg);
}

.cost-detail {
  padding: 0 30rpx;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-out; /* 性能一般，但对于简单折叠可接受 */
}

.cost-detail.is-open {
  padding-bottom: 30rpx;
  max-height: 200rpx; /* 预估一个足够大的值 */
}

.cost-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.cost-label {
  font-size: 26rpx;
  color: var(--info-color);
}

.cost-amount {
  font-size: 26rpx;
  color: var(--text-color-primary);
}

/* 持仓列表 */
.position-list {
  margin: 30rpx;
}

.position-item {
  margin-bottom: 20rpx;
}

.position-item:last-child {
  margin-bottom: 0;
}

.position-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.position-type {
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.position-scale {
  font-size: 28rpx;
  color: var(--text-color-regular);
}

.position-info {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: var(--text-color-regular);
  white-space: nowrap;
}

.value {
  font-size: 26rpx;
  color: var(--text-color-primary);
}

.value.is-profit {
  color: var(--profit-color);
}

.value.is-loss {
  color: var(--loss-color);
}

.position-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color, #f0f0f0);
}

.status {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.dates {
  font-size: 24rpx;
  color: var(--info-color);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 30rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--info-color);
}

/* 底部导航栏 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: var(--white);
  display: flex;
  border-top: 1rpx solid var(--border-color, #f0f0f0);
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.nav-item.is-active .nav-text {
  color: var(--primary-color);
}

.nav-icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-text {
  font-size: 20rpx;
  color: var(--text-color-regular);
}