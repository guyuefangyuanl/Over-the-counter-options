/* pages/account/account.wxss */

/* Design Tokens */
page {
  /* Colors */
  --primary: #3370FF;
  --primary-light: #EBF2FF;
  --success: #00B866;
  --danger: #F54F52;
  --warning: #FF9F00;
  
  --text-primary: #1F2329;
  --text-regular: #646A73;
  --text-secondary: #8F959E;
  --text-white: #FFFFFF;
  
  --bg-page: #F5F7FA;
  --bg-card: #FFFFFF;
  --bg-hover: #F2F3F5;
  
  --border: #DEE0E3;
  --border-light: #EDF0F5;
  
  /* Spacing */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 40rpx;
  
  /* Radius */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  
  /* Shadows */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.page {
  min-height: 100vh;
  background-color: var(--bg-page);
  color: var(--text-primary);
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.nav-bar__content {
  height: 88rpx; /* 标准导航栏高度 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--spacing-md);
}

.account-trigger {
  display: flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-sm);
  background-color: var(--bg-hover);
  border-radius: 200rpx; /* Capsule shape */
}

.account-trigger__name {
  font-size: 28rpx;
  font-weight: 500;
  margin-right: var(--spacing-xs);
}

.account-trigger__icon {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid var(--text-primary);
  transition: transform 0.2s ease;
}

.account-trigger__icon.is-active {
  transform: rotate(180deg);
}

/* 账户下拉菜单 */
.account-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  height: 100vh;
  visibility: hidden;
  transition: visibility 0.2s;
}

.account-dropdown.is-visible {
  visibility: visible;
}

.account-dropdown__mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.2s;
}

.account-dropdown.is-visible .account-dropdown__mask {
  opacity: 1;
}

.account-dropdown__list {
  position: relative;
  background-color: var(--bg-card);
  border-bottom-left-radius: var(--radius-lg);
  border-bottom-right-radius: var(--radius-lg);
  padding: var(--spacing-sm) 0;
  transform: translateY(-100%);
  transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.account-dropdown.is-visible .account-dropdown__list {
  transform: translateY(0);
}

.account-dropdown__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: 30rpx;
}

.account-dropdown__item:active {
  background-color: var(--bg-hover);
}

.account-dropdown__item.is-selected {
  color: var(--primary);
  background-color: var(--primary-light);
}

.account-dropdown__sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: var(--spacing-sm);
  flex: 1;
}

.account-dropdown__check {
  width: 12rpx;
  height: 24rpx;
  border-bottom: 4rpx solid var(--primary);
  border-right: 4rpx solid var(--primary);
  transform: rotate(45deg);
}

/* 主内容区 */
.main-content {
  flex: 1;
  padding: var(--spacing-md);
  box-sizing: border-box;
}

/* 用户资料卡片 */
.user-profile-card {
    display: flex;
    align-items: center;
    background-color: var(--bg-card);
    padding: var(--spacing-md);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-md);
    box-shadow: var(--shadow-sm);
}

.user-avatar-btn {
    padding: 0;
    margin: 0;
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    overflow: hidden;
    background: none;
    border: none;
}

.user-avatar-btn::after {
    border: none;
}

.user-avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    background-color: var(--bg-hover);
}

.user-info-box {
    margin-left: var(--spacing-md);
    flex: 1;
}

.user-nickname {
    font-size: 34rpx;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--spacing-xs);
    display: block;
    height: 48rpx;
    line-height: 48rpx;
}

.user-id {
    font-size: 24rpx;
    color: var(--text-secondary);
}

/* 资产卡片 */
.asset-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-md);
  margin-bottom: var(--spacing-md);
}

.asset-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.asset-card__label {
  font-size: 26rpx;
  color: var(--text-regular);
}

.asset-card__action {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
  padding: 8rpx 16rpx;
  background: var(--primary-light);
  border-radius: var(--radius-sm);
}

.asset-card__amount {
  font-size: 60rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'Roboto', sans-serif; /* 数字优化 */
  color: var(--text-primary);
  margin-bottom: var(--spacing-lg);
  line-height: 1;
}

.asset-card__row {
  display: flex;
  justify-content: space-between;
  padding-bottom: var(--spacing-md);
  border-bottom: 1rpx dashed var(--border-light);
}

.asset-metric {
  flex: 1;
}

.asset-metric__label {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 8rpx;
}

.asset-metric__value {
  font-size: 32rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', sans-serif;
}

/* 成本面板 */
.cost-panel {
  margin-top: var(--spacing-md);
}

.cost-panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-xs) 0;
}

.cost-panel__title {
  font-size: 26rpx;
  color: var(--text-regular);
}

.cost-panel__arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid var(--text-secondary);
  border-right: 2rpx solid var(--text-secondary);
  transform: rotate(135deg);
  transition: transform 0.3s;
}

.cost-panel__arrow.is-expanded {
  transform: rotate(-45deg);
}

.cost-panel__body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-out;
}

.cost-panel__body.is-expanded {
  max-height: 200rpx;
  padding-top: var(--spacing-sm);
}

.cost-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-xs);
  font-size: 24rpx;
}

.cost-row__label {
  color: var(--text-secondary);
}

.cost-row__value {
  color: var(--text-primary);
  font-family: 'DIN Alternate', sans-serif;
}

/* 持仓部分 */
.positions-section {
  margin-top: var(--spacing-lg);
}

.tabs {
  display: flex;
  margin-bottom: var(--spacing-md);
  position: sticky; /* Sticky tabs */
  top: 0;
}

.tabs__item {
  margin-right: var(--spacing-lg);
  font-size: 30rpx;
  color: var(--text-regular);
  padding-bottom: 12rpx;
  position: relative;
  transition: all 0.2s;
}

.tabs__item.is-active {
  color: var(--text-primary);
  font-weight: 600;
  font-size: 32rpx;
}

.tabs__item.is-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: 6rpx;
}

/* 持仓卡片 */
.position-card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  margin-bottom: var(--spacing-md);
}

.position-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--border-light);
}

.position-card__name-box {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.position-card__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.position-card__tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: var(--bg-hover);
  color: var(--text-regular);
  border-radius: 8rpx;
}

.position-card__status {
  font-size: 24rpx;
}

.position-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-md) var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.position-item {
  display: flex;
  flex-direction: column;
}

.position-item__label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.position-item__value {
  font-size: 28rpx;
  font-weight: 500;
  font-family: 'DIN Alternate', sans-serif;
}

.position-card__footer {
  display: flex;
  justify-content: flex-end;
}

.btn-group {
  display: flex;
  gap: var(--spacing-sm);
}

.btn-small {
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  line-height: 1.4;
}

.btn-outline {
  border: 1rpx solid var(--border);
  color: var(--text-primary);
}

.btn-primary {
  background: var(--primary);
  color: var(--text-white);
  border: 1rpx solid var(--primary);
}

/* 辅助类 */
.color-profit { color: var(--success); }
.color-loss { color: var(--danger); }
.color-primary { color: var(--primary); }
.color-regular { color: var(--text-regular); }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state__image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.8;
}

.empty-state__text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

/* 错误降级提示 */
.error-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
}

.error-tip__text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
}

.error-tip__retry {
  font-size: 26rpx;
  color: var(--primary);
  padding: 8rpx 32rpx;
  border: 1rpx solid var(--primary);
  border-radius: 200rpx;
  margin-top: var(--spacing-sm);
}

/* 用户 ID 占位文字 */
.user-id--placeholder {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-style: italic;
}

/* 持仓列表容器 */
.positions-list {
  padding-top: var(--spacing-xs);
}

/* 空状态图标 */
.empty-state__icon {
  font-size: 80rpx;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-md);
  opacity: 0.4;
  line-height: 1;
}

/* 空状态操作按钮 */
.empty-state__action {
  margin-top: var(--spacing-md);
  font-size: 28rpx;
  color: var(--primary);
  padding: 14rpx 40rpx;
  border: 1rpx solid var(--primary);
  border-radius: 200rpx;
}

/* ========== 平仓确认弹窗样式 ========== */
.close-position-dialog {
  padding: var(--spacing-lg);
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.dialog-content {
  margin-bottom: var(--spacing-lg);
}

.position-info {
  background: var(--bg-secondary);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
}

.product-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.position-detail {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.close-type-info {
  display: flex;
  align-items: center;
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
}

.type-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.type-value {
  font-size: 26rpx;
  color: var(--text-primary);
}

.dialog-footer {
  display: flex;
  gap: var(--spacing-md);
}

.dialog-footer van-button {
  flex: 1;
}
