<view class="page">
  <view class="tabs tabs--primary">
    <view class="tabs__item {{activePrimaryTab==='自选'?'is-active':''}}" data-tab="自选" bindtap="switchPrimaryTab">自选</view>
    <view class="tabs__item {{activePrimaryTab==='个股'?'is-active':''}}" data-tab="个股" bindtap="switchPrimaryTab">个股</view>
    <view class="tabs__item {{activePrimaryTab==='指数'?'is-active':''}}" data-tab="指数" bindtap="switchPrimaryTab">指数</view>
    <view class="tabs__item {{activePrimaryTab==='ETF'?'is-active':''}}" data-tab="ETF" bindtap="switchPrimaryTab">ETF</view>
    
  </view>

  <view class="sticky">
    <view wx:if="{{activePrimaryTab==='自选'}}" class="group-bar">
      <view class="group-left">
        <view class="group-chip {{activeSecondaryTab==='全部'?'is-active':''}}" data-group="全部" bindtap="switchSecondaryTab">全部</view>
        <view class="group-chip {{activeSecondaryTab==='持仓'?'is-active':''}}" data-group="持仓" bindtap="switchSecondaryTab">持仓</view>
        <view class="group-chip {{activeSecondaryTab==='沪深'?'is-active':''}}" data-group="沪深" bindtap="switchSecondaryTab">沪深</view>
        <view class="group-chip {{activeSecondaryTab==='指数'?'is-active':''}}" data-group="指数" bindtap="switchSecondaryTab">指数</view>
      </view>
      <view class="info-link" bindtap="showDataInfo">数据说明 <text class="info-icon">?</text></view>
    </view>

    <view class="structure-line">
      <view class="structure-chip">香草看涨</view>
    </view>

    <view class="searchbar" bindtap="goToSearch">
      <text class="searchbar__icon">🔍</text>
      <text class="searchbar__placeholder">搜索标的</text>
    </view>

    <view class="filters-line">
      <text class="filters-label">期限</text>
      <view class="chips">
        <view class="chip {{filters.period==='1M'?'is-active':''}}" data-period="1M" bindtap="onPeriodChipTap">1M</view>
        <view class="chip {{filters.period==='2M'?'is-active':''}}" data-period="2M" bindtap="onPeriodChipTap">2M</view>
        <view class="chip {{filters.period==='3M'?'is-active':''}}" data-period="3M" bindtap="onPeriodChipTap">3M</view>
        <view class="chip {{filters.period==='6M'?'is-active':''}}" data-period="6M" bindtap="onPeriodChipTap">6M</view>
      </view>
      <view class="dealer">
        <text class="dealer-label">交易商</text>
        <picker mode="selector" range="{{dealerOptions}}" range-key="name" bindchange="onDealerChange">
          <view class="dealer-value">{{filters.dealer}} <text class="arrow">▼</text></view>
        </picker>
      </view>
    </view>
  </view>

  <view class="table">
    <view class="table__header">
      <view class="table__cell table__cell--name">标的|代码</view>
      <view class="table__cell">涨跌幅</view>
      <view class="table__cell">平值</view>
      <view class="table__cell">虚值105</view>
      <view class="table__cell">虚值110</view>
    </view>

    <view class="table__row" wx:for="{{quoteList}}" wx:key="code">
      <view class="table__cell table__cell--name" data-code="{{item.code}}" bindtap="goToDetail">
        <text class="name">{{item.name}}</text>
        <text class="code">{{item.code}}</text>
      </view>
      <view class="table__cell">{{item.change}}</view>
      <view class="table__cell action" data-quote="{{item}}" bindtap="showOrderIntent">{{item.atm}}</view>
      <view class="table__cell action" data-quote="{{item}}" bindtap="showOrderIntent">{{item.otm105}}</view>
      <view class="table__cell action" data-quote="{{item}}" bindtap="showOrderIntent">{{item.otm110 || '--'}}</view>
    </view>
  </view>

  <view class="actions">
    <view class="btn btn--ghost" bindtap="openGroupManager">编辑自选</view>
    <view class="btn btn--add" bindtap="goToSearch">+添加自选</view>
  </view>

  <order-intent wx:if="{{showOrderIntentPopup}}" quoteInfo="{{selectedQuote}}" bind:close="closeOrderIntent"></order-intent>
</view>
