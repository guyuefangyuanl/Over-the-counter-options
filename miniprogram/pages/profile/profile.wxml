<!--我的页面模板 - 基于原型HTML重新设计-->
<view class="profile-page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">我的</text>
  </view>

  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-card-inner">
      <!-- 未登录状态 -->
      <block wx:if="{{!userInfo.isLoggedIn}}">
        <view class="user-avatar-section">
          <view class="default-avatar">
            <image class="avatar-placeholder" src="data:image/svg+xml;base64," mode="aspectFill" />
          </view>
        </view>
        <view class="user-info-section">
          <view class="login-register-text">登录/注册</view>
        </view>
      </block>

      <!-- 已登录状态 -->
      <block wx:else>
        <view class="user-avatar-section">
          <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image
              class="user-avatar {{userInfo.avatar ? '' : 'default'}}"
              src="{{userInfo.avatar || 'data:image/svg+xml;base64,'}}"
              mode="aspectFill"
              binderror="onAvatarError"
            />
            <!-- 头像上传加载指示器 -->
            <view class="avatar-loading-mask" wx:if="{{isAvatarUploading}}">
              <van-loading size="20px" type="spinner" color="#fff" />
            </view>
          </button>
        </view>
        <view class="user-info-section">
          <view class="user-nickname-row">
            <input
              type="nickname"
              class="nickname-input"
              placeholder="点击设置昵称"
              value="{{userInfo.nickname || ''}}"
              bindblur="onNicknameChange"
            />
          </view>
          <view class="user-vip-info">
            <text class="vip-level-text">{{userInfo.vipLevel || 'V1'}}会员</text>
            <text class="vip-id-text" wx:if="{{userInfo.vipId}}">（VID:{{userInfo.vipId}}）</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 功能菜单列表 -->
  <view class="menu-card">
    <view class="menu-list">
      <view
        class="menu-item"
        wx:for="{{menuItems}}"
        wx:key="id"
        data-item="{{item}}"
        bindtap="onMenuTap"
      >
        <view class="menu-item-content">
          <view class="menu-icon-wrapper">
            <image class="menu-icon-img" src="{{item.iconSrc}}" mode="aspectFit" />
          </view>
          <text class="menu-item-text">{{item.title}}</text>
        </view>
        <view class="menu-arrow-icon">
          <image class="arrow-img" src="data:image/svg+xml;base64," mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <!-- 未登录状态：授权一键登录按钮 -->
  <view class="auth-section" wx:if="{{!userInfo.isLoggedIn}}">
    <button
      class="auth-login-btn"
      bindtap="onLogin"
      disabled="{{isLoggingIn}}"
    >
      {{isLoggingIn ? '登录中...' : '授权一键登录'}}
    </button>
  </view>

  <!-- 已登录状态：退出登录按钮 -->
  <view class="logout-section" wx:if="{{userInfo.isLoggedIn}}">
    <button
      class="logout-btn"
      bindtap="onLogout"
      disabled="{{isLoggingOut}}"
    >
      {{isLoggingOut ? '退出中...' : '退出登录'}}
    </button>
  </view>

  <!-- 未登录状态的功能说明 -->
  <view class="feature-intro-card" wx:if="{{!userInfo.isLoggedIn}}">
    <view class="intro-title">登录后可享受</view>
    <view class="intro-list">
      <view class="intro-item">
        <image class="intro-check-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
        <text>个性化期权报价推荐</text>
      </view>
      <view class="intro-item">
        <image class="intro-check-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
        <text>询价历史记录保存</text>
      </view>
      <view class="intro-item">
        <image class="intro-check-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
        <text>VIP专属客服支持</text>
      </view>
      <view class="intro-item">
        <image class="intro-check-icon" src="data:image/svg+xml;base64," mode="aspectFit" />
        <text>更多高级功能权限</text>
      </view>
    </view>
  </view>

  <!-- 已登录状态的统计信息 -->
  <view class="stats-card" wx:if="{{userInfo.isLoggedIn}}">
    <view class="stats-title">我的统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-number">{{userStatistics.totalInquiries || 0}}</view>
        <view class="stat-label">累计询价</view>
      </view>
      <view class="stat-item">
        <view class="stat-number">{{userStatistics.successfulTrades || 0}}</view>
        <view class="stat-label">成功交易</view>
      </view>
      <view class="stat-item">
        <view class="stat-number">{{userStatistics.favoriteStocks || 0}}</view>
        <view class="stat-label">关注标的</view>
      </view>
      <view class="stat-item">
        <view class="stat-number">{{userStatistics.daysUsed || 1}}</view>
        <view class="stat-label">使用天数</view>
      </view>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-section">
    <text class="version-text">期权大师 v1.0.0</text>
  </view>
</view>