/* 我的页面样式 */
.profile-container {
  padding: 0;
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  padding: 48rpx 32rpx;
  border-radius: 0;
  position: relative;
  overflow: hidden;
}

.user-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.avatar-section {
  margin-right: 24rpx;
  position: relative;
}

/* 头像按钮样式 */
.avatar-btn {
  position: relative;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  overflow: visible;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.6);
  background: rgba(255,255,255,0.2);
  display: block;
}

.default-avatar {
  background: rgba(255,255,255,0.3);
}

/* 头像加载指示器 */
.avatar-loading {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
}

/* 头像编辑提示 */
.avatar-edit-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.6);
  padding: 6rpx 0;
  text-align: center;
  border-radius: 0 0 64rpx 64rpx;
}

.avatar-edit-tip text {
  font-size: 20rpx;
  color: #fff;
}

.user-details {
  flex: 1;
  position: relative;
  z-index: 1;
}

/* 昵称行 */
.nickname-row {
  display: flex;
  align-items: center;
}

.nickname-input {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  max-width: 300rpx;
}

.nickname-input::placeholder {
  color: rgba(255,255,255,0.7);
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.vip-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.vip-level {
  background: #f2f3f5;
  color: #409EFF;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.vip-id {
  font-size: 24rpx;
  opacity: 0.8;
}

.login-hint {
  margin-top: 8rpx;
}

.hint-text {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 认证按钮 */
.auth-section {
  display: flex;
  justify-content: center;
}

.auth-btn {
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 18rpx 48rpx;
  font-weight: 500;
}

.login-btn {
  background: #409EFF;
  color: #ffffff;
}

.logout-btn {
  background: #ffffff;
  color: #606266;
  border: 2rpx solid #e5e6eb;
}

.auth-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 功能菜单 */
.menu-section {
  margin: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.menu-title {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  border-bottom: 2rpx solid #f0f0f0;
}

.menu-list {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 30rpx;
  border-bottom: 2rpx solid #f8f8f8;
  transition: background-color 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f8f8f8;
}

.menu-content {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  border-radius: 6rpx;
  position: relative;
  background: #eef2f7;
}

.menu-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.menu-icon.member { background: #eef2f7; }

.menu-icon.member::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-icon.profile { background: #eef2f7; }

.menu-icon.profile::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-icon.service { background: #eef2f7; }

.menu-icon.service::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-icon.suggestion { background: #eef2f7; }

.menu-icon.suggestion::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.menu-arrow {
  color: #c0c0c0;
}

/* 功能介绍 */
.feature-intro {
  margin: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #f0f0f0;
  box-shadow: none;
}

.intro-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
}

.intro-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.intro-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.intro-item icon {
  margin-right: 15rpx;
}

/* 统计信息 */
.stats-section {
  margin: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #f0f0f0;
  box-shadow: none;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25rpx;
}

.stat-item {
  text-align: center;
  padding: 25rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 20rpx 80rpx;
}

.version-text {
  font-size: 22rpx;
  color: #999;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .profile-container {
    font-size: 26rpx;
  }
  
  .user-card {
    padding: 30rpx 20rpx 25rpx;
  }
  
  .nickname {
    font-size: 32rpx;
  }
  
  .menu-section, 
  .feature-intro, 
  .stats-section {
    margin: 15rpx;
    padding: 25rpx;
  }
  
  .stats-grid {
    gap: 20rpx;
  }
  
  .stat-item {
    padding: 20rpx;
  }
}
