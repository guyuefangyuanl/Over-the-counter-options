/* 我的页面样式 */
.profile-container {
  padding: 0;
  background-color: var(--background-color);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 用户信息卡片 - 头部设计 */
.user-card {
  background: var(--gradient-primary); /* 使用全局渐变色 */
  color: #ffffff;
  padding: 40rpx 40rpx 80rpx; /* 增加底部内边距，为重叠卡片留空间 */
  border-radius: 0 0 48rpx 48rpx; /* 底部圆角 */
  border-bottom: none;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 20rpx rgba(64, 158, 255, 0.3);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar-section {
  margin-right: 32rpx;
  position: relative;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6); /* 半透明白色边框 */
  background: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
}

.default-avatar {
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-details {
  flex: 1;
}

.nickname {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.vip-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.vip-level {
  background: rgba(0, 0, 0, 0.2); /* 深色半透明背景 */
  color: #ffd700; /* 金色字体 */
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255, 215, 0, 0.3);
}

.vip-id {
  font-size: 24rpx;
  opacity: 0.9;
}

.login-hint {
  margin-top: 8rpx;
}

.hint-text {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 认证按钮 */
.auth-section {
  display: flex;
  justify-content: flex-start; /* 左对齐或根据布局调整 */
  margin-top: 20rpx;
}

.auth-btn {
  border: none;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.login-btn {
  background: #ffffff;
  color: var(--primary-color);
}

.logout-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.auth-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 通用卡片容器样式 */
.menu-section, 
.feature-intro, 
.stats-section {
  margin: 0 24rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05); /* 更柔和的阴影 */
  border: none;
}

/* 让第一个卡片向上重叠头部 */
.menu-section {
  margin-top: -50rpx; /* 向上偏移 */
  position: relative;
  z-index: 2;
}

.menu-title,
.intro-title,
.stats-title {
  padding: 32rpx 32rpx 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #303133;
  border-bottom: none; /* 移除标题下划线，更简洁 */
  display: flex;
  align-items: center;
}

.menu-title::before,
.intro-title::before,
.stats-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: var(--primary-color);
  margin-right: 16rpx;
  border-radius: 4rpx;
}

/* 功能菜单列表 */
.menu-list {
  padding: 0 16rpx 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid #f5f7fa;
  margin: 0 16rpx;
  transition: all 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.menu-content {
  display: flex;
  align-items: center;
}

/* 菜单图标优化 */
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 24rpx;
  border-radius: 20rpx; /* 方圆形 */
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.05);
}

.menu-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 32rpx;
  height: 32rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* 为每个图标分配不同的背景色并设置图标SVG */
.menu-icon.member { 
  background: linear-gradient(135deg, #a0cfff 0%, #409EFF 100%); 
}
.menu-icon.member::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-icon.profile { 
  background: linear-gradient(135deg, #95d475 0%, #67C23A 100%); 
}
.menu-icon.profile::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-icon.service { 
  background: linear-gradient(135deg, #fab6b6 0%, #F56C6C 100%); 
}
.menu-icon.service::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-icon.suggestion { 
  background: linear-gradient(135deg, #b3e19d 0%, #E6A23C 100%); 
}
.menu-icon.suggestion::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-text {
  font-size: 30rpx;
  color: #303133;
  font-weight: 500;
}

.menu-arrow icon {
  opacity: 0.4;
}

/* 功能介绍 */
.feature-intro {
  padding: 10rpx 0 30rpx;
}

.intro-list {
  display: grid;
  grid-template-columns: 1fr 1fr; /* 双列布局 */
  gap: 24rpx;
  padding: 0 32rpx;
}

.intro-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #606266;
  background: #f8f9fa;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
}

.intro-item icon {
  margin-right: 12rpx;
}

/* 统计信息 */
.stats-section {
  padding-bottom: 32rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 0 32rpx;
}

.stat-item {
  text-align: center;
  padding: 32rpx 20rpx;
  background: linear-gradient(to bottom, #ffffff, #f9fafc);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #ebeef5;
}

.stat-number {
  font-size: 56rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 12rpx;
  font-family: 'DIN Alternate', sans-serif; /* 尝试使用数字字体 */
}

.stat-label {
  font-size: 26rpx;
  color: #909399;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 20rpx 80rpx;
}

.version-text {
  font-size: 24rpx;
  color: #c0c4cc;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .profile-container {
    font-size: 28rpx;
  }
}
