/* 我的页面样式 - 基于原型HTML重新设计 */

/* ========== 页面基础 ========== */
.profile-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 页面标题 ========== */
.page-header {
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* ========== 用户信息卡片 ========== */
.user-card {
  margin: 24rpx 24rpx 0;
  background-color: #ECF5FF;
  border-radius: 20rpx;
  border: 2rpx solid #F2F2F2;
  overflow: hidden;
}

.user-card-inner {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}

/* 头像区域 */
.user-avatar-section {
  flex-shrink: 0;
  margin-right: 24rpx;
}

.avatar-button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  overflow: visible;
  position: relative;
}

.avatar-button::after {
  display: none;
}

.user-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background-color: #E0E0E0;
  display: block;
}

.user-avatar.default {
  background-color: #E0E0E0;
}

.default-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background-color: #E0E0E0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder {
  width: 110rpx;
  height: 110rpx;
}

/* 头像上传加载指示器 */
.avatar-loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 用户信息区域 */
.user-info-section {
  flex: 1;
  min-width: 0;
}

.user-nickname-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nickname-input {
  font-size: 36rpx;
  font-weight: 500;
  color: #333333;
  background: transparent;
  padding: 0;
  margin: 0;
  max-width: 400rpx;
}

.nickname-input::placeholder {
  color: #999999;
}

.user-vip-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.vip-level-text {
  font-size: 26rpx;
  color: #409EFF;
  background-color: rgba(64, 158, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  margin-right: 8rpx;
}

.vip-id-text {
  font-size: 26rpx;
  color: #7F7F7F;
}

/* 未登录状态 */
.login-register-text {
  font-size: 36rpx;
  font-weight: 500;
  color: #333333;
}

/* ========== 功能菜单卡片 ========== */
.menu-card {
  margin: 24rpx 24rpx 0;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #F2F2F2;
  overflow: hidden;
}

.menu-list {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  min-height: 92rpx;
  position: relative;
}

.menu-item::after {
  content: '';
  position: absolute;
  left: 100rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background-color: rgba(0, 0, 0, 0.08);
}

.menu-item:last-child::after {
  display: none;
}

.menu-item:active {
  background-color: #F8F8F8;
}

.menu-item-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.menu-icon-wrapper {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.menu-item-text {
  font-size: 32rpx;
  color: #333333;
}

.menu-arrow-icon {
  flex-shrink: 0;
  width: 20rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-img {
  width: 16rpx;
  height: 16rpx;
  opacity: 0.3;
}

/* ========== 授权登录按钮 ========== */
.auth-section {
  margin: 32rpx 24rpx;
}

.auth-login-btn {
  width: 100%;
  height: 88rpx;
  background-color: #409EFF;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-login-btn::after {
  display: none;
}

.auth-login-btn:active {
  opacity: 0.85;
}

.auth-login-btn[disabled] {
  opacity: 0.6;
}

/* ========== 退出登录按钮 ========== */
.logout-section {
  margin: 32rpx 24rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background-color: #FFFFFF;
  color: #606266;
  font-size: 32rpx;
  font-weight: 400;
  border: 2rpx solid #EEEEEE;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.06);
}

.logout-btn::after {
  display: none;
}

.logout-btn:active {
  background-color: #F8F8F8;
}

.logout-btn[disabled] {
  opacity: 0.6;
}

/* ========== 功能说明卡片 ========== */
.feature-intro-card {
  margin: 24rpx 24rpx 0;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #F2F2F2;
  padding: 32rpx;
}

.intro-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 24rpx;
}

.intro-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.intro-item {
  display: flex;
  align-items: center;
}

.intro-check-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.intro-item text {
  font-size: 28rpx;
  color: #666666;
}

/* ========== 统计信息卡片 ========== */
.stats-card {
  margin: 24rpx 24rpx 0;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #F2F2F2;
  padding: 32rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  text-align: center;
  padding: 24rpx;
  background-color: #F8F9FA;
  border-radius: 16rpx;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 600;
  color: #409EFF;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #909399;
}

/* ========== 版本信息 ========== */
.version-section {
  text-align: center;
  padding: 48rpx 24rpx;
}

.version-text {
  font-size: 24rpx;
  color: #C0C4CC;
}

/* ========== 响应式适配 ========== */
@media (max-width: 750rpx) {
  .user-card {
    margin: 16rpx 16rpx 0;
  }

  .menu-card {
    margin: 16rpx 16rpx 0;
  }

  .stats-card {
    margin: 16rpx 16rpx 0;
  }

  .feature-intro-card {
    margin: 16rpx 16rpx 0;
  }

  .auth-section,
  .logout-section {
    margin: 24rpx 16rpx;
  }
}