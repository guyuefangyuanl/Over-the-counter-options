<!--pages/data-explanation/data-explanation.wxml-->
<view class="container">
  <!-- 页面头部 -->
  <view class="header">
    <view class="header-top">
      <view class="back-btn" bindtap="goBack">
        <image src="/images/back.png" class="back-icon"></image>
      </view>
      <view class="title">持仓数据说明</view>
      <view class="share-btn" bindtap="onShareAppMessage">
        <image src="/images/share.png" class="share-icon"></image>
      </view>
    </view>
    
    <view class="update-time">{{lastUpdateTime}}</view>
    
    <!-- 搜索框 -->
    <view class="search-box">
      <input class="search-input" 
             placeholder="搜索术语或内容..." 
             bindinput="searchContent" />
      <image src="/images/search.png" class="search-icon"></image>
    </view>
    
    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="action-btn" bindtap="expandAll">展开全部</button>
      <button class="action-btn" bindtap="collapseAll">折叠全部</button>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="search-results" wx:if="{{searchResults && searchResults.length > 0}}">
    <view class="results-header">搜索结果 ({{searchResults.length}})</view>
    <view class="result-item" 
          wx:for="{{searchResults}}" 
          wx:key="index"
          data-result="{{item}}"
          bindtap="jumpToResult">
      <view class="result-section">{{item.sectionTitle}}</view>
      <view class="result-term">{{item.term}}</view>
      <view class="result-definition">{{item.definition}}</view>
    </view>
  </view>

  <!-- 内容章节 -->
  <view class="content-sections">
    <view class="section" 
          wx:for="{{sections}}" 
          wx:key="id"
          id="section-{{item.id}}">
      <!-- 章节标题 -->
      <view class="section-header" 
            data-section-id="{{item.id}}"
            bindtap="toggleSection">
        <view class="section-title">{{item.title}}</view>
        <image src="../../images/arrow-down.svg" 
               class="expand-icon {{expandedSections[item.id] ? 'is-expanded' : ''}}"></image>
      </view>
      
      <!-- 章节内容 -->
      <view class="section-content {{expandedSections[item.id] ? 'expanded' : ''}}"
            wx:if="{{expandedSections[item.id]}}">
        <view class="content-item" wx:for="{{item.content}}" wx:key="term" wx:for-item="contentItem">
          <!-- 术语定义 -->
          <view class="term-definition">
            <view class="term">
              <text class="term-text">{{contentItem.term}}</text>
              <image src="/images/copy.png" 
                     class="copy-icon"
                     data-text="{{contentItem.term}}: {{contentItem.definition}}"
                     bindtap="copyText"></image>
            </view>
            <view class="definition">{{contentItem.definition}}</view>
          </view>
          
          <!-- 公式（如果有） -->
          <view class="formula-section" wx:if="{{contentItem.formula}}">
            <view class="formula-label">计算公式：</view>
            <view class="formula-content">{{contentItem.formula}}</view>
          </view>
          
          <!-- 多个公式（如果有） -->
          <view class="formulas-section" wx:if="{{contentItem.formulas}}">
            <view class="formulas-list">
              <view class="formula-item" wx:for="{{contentItem.formulas}}" wx:key="type" wx:for-item="formula">
                <view class="formula-type">{{formula.type}}：</view>
                <view class="formula-content" wx:if="{{formula.formula}}">{{formula.formula}}</view>
                <view class="formula-description" wx:if="{{formula.description}}">{{formula.description}}</view>
                <view class="formula-example" wx:if="{{formula.example}}">
                  <text class="example-label">示例：</text>
                  <text class="example-content">{{formula.example}}</text>
                </view>
              </view>
            </view>
          </view>
          
          <!-- 示例（如果有） -->
          <view class="example-section" wx:if="{{contentItem.example}}">
            <view class="example-label">示例：</view>
            <view class="example-content">{{contentItem.example}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 风险提示 -->
  <view class="risk-notice">
    <view class="notice-header">
      <image src="/images/warning.png" class="warning-icon"></image>
      <text class="notice-title">重要提示</text>
    </view>
    <view class="notice-content">
      <text class="notice-text">期权有风险，投资须谨慎。数据及信息仅供参考，并不构成任何具体产品、业务的推介及相关品种的操作依据和建议，投资者据此作出的任何投资决策自负盈亏。</text>
    </view>
  </view>

  <!-- 页面底部 -->
  <view class="page-footer">
    <view class="footer-text">如有疑问，请联系客服或咨询专业人士</view>
  </view>
</view>