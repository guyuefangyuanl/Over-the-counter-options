/* 页面容器 */
.page-container {
  width: 100vw;
  height: 100vh;
  background-color: #fff;
  display: flex;
  flex-direction: column;
}

/* 1. 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(to right, #6ebdfc, #89cff0); /* 接近图片的浅蓝色 */
  background-color: #7bbfea;
  z-index: 1000;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 200rpx; /* 给右侧胶囊留空 */
  box-sizing: border-box;
}

.nav-tabs {
  display: flex;
  align-items: flex-end; /* 底部对齐 */
  height: 100%;
  padding-bottom: 12rpx;
  gap: 32rpx;
}

.nav-tab {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
  position: relative;
  transition: all 0.3s;
}

.nav-tab.active {
  font-size: 40rpx; /* 选中变大 */
  color: #ffffff;
  font-weight: 600;
}

.nav-tab.active::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background-color: #fff;
  border-radius: 4rpx;
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  width: 100%;
  background-color: #fff;
}

/* 2. 次级筛选栏 */
.sub-filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 16rpx 24rpx;
}

.sub-filters {
  display: flex;
  gap: 32rpx;
}

.sub-filter-item {
  font-size: 28rpx;
  color: #333;
}

.sub-filter-item.active {
  color: #409eff; /* 选中蓝 */
  font-weight: 600;
  position: relative;
}

.sub-filter-item.active::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  width: 100%;
  height: 2rpx;
  background-color: #409eff;
}

.filter-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.vanilla-tag {
  background-color: #eaf4fe;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.vanilla-tag text {
  font-size: 22rpx;
  color: #409eff;
}

.data-info {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.info-label {
  font-size: 22rpx;
  color: #999;
}

.info-icon {
  width: 24rpx;
  height: 24rpx;
  border: 1px solid #999;
  border-radius: 50%;
  font-size: 18rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 3. 搜索框 */
.search-bar {
  padding: 0 24rpx 16rpx 24rpx;
}

.search-input-box {
  background-color: #f7f8fa;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #999;
}

.search-placeholder {
  font-size: 26rpx;
  color: #bbb;
}

/* 4. 期限和报价商 */
.term-trader-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.term-selector {
  display: flex;
  gap: 16rpx;
}

.term-item {
  width: 80rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  background-color: #fff;
}

.term-item.active {
  background-color: #eaf4fe;
  color: #409eff;
  border-color: #eaf4fe;
}

.trader-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.arrow-down {
  font-size: 20rpx;
  color: #999;
}

/* 5. 数据表格 */
.data-table {
  width: 100%;
}

.table-header {
  display: flex;
  padding: 16rpx 24rpx;
  background-color: #fcfcfc;
  border-bottom: 1rpx solid #f0f0f0;
}

.th {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center; /* 默认居中 */
}

.th.col-name {
  justify-content: flex-start; /* 第一列左对齐 */
}

.sort-icon {
  font-size: 18rpx;
  margin-left: 4rpx;
}

/* 列宽定义 */
.col-check { width: 10%; }
.col-name { width: 22%; }
.col-change { width: 20%; }
.col-val { width: 16%; }

.table-body {
  /* min-height: 400rpx; */
}

/* 复选框样式 */
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  box-sizing: border-box;
}

.checkbox.checked {
  background-color: #409eff;
  border-color: #409eff;
  position: relative;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  width: 18rpx;
  height: 10rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg);
}

.table-row {
  display: flex;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #f8f8f8;
  align-items: center;
}

.td {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.td.col-name {
  flex-direction: column;
  align-items: flex-start; /* 左对齐 */
  justify-content: center;
}

.stock-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
  font-weight: 500;
}

.stock-code {
  font-size: 22rpx;
  color: #409eff;
}

.td.col-change {
  font-weight: 500;
}

.td.col-change.up { color: #f56c6c; }
.td.col-change.down { color: #67c23a; }

.td.col-val {
  color: #409eff;
}

/* 6. 底部按钮 */
.bottom-btns {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 24rpx;
}

.btn-outline {
  width: 300rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.btn-outline.blue {
  border: 1rpx solid #409eff;
  color: #409eff;
  background-color: #fff;
}

.btn-outline.gray {
  border: 1rpx solid #ccc;
  color: #999;
  background-color: #fff;
}

.plus {
  font-size: 36rpx;
  margin-right: 8rpx;
  line-height: 1;
}