/* pages/workspace/workspace.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 用户信息头部 */
.user-header {
  background: linear-gradient(135deg, #4298EF 0%, #6BB6FF 100%);
  color: #fff;
  padding: 40rpx 30rpx 60rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.user-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.vip-badge {
  background-color: #FFD700;
  color: #333;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.account-id {
  font-size: 26rpx;
  opacity: 0.8;
}

.refresh-btn {
  padding: 16rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
}

.refresh-icon {
  width: 32rpx;
  height: 32rpx;
}

.refresh-btn.rotating .refresh-icon {
  animation: rotate 1.5s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 通用样式 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.view-all {
  font-size: 26rpx;
  color: #4298EF;
}

/* 资产概览 */
.asset-overview {
  margin: -30rpx 30rpx 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.asset-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx 40rpx;
  margin-bottom: 40rpx;
}

.asset-item {
  text-align: center;
}

.asset-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.asset-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.asset-value.main {
  font-size: 36rpx;
  color: #4298EF;
}

.asset-value.profit {
  color: #03B615;
}

.asset-value.loss {
  color: #FF4444;
}

.total-pnl {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.pnl-label {
  font-size: 28rpx;
  color: #666;
}

.pnl-value {
  font-size: 32rpx;
  font-weight: 600;
}

.pnl-value.profit {
  color: #03B615;
}

.pnl-value.loss {
  color: #FF4444;
}

.pnl-percent {
  font-size: 26rpx;
  margin-left: 8rpx;
}

/* 持仓概览 */
.position-overview {
  margin: 0 30rpx 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.position-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 36rpx;
  font-weight: 600;
  color: #4298EF;
  margin-bottom: 8rpx;
}

.stat-number.warning {
  color: #FF8C00;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* 市场行情 */
.market-overview {
  margin: 0 30rpx 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.main-index {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.index-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.index-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.index-code {
  font-size: 24rpx;
  color: #666;
}

.index-price {
  text-align: right;
}

.price {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.change {
  font-size: 24rpx;
}

.change.profit {
  color: #03B615;
}

.change.loss {
  color: #FF4444;
}

.index-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.index-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.index-item .name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.index-item .price {
  font-size: 28rpx;
  color: #333;
  margin-right: 40rpx;
}

.index-item .change {
  font-size: 26rpx;
  min-width: 80rpx;
  text-align: right;
}

/* 快捷操作 */
.quick-actions {
  margin: 0 30rpx 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background-color: #f8f9fa;
  transition: all 0.3s ease;
}

.action-item:active {
  background-color: #e9ecef;
  transform: scale(0.95);
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
}

.action-name {
  font-size: 26rpx;
  color: #333;
  text-align: center;
}

/* 最近交易 */
.recent-transactions {
  margin: 0 30rpx 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.transaction-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.transaction-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.transaction-left {
  flex: 1;
}

.transaction-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.transaction-detail {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.transaction-time {
  font-size: 22rpx;
  color: #999;
}

.transaction-right {
  text-align: right;
}

.transaction-scale {
  font-size: 28rpx;
  color: #4298EF;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.transaction-price {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.transaction-status {
  font-size: 22rpx;
  color: #03B615;
}

/* 风险提示 */
.risk-notice {
  margin: 0 30rpx;
  background-color: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.warning-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.risk-text {
  font-size: 24rpx;
  color: #d48806;
  line-height: 1.5;
}