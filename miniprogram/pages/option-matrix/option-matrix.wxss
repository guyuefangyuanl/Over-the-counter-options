/* pages/option-matrix/option-matrix.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.header {
  background-color: #fff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.refresh-btn {
  padding: 12rpx;
  border-radius: 50%;
  background-color: #f8f9fa;
}

.refresh-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 标的选择器 */
.underlying-selector {
  background-color: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.underlying-tabs {
  white-space: nowrap;
  padding: 0 30rpx;
}

.tab-item {
  display: inline-block;
  margin-right: 40rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background-color: #f8f9fa;
  text-align: center;
  min-width: 120rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background-color: #4298EF;
  color: #fff;
}

.tab-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.tab-price {
  font-size: 22rpx;
  opacity: 0.8;
}

/* 期权矩阵 */
.matrix-container {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.matrix-scroll {
  width: 100%;
  height: 600rpx;
}

.matrix-table {
  min-width: 900rpx;
}

/* 表头 */
.matrix-header {
  display: flex;
  background-color: #f8f9fa;
  border-bottom: 2rpx solid #e9ecef;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-cell {
  padding: 20rpx 16rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  border-right: 1rpx solid #e9ecef;
}

.header-cell.corner {
  width: 160rpx;
  background-color: #e9ecef;
}

.header-cell.period {
  width: 120rpx;
  min-width: 120rpx;
}

/* 表格主体 */
.matrix-body {
  display: flex;
  flex-direction: column;
}

.matrix-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.matrix-row:last-child {
  border-bottom: none;
}

/* 执行价类型列 */
.strike-cell {
  width: 160rpx;
  padding: 20rpx 16rpx;
  background-color: #f8f9fa;
  border-right: 1rpx solid #e9ecef;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
}

.strike-type {
  font-size: 26rpx;
  font-weight: 600;
  color: #4298EF;
}

.strike-desc {
  font-size: 20rpx;
  color: #666;
}

/* 报价单元格 */
.matrix-cell {
  width: 120rpx;
  min-width: 120rpx;
  padding: 20rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.matrix-cell.active {
  background-color: #fff;
  cursor: pointer;
}

.matrix-cell.active:hover {
  background-color: #f0f8ff;
}

.matrix-cell.disabled {
  background-color: #f8f9fa;
  color: #ccc;
}

.matrix-cell.selected {
  background-color: #e6f4ff;
  border: 2rpx solid #4298EF;
}

.cell-price {
  font-size: 24rpx;
  font-weight: 600;
}

.matrix-cell.active .cell-price {
  color: #333;
}

.matrix-cell.disabled .cell-price {
  color: #ccc;
}

.matrix-cell.selected .cell-price {
  color: #4298EF;
}

/* 图例 */
.matrix-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 30rpx;
  background-color: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
}

.legend-color.available {
  background-color: #4298EF;
}

.legend-color.unavailable {
  background-color: #ccc;
}

.legend-color.selected {
  background-color: #e6f4ff;
  border: 2rpx solid #4298EF;
}

.legend-text {
  font-size: 24rpx;
  color: #666;
}

/* 报价详情弹窗 */
.quote-detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.quote-detail-mask.show {
  opacity: 1;
  visibility: visible;
}

.quote-detail-popup {
  background-color: #fff;
  border-radius: 16rpx;
  width: 640rpx;
  max-width: 90vw;
  max-height: 80vh;
  overflow: hidden;
  transform: translateY(50rpx);
  transition: transform 0.3s ease;
}

.quote-detail-mask.show .quote-detail-popup {
  transform: translateY(0);
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #666;
  background-color: #f8f9fa;
  border-radius: 50%;
}

.popup-content {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.detail-section {
  margin-bottom: 40rpx;
}

.detail-section:last-child {
  margin-bottom: 0;
}

.detail-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #4298EF;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-item .label {
  font-size: 26rpx;
  color: #666;
}

.detail-item .value {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

.detail-item .value.highlight {
  color: #4298EF;
  font-size: 28rpx;
}

/* 希腊字母网格 */
.greeks-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.greek-item {
  text-align: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
}

.greek-name {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.greek-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

/* 弹窗操作按钮 */
.popup-actions {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.action-btn.secondary {
  background-color: #f8f9fa;
  color: #666;
}

.action-btn.primary {
  background-color: #4298EF;
  color: #fff;
}

/* 底部提示 */
.bottom-tips {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 30rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}