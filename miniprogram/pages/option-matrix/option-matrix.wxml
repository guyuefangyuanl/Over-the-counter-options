<!--pages/option-matrix/option-matrix.wxml-->
<view class="container">
  <!-- 页面头部 -->
  <view class="header">
    <view class="title">期权结构/期限</view>
    <view class="refresh-btn" bindtap="refreshQuotes">
      <image src="/images/refresh.png" class="refresh-icon"></image>
    </view>
  </view>

  <!-- 标的选择 -->
  <view class="underlying-selector">
    <scroll-view class="underlying-tabs" scroll-x="true">
      <view class="tab-item {{selectedUnderlying === item.code ? 'active' : ''}}"
            wx:for="{{underlyingOptions}}" 
            wx:key="code"
            data-underlying="{{item}}"
            bindtap="switchUnderlying">
        <view class="tab-name">{{item.name}}</view>
        <view class="tab-price">{{item.price}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 期权矩阵表格 -->
  <view class="matrix-container">
    <scroll-view class="matrix-scroll" scroll-x="true" scroll-y="true">
      <view class="matrix-table">
        <!-- 表头 -->
        <view class="matrix-header">
          <view class="header-cell corner">结构/期限</view>
          <view class="header-cell period" wx:for="{{maturityPeriods}}" wx:key="*this">
            {{item}}
          </view>
        </view>
        
        <!-- 表格内容 -->
        <view class="matrix-body">
          <view class="matrix-row" wx:for="{{strikeTypes}}" wx:key="*this" wx:for-item="strikeType">
            <!-- 执行价类型列 -->
            <view class="strike-cell">
              <view class="strike-type">{{strikeType}}</view>
              <view class="strike-desc">{{getStrikeTypeDesc(strikeType)}}</view>
            </view>
            
            <!-- 报价数据列 -->
            <view class="{{getCellClass(strikeType, period, optionMatrix[strikeType][period])}}"
                  wx:for="{{maturityPeriods}}" 
                  wx:key="*this"
                  wx:for-item="period"
                  data-strike="{{strikeType}}"
                  data-period="{{period}}"
                  bindtap="onCellTap">
              <text class="cell-price">{{optionMatrix[strikeType][period]}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 表格说明 -->
  <view class="matrix-legend">
    <view class="legend-item">
      <view class="legend-color available"></view>
      <text class="legend-text">有报价</text>
    </view>
    <view class="legend-item">
      <view class="legend-color unavailable"></view>
      <text class="legend-text">暂无报价</text>
    </view>
    <view class="legend-item">
      <view class="legend-color selected"></view>
      <text class="legend-text">已选中</text>
    </view>
  </view>

  <!-- 报价详情弹窗 -->
  <view class="quote-detail-mask {{showQuoteDetail ? 'show' : ''}}" bindtap="closeQuoteDetail">
    <view class="quote-detail-popup" catchtap="">
      <view class="popup-header">
        <view class="popup-title">报价详情</view>
        <view class="close-btn" bindtap="closeQuoteDetail">×</view>
      </view>
      
      <view class="popup-content" wx:if="{{quoteDetail}}">
        <!-- 基本信息 -->
        <view class="detail-section">
          <view class="detail-title">基本信息</view>
          <view class="detail-list">
            <view class="detail-item">
              <text class="label">标的资产：</text>
              <text class="value">{{quoteDetail.underlying}}</text>
            </view>
            <view class="detail-item">
              <text class="label">现价：</text>
              <text class="value">{{quoteDetail.currentPrice}}</text>
            </view>
            <view class="detail-item">
              <text class="label">期权类型：</text>
              <text class="value">{{getStrikeTypeDesc(quoteDetail.strikeType)}}</text>
            </view>
            <view class="detail-item">
              <text class="label">期限：</text>
              <text class="value">{{quoteDetail.period}}</text>
            </view>
            <view class="detail-item">
              <text class="label">执行价：</text>
              <text class="value">{{quoteDetail.strikePrice}}</text>
            </view>
          </view>
        </view>
        
        <!-- 定价信息 -->
        <view class="detail-section">
          <view class="detail-title">定价信息</view>
          <view class="detail-list">
            <view class="detail-item">
              <text class="label">期权价格：</text>
              <text class="value highlight">{{quoteDetail.optionPrice}}</text>
            </view>
            <view class="detail-item">
              <text class="label">隐含波动率：</text>
              <text class="value">{{quoteDetail.impliedVolatility}}</text>
            </view>
          </view>
        </view>
        
        <!-- 希腊字母 -->
        <view class="detail-section" wx:if="{{quoteDetail.greeks}}">
          <view class="detail-title">风险指标（希腊字母）</view>
          <view class="greeks-grid">
            <view class="greek-item">
              <view class="greek-name">Delta</view>
              <view class="greek-value">{{quoteDetail.greeks.delta}}</view>
            </view>
            <view class="greek-item">
              <view class="greek-name">Gamma</view>
              <view class="greek-value">{{quoteDetail.greeks.gamma}}</view>
            </view>
            <view class="greek-item">
              <view class="greek-name">Theta</view>
              <view class="greek-value">{{quoteDetail.greeks.theta}}</view>
            </view>
            <view class="greek-item">
              <view class="greek-name">Vega</view>
              <view class="greek-value">{{quoteDetail.greeks.vega}}</view>
            </view>
            <view class="greek-item">
              <view class="greek-name">Rho</view>
              <view class="greek-value">{{quoteDetail.greeks.rho}}</view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 操作按钮 -->
      <view class="popup-actions">
        <button class="action-btn secondary" bindtap="closeQuoteDetail">取消</button>
        <button class="action-btn primary" bindtap="inquirePrice">询价</button>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="bottom-tips">
    <view class="tip-item">
      <image src="/images/info.png" class="tip-icon"></image>
      <text class="tip-text">点击单元格查看详细报价信息</text>
    </view>
    <view class="tip-item">
      <image src="/images/warning.png" class="tip-icon"></image>
      <text class="tip-text">报价仅供参考，实际成交价格以询价结果为准</text>
    </view>
  </view>
</view>