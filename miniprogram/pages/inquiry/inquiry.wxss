/* 金融卡片式列表 - 优化卡片布局和可读性 */
.cards-wrapper {
  flex: 1;
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
  padding-bottom: 96rpx;
}

.cards-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8rpx;
  padding: 8rpx;
}

.stock-item {
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border: 1rpx solid #E5E6EB;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  padding: 12rpx;
  min-height: 140rpx;
  animation: slideUp 0.3s ease-out both;
  will-change: transform, opacity;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.item-hover {
  transform: scale(0.98);
  opacity: 0.9;
}

@keyframes slideUp {
  from { transform: translateY(20rpx); opacity: 0; }
  to   { transform: translateY(0);      opacity: 1; }
}

.cards-grid .stock-item:nth-child(1)  { animation-delay: 0.03s; }
.cards-grid .stock-item:nth-child(2)  { animation-delay: 0.06s; }
.cards-grid .stock-item:nth-child(3)  { animation-delay: 0.09s; }
.cards-grid .stock-item:nth-child(4)  { animation-delay: 0.12s; }
.cards-grid .stock-item:nth-child(5)  { animation-delay: 0.15s; }
.cards-grid .stock-item:nth-child(6)  { animation-delay: 0.18s; }
.cards-grid .stock-item:nth-child(7)  { animation-delay: 0.21s; }
.cards-grid .stock-item:nth-child(8)  { animation-delay: 0.24s; }
.cards-grid .stock-item:nth-child(9)  { animation-delay: 0.27s; }
.cards-grid .stock-item:nth-child(10) { animation-delay: 0.30s; }

.card-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
  padding-bottom: 6rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.stock-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  line-height: 1.3;
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-code {
  font-size: 24rpx;
  color: #86909C;
  line-height: 1.2;
  font-weight: 500;
}

.card-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.metric {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  background: #F7F8FA;
  border: 1rpx solid #E5E6EB;
  border-radius: 8rpx;
  padding: 8rpx 6rpx;
  min-height: 52rpx;
  justify-content: space-between;
}

.metric .label {
  font-size: 22rpx;
  color: #86909C;
  line-height: 1.2;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.metric .value {
  font-size: 26rpx;
  color: #1D2129;
  text-align: right;
  line-height: 1.2;
  font-weight: 600;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.card-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  padding-top: 2rpx;
}

.fav-icon {
  color: #C0C4CC;
  font-size: 36rpx;
  transition: transform 0.2s ease;
}

.fav-icon:active {
  transform: scale(0.92);
}

.fav-icon.is-fav {
  color: #FFD54F;
}

.fav-icon.is-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.stock-item.is-selected {
  border-color: #2D8CF0;
  box-shadow: 0 8rpx 20rpx rgba(45, 140, 240, 0.18), 0 0 0 3rpx rgba(45, 140, 240, 0.28);
  transform: scale(1.02);
}

/* 响应式适配 - 优化不同屏幕尺寸下的布局 */
@media (max-width: 375px) {
  .cards-grid { 
    grid-template-columns: repeat(1, 1fr); 
    gap: 20rpx;
    padding: 20rpx;
  }
  .metric .value { 
    font-size: 24rpx; 
  }
  .metric .label {
    font-size: 20rpx;
  }
  .stock-name {
    font-size: 28rpx;
  }
  .stock-code {
    font-size: 22rpx;
  }
  .card-metrics {
    grid-template-columns: repeat(2, 1fr);
    gap: 10rpx;
  }
}

@media (min-width: 768px) {
  .cards-grid { 
    grid-template-columns: 1fr;
    gap: 24rpx;
  }
}
@media (min-width: 1024px) {
  .cards-grid { 
    grid-template-columns: 1fr; 
    gap: 24rpx;
  }
}

