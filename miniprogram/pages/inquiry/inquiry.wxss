/* 优化表格滚动性能 */
.quotes-table-wrapper {
  -webkit-overflow-scrolling: touch;
  scroll-behavior: smooth;
}
.cards-wrapper { /* 移除高度限制，允许内容区占满剩余空间 */ }

/* 优化按钮点击区域 */
.td-action {
  min-height: 80rpx;
}

/* 确保最后一行不被遮挡 */
.quotes-table-wrapper {
  padding-bottom: 20rpx;
}

/* 优化空状态显示 */
.empty-state {
  padding: 80rpx 0;
}


/* 超小屏幕特殊适配 */
