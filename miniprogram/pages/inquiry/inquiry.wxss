/* pages/inquiry/inquiry.wxss */
@viewport { width: device-width; viewport-fit: cover; }

.container {
  display:           flex;
  flex-direction:    column;
  height:            100vh;
  background-color:  #F7F8FA;
  
  /* 严格遵循设计稿配色规范 */
  --primary-color:   #2D8CF0;    /* 主色调 */
  --secondary-color: #19BE6B;    /* 辅助色 */
  --warning-color:   #FF9900;    /* 警告色 */
  --white:           #ffffff;
  --background-color:#f7f8fa;
  --text-primary:    #303133;
  --text-secondary:  #909399;
  --border-color:    #e5e5e5;
  --rise-color:      #F56C6C;    /* 上涨红 */
  --fall-color:      #67C23A;    /* 下跌绿 */
}

/* 顶部固定区域 */
.top-fixed-section {
  position:         sticky;
  top:              0;
  z-index:          10;
  background-color: var(--white);
  box-shadow:       0 2rpx 4rpx rgba(0, 0, 0, 0.06);
  padding-top:      0;
}

/* 1. 市场指数 - 优化字体大小和间距 */
.market-indexes {
  padding:        12rpx 24rpx 8rpx;
  background-color: var(--white);
  border-bottom:    1rpx solid var(--border-color);
  white-space:      nowrap;
  position:         relative;
  display:          flex;
  align-items:      center;
}

.market-index-item {
  display:      inline-block;
  margin-right: 40rpx;
  text-align:   center;
}

.market-index-item:last-child {
  margin-right: 0;
}

.market-index-name {
  font-size:   24rpx;
  color:       var(--text-secondary);
  font-weight: 500;
  margin-bottom: 6rpx;
  line-height: 1.3;
}

.market-index-value {
  font-size:   28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  line-height: 1.2;
}

.market-index-change {
  font-size:   22rpx;
  font-weight: 500;
  line-height: 1.2;
}

.current-time {
  position:      absolute;
  right:         32rpx;
  top:           50%;
  transform:     translateY(-50%);
  font-size:     24rpx;
  color:         var(--text-secondary);
  font-weight:   500;
  background:    rgba(245, 247, 250, 0.9);
  padding:       10rpx 18rpx;
  border-radius: 18rpx;
  line-height:   1.2;
}

/* 2. Tab导航容器 */
.tabs-container {
  background-color: var(--white);
  border-bottom:    1rpx solid var(--border-color);
}

.tabs-header-row {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}

.search-entry-btn {
  width: 70rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  margin-left: 10rpx;
}

/* 主Tab - 增强可读性和对比度 */
.primary-tabs {
  display:      flex;
  align-items:  center;
  padding:      0 16rpx;
  height:       56rpx;
  background:   linear-gradient(to bottom, var(--white), #fafbfc);
}

.primary-tab-item {
  position:   relative;
  flex:       1;
  text-align: center;
  font-size:  26rpx;
  color:      #606266;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding:    6rpx 0;
  font-weight: 500;
  line-height: 1.3;
}

.primary-tab-item.is-active {
  color:       var(--primary-color);
  font-weight: 600;
}

.primary-tab-item.is-active::after {
  content:          '';
  position:         absolute;
  left:             50%;
  bottom:           8rpx;
  transform:        translateX(-50%);
  width:            40rpx;
  height:           4rpx;
  background-color: var(--primary-color);
  border-radius:    2rpx;
  transition:       all 0.3s ease;
}

/* 子Tab - 优化字体和间距 */
.sub-tabs {
  display:      flex;
  align-items:  center;
  padding:      0 16rpx 6rpx;
  background:   linear-gradient(to bottom, #fafbfc, var(--white));
}

.sub-tabs-scroll {
  flex:        1;
  white-space: nowrap;
}

.sub-tab-item {
  display:        inline-block;
  padding:        6rpx 16rpx;
  margin-right:   10rpx;
  font-size:      24rpx;
  color:          #606266;
  background-color: #f5f7fa;
  border-radius:  16rpx;
  transition:     all 0.2s ease;
  line-height:    1.3;
  font-weight:    500;
}

.sub-tab-item.is-active {
  color:            var(--white);
  background-color: var(--primary-color);
  font-weight:      600;
}

.edit-group-btn {
  margin-left:    16rpx;
  padding:        8rpx;
  border-radius:  8rpx;
  background-color: #f5f7fa;
}

.edit-icon {
  width:  32rpx;
  height: 32rpx;
}

/* 添加自选和编辑自选按钮 - 优化按钮大小和间距 */
.favorites-action-buttons {
  display:   flex;
  flex-direction: column;
  align-items: stretch;
  padding:   0 24rpx 12rpx;
  gap:       18rpx;
}

.action-row {
  display: flex;
  gap: 18rpx;
}

.favorites-btn {
  display:         flex;
  flex:            1;
  align-items:     center;
  justify-content: center;
  padding:         14rpx 28rpx;
  border-radius:   26rpx;
  font-size:       28rpx;
  font-weight:     500;
  transition:      all 0.2s ease;
  line-height:     1.3;
}

.add-favorites-btn {
  background-color: var(--primary-color);
  color:            var(--white);
}

.add-favorites-btn:active {
  background-color: #1b6fcc;
}

.edit-favorites-btn {
  background-color: #f5f7fa;
  color:            var(--text-primary);
  border:           1rpx solid var(--border-color);
}

.edit-favorites-btn:active {
  background-color: #e9ecef;
}

.btn-icon {
  font-size:   28rpx;
  margin-right: 8rpx;
  font-weight: bold;
}

.btn-text {
  font-size: 26rpx;
}

/* 3. 搜索与筛选 - 优化间距和布局 */
.filters-section {
  padding:     16rpx 24rpx;
  background-color: var(--white);
  display:     flex;
  align-items: center;
  flex-wrap:   wrap;
  gap:         16rpx;
}

.search-bar {
  position:   relative;
  flex:       1;
  min-width:  300rpx;
}

.search-input {
  width:         100%;
  height:        64rpx;
  padding:       0 76rpx 0 60rpx;
  font-size:     28rpx;
  background-color: #f5f7fa;
  border-radius: 32rpx;
  border:        none;
  outline:       none;
  line-height:   1.3;
}

.search-input::placeholder {
  color: #909399;
  font-size: 28rpx;
}

.search-icon {
  position:   absolute;
  left:       24rpx;
  top:        50%;
  transform:  translateY(-50%);
  width:      32rpx;
  height:     32rpx;
  opacity:    0.6;
}

.clear-icon {
  position:   absolute;
  right:      24rpx;
  top:        50%;
  transform:  translateY(-50%);
  width:      32rpx;
  height:     32rpx;
  padding:    8rpx;
  opacity:    0.6;
}

.search-trigger-btn {
  position:      absolute;
  right:         68rpx;
  top:           50%;
  transform:     translateY(-50%);
  padding:       8rpx 18rpx;
  background-color: var(--primary-color);
  color:         #fff;
  border-radius: 18rpx;
  font-size:     24rpx;
  line-height:   1.2;
  font-weight:   500;
}

.filter-tabs-group {
  display:   flex;
  align-items: center;
  gap:       16rpx;
}

.filter-label {
  font-size:    26rpx;
  color:        #606266;
  white-space:  nowrap;
  margin-right: 10rpx;
  font-weight:  500;
  line-height:  1.3;
}

.term-tabs,
.structure-tabs {
  display: flex;
  gap:       6rpx;
}

.term-tab,
.structure-tab {
  padding:       8rpx 18rpx;
  font-size:     24rpx;
  color:         #606266;
  background-color: #f5f7fa;
  border-radius: 16rpx;
  transition:    all 0.2s ease;
  line-height:   1.3;
  font-weight:   500;
}

.term-tab.is-active,
.structure-tab.is-active {
  color:            var(--white);
  background-color: var(--primary-color);
  font-weight:      600;
}

.data-explain-trigger {
  display:      flex;
  align-items:  center;
  gap:          8rpx;
  margin-left:  auto;
  padding:      8rpx 16rpx;
  font-size:    24rpx;
  color:        #606266;
  background-color: #f5f7fa;
  border-radius: 16rpx;
  line-height:  1.3;
  font-weight:  500;
}

.icon-small {
  width:  24rpx;
  height: 24rpx;
  opacity: 0.6;
}

/* 4. 报价表格 */
.quotes-table-wrapper {
  flex:             1;
  background-color: var(--white);
  margin-bottom:    140rpx; /* 为底部操作栏预留更大空间 */
}

.quotes-table {
  min-width: 600rpx;
}

.table-header {
  display:          flex;
  background-color: #fafafa;
  border-bottom:    1rpx solid var(--border-color);
  position:         sticky;
  top:              0;
  z-index:          5;
}

.th {
  padding:     20rpx 24rpx;
  font-size:   24rpx;
  color:       var(--text-secondary);
  font-weight: 600;
  text-align:  center;
  white-space: nowrap;
}

.th-name {
  flex:      1;
  text-align: left;
}

.th-change,
.th-rate {
  width: 100rpx;
}

/* 询价按钮列 */
.th-action {
  width: 140rpx;
}

.td-action {
  padding:     12rpx 20rpx;
  display:     flex;
  align-items: center;
  justify-content: center;
  gap:         12rpx;
}

.fav-icon {
  color:     #c0c4cc;
  font-size: 32rpx;
  transition: all 0.2s ease;
}

.fav-icon:active {
  transform: scale(0.9);
}

.fav-icon.is-fav {
  color: var(--warning-color);
}

.table-row {
  display:      flex;
  align-items:  center;
  border-bottom: 1rpx solid #f0f0f0;
  position:     relative;
  overflow:     hidden;
  will-change:  transform, box-shadow, background-color, border-color;
  transition:   background-color 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.42s cubic-bezier(0.22, 1, 0.36, 1);
}

.table-row.row-hover {
  background-color: #f5f7fa;
}

.table-row.is-selected {
  background-color: #e6f3ff;
  border-color:     var(--primary-color);
  box-shadow:       0 8rpx 20rpx rgba(45, 140, 240, 0.24), 0 0 0 3rpx rgba(45, 140, 240, 0.35);
  transform:        scale(1.02);
  animation:        select-pulse 480ms ease-out both;
}

.table-row.is-selected::after {
  content:          '';
  position:         absolute;
  left:             50%;
  top:              50%;
  width:            140rpx;
  height:           140rpx;
  border-radius:    50%;
  background:       rgba(45, 140, 240, 0.22);
  transform:        translate(-50%, -50%) scale(0.2);
  pointer-events:   none;
  z-index:          0;
  animation:        select-ripple 500ms ease-out both;
}

.td {
  padding:     24rpx 20rpx;
  font-size:   26rpx;
  color:       var(--text-primary);
  text-align:  center;
}

@keyframes select-pulse {
  0%  { transform: scale(1); box-shadow: 0 0 0 rgba(0,0,0,0); }
  40% { transform: scale(1.03); box-shadow: 0 10rpx 24rpx rgba(45, 140, 240, 0.30), 0 0 0 4rpx rgba(45, 140, 240, 0.40); }
  100%{ transform: scale(1.02); box-shadow: 0 8rpx 20rpx rgba(45, 140, 240, 0.24), 0 0 0 3rpx rgba(45, 140, 240, 0.35); }
}

@keyframes select-ripple {
  0%  { opacity: 0.35; transform: translate(-50%, -50%) scale(0.2); }
  70% { opacity: 0.18; transform: translate(-50%, -50%) scale(1); }
  100%{ opacity: 0; transform: translate(-50%, -50%) scale(1.4); }
}

@media (max-width: 320px) {
  .table-row.is-selected { transform: scale(1.015); }
}

.td-name {
  flex:           1;
  text-align:     left;
  display:        flex;
  flex-direction: column;
  gap:            8rpx;
}

.stock-name {
  font-size:   28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.stock-code {
  font-size: 22rpx;
  color:     var(--text-secondary);
  line-height: 1.2;
}

.td-change {
  font-weight: 600;
}

.td-change.is-rise {
  color: var(--rise-color);
}

.td-change.is-fall {
  color: var(--fall-color);
}

.td-rate {
  font-weight: 500;
}

/* 空状态 - 优化显示效果 */
.empty-state {
  display:         flex;
  flex-direction:  column;
  align-items:     center;
  justify-content: center;
  padding:         100rpx 32rpx;
}

.empty-icon {
  width:        160rpx;
  height:       160rpx;
  margin-bottom: 32rpx;
  opacity:      0.5;
}

.empty-text {
  font-size: 30rpx;
  color:     #909399;
  line-height: 1.4;
  font-weight: 500;
}

/* 底部操作栏 - 优化按钮显示 */
.bottom-actions {
  position:         fixed;
  left:             0;
  right:            0;
  bottom:           0;
  display:          flex;
  align-items:      center;
  justify-content:  space-between;
  padding:          10rpx 16rpx;
  background-color: var(--white);
  border-top:       1rpx solid var(--border-color);
  box-shadow:       0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
  z-index:          100;
  gap:              12rpx;
  padding-bottom:   10rpx;
}

.bottom-actions van-button {
  flex: 1;
  min-height: 72rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.bottom-actions van-button:last-child {
  margin-left: 0;
}

/* 快捷入口 */
.quick-actions {
  position:      fixed;
  right:         24rpx;
  bottom:        160rpx;
  display:       flex;
  flex-direction: column;
  gap:           12rpx;
  z-index:       80;
  touch-action:  none;
  user-select:   none;
  transition:    none;
  will-change:   transform;
}

.quick-actions.dragging {}

.quick-actions.dragging .quick-action-item {}

.drag-hint {
  position:      absolute;
  top:           -40rpx;
  left:          50%;
  transform:     translateX(-50%);
  background:    rgba(0, 0, 0, 0.7);
  color:         white;
  font-size:     22rpx;
  padding:       8rpx 16rpx;
  border-radius: 16rpx;
  white-space:   nowrap;
  z-index:       100;
}

.quick-action-item {
  display:            flex;
  flex-direction:     column;
  align-items:        center;
  justify-content:    center;
  width:              86rpx;
  height:             86rpx;
  background:         linear-gradient(135deg, var(--primary-color), #1a7fd8);
  border-radius:      43rpx;
  box-shadow:         0 3rpx 12rpx rgba(45, 140, 240, 0.2);
  transition:         all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  opacity:            0.95;
}

.quick-action-item:active {
  transform: scale(0.95);
}

.quick-action-icon {
  width:         38rpx;
  height:        38rpx;
  margin-bottom: 3rpx;
  filter:        brightness(0) invert(1); /* 让图标变成白色 */
}

.quick-action-text {
  font-size:   15rpx;
  color:       var(--white);
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

/* 数据说明弹窗 - 优化文字显示 */
.data-info-popup {
  background:    var(--white);
  border-radius: 16rpx;
  overflow:      hidden;
}

.data-info-header {
  display:         flex;
  align-items:     center;
  justify-content: space-between;
  padding:         32rpx 32rpx 24rpx;
  border-bottom:   1rpx solid var(--border-color);
}

.data-info-title {
  font-size:   34rpx;
  font-weight: 600;
  color:       var(--text-primary);
  line-height: 1.3;
}

.data-info-content {
  max-height: 400rpx;
  padding:      32rpx;
}

.data-info-text {
  font-size: 30rpx;
  color:     #606266;
  line-height: 1.8;
  font-weight: 400;
}

.data-info-footer {
  padding:      24rpx 32rpx 32rpx;
  border-top:   1rpx solid var(--border-color);
}

/* 分组管理弹层 - 优化文字和间距 */
.group-manage-sheet {
  height:       100%;
  display:      flex;
  flex-direction: column;
  padding:      24rpx 32rpx 32rpx;
  will-change:  transform, opacity;
}

.sheet-title {
  font-size:   34rpx;
  font-weight: 600;
  color:       var(--text-primary);
  line-height: 1.3;
}

.sheet-subtitle {
  margin-top: 24rpx;
  font-size:  28rpx;
  color:      #606266;
  font-weight: 500;
  line-height: 1.4;
}

.group-list {
  flex:        1;
  overflow-y:  auto;
  margin-top: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.group-item {
  position:         relative;
  display:          flex;
  align-items:      center;
  justify-content:  space-between;
  padding:          28rpx 0;
  border-bottom:    1rpx solid #f0f0f0;
  font-size:        32rpx;
  color:            var(--text-primary);
  transition:       background-color 0.2s ease;
  line-height:      1.3;
}

.group-item:last-child {
  border-bottom: none;
}

.group-item:active {
  background-color: #f5f7fa;
}

.group-item.active {
  background-color: #f0f7ff;
  color:            var(--primary-color);
  font-weight:      500;
}

.group-item.active .van-icon {
  color: var(--primary-color);
}

.sheet-actions {
  display:   flex;
  align-items: center;
  justify-content: space-between;
  gap:       16rpx;
  margin-top: 32rpx;
  padding-top: 10rpx;
}

.sheet-actions .spacer {
  flex: 0;
}

/* 新建分组弹窗 - 优化文字显示 */
.new-group-dialog {
  width:        600rpx;
  background:   var(--white);
  border-radius: 16rpx;
  padding:      28rpx 32rpx 32rpx;
  transform:    scale(1);
  transition:   transform 0.22s ease-out;
}

.dialog-title {
  font-size:    34rpx;
  font-weight:  600;
  margin-bottom: 20rpx;
  line-height:  1.3;
}

.input-error {
  color:       #F56C6C;
  font-size:   26rpx;
  margin-top:  10rpx;
  line-height: 1.4;
}

.dialog-actions {
  display:         flex;
  justify-content: flex-end;
  gap:             20rpx;
  margin-top:      28rpx;
}

.delete-dialog-actions {
  justify-content: space-between;
}

/* 编辑模式样式 */
.edit-mode {
  position:      relative;
  padding-right: 120rpx;
}

.edit-mode-disabled {
  opacity: 0.6;
}

.edit-actions {
  position:   absolute;
  right:      20rpx;
  top:        50%;
  transform:  translateY(-50%);
  display:    flex;
  gap:        24rpx;
  align-items: center;
}

.edit-actions .van-icon {
  color:      #909399;
  transition: color 0.2s ease;
}

.edit-actions .van-icon:active {
  color:     var(--primary-color);
  transform: scale(0.95);
}

/* 删除弹窗特殊样式 */
.delete-dialog .delete-content {
  margin:     24rpx 0;
  font-size:  28rpx;
  color:      #606266;
  line-height: 1.5;
}

.delete-checkbox-row {
  display: flex;
  align-items: center;
  margin: 8rpx 0 24rpx;
}

.delete-checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.delete-checkbox.checked {
  background-color: var(--primary-color);
  border-color: var(--primary-color);
  position: relative;
}

.delete-checkbox.checked::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  width: 14rpx;
  height: 8rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg);
}

.delete-checkbox-text {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #303133;
}

.picker-view {
  display:         flex;
  align-items:     center;
  justify-content: space-between;
  padding:         16rpx 20rpx;
  background:      #f5f7fa;
  border-radius:   8rpx;
  margin:          16rpx 0;
  font-size:       28rpx;
  color:           #303133;
}

/* ==================== 询价表单样式 ==================== */
/* 底部批量操作栏 - 优化按钮显示 */
.bottom-batch-actions {
  position:         fixed;
  left:             0;
  right:            0;
  bottom:           0;
  display:          flex;
  align-items:      center;
  justify-content: space-between;
  padding:          16rpx 24rpx;
  background-color: var(--white);
  border-top:       1rpx solid var(--border-color);
  box-shadow:       0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  gap:              20rpx;
  z-index:          100;
}

.bottom-batch-actions van-button {
  flex: 1;
  min-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* 询价表单弹窗 - 优化文字和间距 */
.inquiry-form-popup {
  height:       100%;
  display:      flex;
  flex-direction: column;
  background-color: var(--white);
}

.form-header {
  display:         flex;
  align-items:     center;
  justify-content: space-between;
  padding:         32rpx 32rpx 24rpx;
  border-bottom:   1rpx solid var(--border-color);
}

.form-title {
  font-size:   34rpx;
  font-weight: 600;
  color:       var(--text-primary);
  line-height: 1.3;
}

.form-content {
  flex:   1;
  padding: 32rpx;
}

.form-section {
  margin-bottom: 52rpx;
}

.section-title {
  font-size:     30rpx;
  font-weight:   600;
  color:         var(--text-primary);
  margin-bottom: 28rpx;
  line-height:   1.3;
}

.product-info {
  background-color: #f5f7fa;
  padding:          28rpx;
  border-radius:    12rpx;
}

.product-name {
  font-size:     32rpx;
  font-weight:   600;
  color:         var(--text-primary);
  margin-bottom: 12rpx;
  line-height:   1.3;
}

.product-code {
  font-size:     26rpx;
  color:         #86909C;
  margin-bottom: 20rpx;
  line-height:   1.3;
}

.product-rate {
  font-size:   28rpx;
  color:       var(--primary-color);
  font-weight: 600;
  line-height: 1.3;
}

.form-footer {
  padding:      24rpx 32rpx 32rpx;
  border-top:   1rpx solid var(--border-color);
  background-color: var(--white);
}

/* 表单输入框样式 - 优化字体大小 */
.van-field {
  margin-bottom: 28rpx;
}

.van-field__label {
  font-size: 30rpx;
  color:     var(--text-primary);
  font-weight: 500;
}

.van-field__control {
  font-size: 30rpx;
  color:     var(--text-primary);
  line-height: 1.4;
}

.van-field__placeholder {
  color: #909399;
  font-size: 30rpx;
}

/* 响应式适配 */
@media (max-width: 320px) {
  .form-content {
    padding: 24rpx;
  }
  
  .form-header {
    padding: 24rpx;
  }
  
  .form-footer {
    padding: 16rpx 24rpx 24rpx;
  }
}

/* 交互动效 */
.press {
  opacity:   0.8;
  transform: scale(0.98);
  transition: all 0.1s ease;
}

/* 响应式适配 */
@media (max-width: 320px) {
  .search-bar {
    min-width: 200rpx;
  }
  
  .filter-tabs-group {
    flex-direction: column;
    align-items:    flex-start;
  }
}

/* 成功动画提示 */
.success-toast {
  position:         fixed;
  left:             0;
  right:            0;
  top:              0;
  bottom:           0;
  display:          flex;
  align-items:      center;
  justify-content: center;
  background:       rgba(0, 0, 0, 0.2);
  z-index:          9999;
}

.success-toast-inner {
  min-width:     280rpx;
  padding:       24rpx 32rpx;
  background:    #ffffff;
  color:         #19BE6B;
  border-radius: 16rpx;
  font-size:     30rpx;
  font-weight:   600;
  animation:     success-pop 0.18s ease-out, success-fade 0.8s ease-in 0.8s forwards;
  box-shadow:    0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

@keyframes success-pop {
  0%  { transform: scale(0.9); opacity: 0; }
  100%{ transform: scale(1); opacity: 1; }
}

@keyframes success-fade {
  0%  { opacity: 1; }
  100%{ opacity: 0; }
}

/* ==================== 自选按钮与星标扩展样式 ==================== */
.favorites-btn.is-disabled {
  opacity:         0.5;
  pointer-events: none;
}

.fav-icon.is-fav {
  color: #FFD54F;
}

.fav-icon.is-disabled {
  opacity:         0.4;
  pointer-events: none;
}

.fav-anim {
  animation: fav-pop 0.2s ease-out;
}

@keyframes fav-pop {
  0%  { transform: scale(0.85); }
  100%{ transform: scale(1); }
}

/* 添加自选弹窗样式 - 优化文字和布局 */
.add-favorites-popup {
  height:       100%;
  display:      flex;
  flex-direction: column;
  background-color: var(--white);
}

.popup-header {
  display:         flex;
  align-items:     center;
  justify-content: space-between;
  padding:         32rpx 32rpx 24rpx;
  border-bottom:   1rpx solid var(--border-color);
}

.popup-title {
  font-size:   34rpx;
  font-weight: 600;
  color:       var(--text-primary);
  line-height: 1.3;
}

.search-section {
  padding:      24rpx 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.category-tabs {
  display:   flex;
  padding:   24rpx 32rpx;
  border-bottom: 1rpx solid var(--border-color);
  gap:       32rpx;
}

.category-tab {
  padding:       14rpx 26rpx;
  font-size:     30rpx;
  color:         #606266;
  border-radius: 8rpx;
  transition:    all 0.2s ease;
  line-height:   1.3;
  font-weight:   500;
}

.category-tab.is-active {
  color:            var(--primary-color);
  background-color: #f0f7ff;
  font-weight:      600;
}

.category-tab:active {
  background-color: #f5f7fa;
}

.stock-list {
  flex:        1;
  padding:     0 32rpx;
  display:     flex;
  flex-wrap:   wrap;
  margin:      -20rpx;
}

.stock-item {
  display:          flex;
  align-items:      center;
  padding:          28rpx 24rpx;
  border:           1rpx solid #f0f0f0;
  border-radius:    12rpx;
  background-color: #ffffff;
  transition:       transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease;
  box-sizing:       border-box;
  margin:           20rpx;
  width:            100%;
  min-height:       150rpx;
  position:         relative;
  z-index:          1;
}

.stock-item:hover {
  z-index:          2;
  transform:        translateY(-4rpx);
  box-shadow:       0 8rpx 20rpx rgba(45, 140, 240, 0.16);
}

.stock-info {
  flex:        1;
  margin-right: 28rpx;
  min-width:   0;
}

.stock-name {
  font-size:   32rpx;
  font-weight: 600;
  color:       var(--text-primary);
  margin-bottom: 10rpx;
  line-height: 1.4;
  overflow:    hidden;
  display:     -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.stock-code {
  font-size: 24rpx;
  color:     #86909C;
  margin-bottom: 6rpx;
  line-height: 1.2;
  font-weight: 500;
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-category {
  font-size: 24rpx;
  color:     #c0c4cc;
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-price-info {
  text-align:   right;
  margin-right: 28rpx;
  min-width:    140rpx;
}

.stock-price {
  font-size:   32rpx;
  font-weight: 600;
  color:       var(--text-primary);
  margin-bottom: 10rpx;
  line-height: 1.2;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.stock-price.is-rise {
  color: var(--rise-color);
}

.stock-price.is-fall {
  color: var(--fall-color);
}

.stock-change {
  font-size:   26rpx;
  font-weight: 600;
  line-height: 1.2;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.stock-change.is-rise {
  color: var(--rise-color);
}

.stock-change.is-fall {
  color: var(--fall-color);
}

.stock-action {
  width:      100rpx;
  text-align: center;
}

@media (min-width: 480px) {
  .stock-item { width: calc(50% - 40rpx); }
}

@media (min-width: 768px) {
  .stock-item { width: calc(33.333% - 40rpx); }
}

@media (max-width: 375px) {
  .stock-item { width: calc(100% - 40rpx); }
}

.added-status {
  display:        flex;
  flex-direction: column;
  align-items:    center;
  gap:            6rpx;
}

.added-status text {
  font-size: 22rpx;
  color:     var(--secondary-color);
  line-height: 1.2;
  font-weight: 500;
}

.added-status .van-icon {
  color: var(--secondary-color);
}

.add-btn {
  width:              64rpx;
  height:             64rpx;
  border-radius:      50%;
  background-color:   var(--primary-color);
  color:              var(--white);
  display:            flex;
  align-items:        center;
  justify-content:    center;
  font-size:          34rpx;
  font-weight:        600;
  transition:         all 0.2s ease;
}

.add-btn:active {
  transform:        scale(0.9);
  background-color: #1a7fd8;
}

.popup-footer {
  padding:      24rpx 32rpx 32rpx;
  border-top: 1rpx solid var(--border-color);
  background-color: var(--white);
}

/* 响应式优化 */
@media (max-height: 800px) {
  .quick-actions {
    bottom: 300rpx;
  }
  
  .market-indexes {
    padding: 12rpx 32rpx 8rpx;
  }
  
