    padding:   20rpx 12rpx;
    font-size: 24rpx;
  }
  
  .stock-name {
    font-size: 26rpx;
  }
  
  .stock-code {
    font-size: 20rpx;
  }
  
  .quick-actions {
    right: 20rpx;
    bottom: 300rpx;
  }
  
  .quick-action-item {
    width:  80rpx;
    height: 80rpx;
  }
  
  .quick-action-icon {
    width:  36rpx;
    height: 36rpx;
  }
  
  .quick-action-text {
    font-size: 14rpx;
  }
  
  .market-index-name {
    font-size: 22rpx;
  }
  
