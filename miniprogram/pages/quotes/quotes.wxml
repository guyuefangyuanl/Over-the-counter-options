<wxs module="utils">
  module.exports.includes = function(arr, item) {
    return arr.indexOf(item) > -1;
  }
</wxs>
<view class="page-container">
  <!-- 1. 自定义导航栏 -->
  <view class="custom-navbar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-tabs">
      <view class="nav-tab {{currentTab === '自选' ? 'active' : ''}}" bindtap="onTabChange" data-tab="自选">自选</view>
      <view class="nav-tab {{currentTab === '个股' ? 'active' : ''}}" bindtap="onTabChange" data-tab="个股">个股</view>
      <view class="nav-tab {{currentTab === '指数' ? 'active' : ''}}" bindtap="onTabChange" data-tab="指数">指数</view>
      <view class="nav-tab {{currentTab === 'ETF' ? 'active' : ''}}" bindtap="onTabChange" data-tab="ETF">ETF</view>
    </view>
    <view class="nav-right-placeholder">
       <!-- 胶囊区域占位 -->
    </view>
  </view>

  <!-- 内容滚动区域 -->
  <scroll-view scroll-y class="content-scroll" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    
    <!-- 2. 次级筛选栏 -->
    <view class="sub-filter-bar">
      <view class="sub-filters" style="position: relative; left: 11rpx; top: -77rpx; flex: 1; min-width: 0; display: flex; box-sizing: border-box">
        <view class="sub-filter-item {{subFilter === '全部' ? 'active' : ''}}" bindtap="onSubFilterChange" data-filter="全部">全部</view>
        <view class="sub-filter-item {{subFilter === '持仓' ? 'active' : ''}}" bindtap="onSubFilterChange" data-filter="持仓">持仓</view>
        <view class="sub-filter-item {{subFilter === '沪深' ? 'active' : ''}}" bindtap="onSubFilterChange" data-filter="沪深">沪深</view>
        <view class="sub-filter-item {{subFilter === '指数' ? 'active' : ''}}" bindtap="onSubFilterChange" data-filter="指数">指数</view>
        <scroll-view
          class="top-groups {{topGroupAnimationClass}}"
          scroll-x
          show-scrollbar="{{false}}"
          wx:if="{{topGroups.length > 0}}"
        >
          <view class="top-groups-inner">
            <view
              class="sub-filter-item top-group-item {{activeGroupId === item.id ? 'active' : ''}}"
              wx:for="{{topGroups}}"
              wx:key="id"
              bindtap="onSwitchGroup"
              data-id="{{item.id}}"
              hover-class="top-group-item-hover"
              hover-stay-time="80"
            >
              <text class="top-group-name">{{item.name}}</text>
              <text class="top-group-count-inline">({{groupCountsById[item.id] || 0}})</text>
            </view>
          </view>
        </scroll-view>
        <view class="top-group-skeleton" wx:if="{{loadingGroups}}">
          <view class="top-group-skeleton-chip"></view>
        </view>
      </view>
      <view class="filter-right-area">
         <view class="group-func-btn" bindtap="onGroupClick" aria-label="分组功能" role="button">
            <view class="group-icon-svg">
               <view class="svg-line"></view>
               <view class="svg-line"></view>
               <view class="svg-line"></view>
            </view>
         </view>
         <view class="filter-right-row">
            <view class="vanilla-tag" style="position: relative; left: -425rpx; top: -6rpx; width: 119rpx; display: block; box-sizing: border-box; height: 51rpx">
               <text>香草看涨</text>
            </view>
            <view class="data-info" bindtap="showDataInfo">
               <text class="info-label" style="position: relative; left: -29rpx; top: 9rpx; height: 44rpx; display: block; box-sizing: border-box">数据说明</text>
               <view class="info-icon">?</view>
            </view>
         </view>
      </view>
    </view>

    <!-- 3. 搜索框 -->
    <view class="search-bar">
      <view class="search-input-box" bindtap="onSearchStock">
        <text class="search-icon">🔍</text>
        <text class="search-placeholder">搜索标的</text>
      </view>
    </view>

    <!-- 4. 期限和报价商 -->
    <view class="term-trader-bar">
      <view class="term-selector">
        <view class="term-item {{selectedTerm === '1M' ? 'active' : ''}}" bindtap="onTermChange" data-term="1M">1M</view>
        <view class="term-item {{selectedTerm === '2M' ? 'active' : ''}}" bindtap="onTermChange" data-term="2M">2M</view>
        <view class="term-item {{selectedTerm === '3M' ? 'active' : ''}}" bindtap="onTermChange" data-term="3M">3M</view>
        <view class="term-item {{selectedTerm === '6M' ? 'active' : ''}}" bindtap="onTermChange" data-term="6M">6M</view>
      </view>
      <view class="trader-selector-wrapper">
        <dropdown-select 
          options="{{traders}}" 
          value="{{selectedTraderCode}}" 
          label-key="name" 
          value-key="code"
          placeholder="报价商"
          bind:change="onTraderChangeFromComponent" />
      </view>
    </view>

    <!-- 5. 数据表格 -->
    <view class="data-table">
      <view class="table-header">
        <view class="th col-check" wx:if="{{isEditing}}"></view>
        <view class="th col-name">标的|代码</view>
        <view class="th col-change">涨跌幅 <text class="sort-icon">⇅</text></view>
        <view class="th col-val">平值 <text class="sort-icon">⇅</text></view>
        <view class="th col-val">虚值105 <text class="sort-icon">⇅</text></view>
        <view class="th col-val">虚值110 <text class="sort-icon">⇅</text></view>
      </view>
      <view class="table-body">
        <view class="table-row" wx:for="{{watchlist}}" wx:key="code" bindtap="onViewDetail" data-item="{{item}}">
          <view class="td col-check" wx:if="{{isEditing}}">
             <!-- 简单复选框样式 -->
             <view class="checkbox {{utils.includes(selectedForEdit, item.code) ? 'checked' : ''}}"></view>
          </view>
          <view class="td col-name">
            <text class="stock-name">{{item.name}}</text>
            <text class="stock-code">{{item.code}}</text>
          </view>
          <view class="td col-change {{item.changePercent >= 0 ? 'up' : 'down'}}">
            {{item.changePercent >= 0 ? '+' : ''}}{{item.changePercent}}%
          </view>
          <view class="td col-val text-blue">{{item.atm}}%</view>
          <view class="td col-val text-blue">{{item.otm105}}%</view>
          <view class="td col-val text-blue">{{item.otm110}}%</view>
        </view>
      </view>
    </view>

    <!-- 6. 底部按钮 -->
    <view class="bottom-btns" wx:if="{{!isEditing}}">
      <view class="btn-outline blue" bindtap="goToSearchStock">
        <text class="plus">+</text>添加自选
      </view>
      <view class="btn-outline gray" bindtap="onEditFavorites">
        编辑自选
      </view>
    </view>
    
    <!-- 编辑模式底部按钮 -->
    <view class="bottom-btns" wx:if="{{isEditing}}">
      <view class="btn-outline gray" bindtap="cancelEditing">
        取消
      </view>
      <view class="btn-outline blue" bindtap="deleteSelectedFavorites">
        删除选中
      </view>
    </view>

    <!-- 底部垫高，防止被TabBar遮挡 -->
    <view style="height: 120rpx;"></view>
  </scroll-view>

  <!-- 数据说明弹窗 -->
  <view class="modal-mask {{modalAnimationClass}}" wx:if="{{showDataModal}}" bindtap="hideDataInfo" catchtouchmove="preventTouchMove">
    <view class="modal-container" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">数据说明</text>
        <view class="modal-close" bindtap="hideDataInfo">×</view>
      </view>
      <scroll-view scroll-y class="modal-content">
        <view class="data-info-text">
          <view class="info-item">1. 香草看涨期权费率百分比费率，即期权费除以名义本金的比值。例如：费率为5%，则买入香草看涨期权100万的名义本金，付出期权费为5万元。</view>
          <view class="info-item">2. 费率为参考费率，与交易台报价或成交价可能有区别。</view>
        </view>
      </scroll-view>
      <view class="modal-footer">
        <button class="confirm-btn" bindtap="hideDataInfo">我知道了</button>
      </view>
    </view>
  </view>

  <!-- 分组管理半屏弹窗 -->
  <view class="half-screen-mask {{showGroupManagePopup ? 'show' : ''}}" bindtap="closeGroupManagePopup">
    <view class="half-screen-container {{showGroupManagePopup ? 'show' : ''}}" catchtap="stopBubble">
      <view class="hs-header">
        <text class="hs-title">分组管理</text>
        <view class="hs-close" bindtap="closeGroupManagePopup">×</view>
      </view>
      
      <scroll-view scroll-y class="hs-content">
        <!-- 系统分组 -->
        <view class="group-section-title">系统分组</view>
        <view class="group-list">
          <view class="group-item {{activeGroupId === item.id ? 'active' : ''}}" 
                wx:for="{{systemGroups}}" wx:key="id" 
                bindtap="onSwitchGroup" data-id="{{item.id}}">
            <text class="group-name">{{item.name}}</text>
            <text class="group-count">{{groupCountsById[item.id] || 0}}</text>
          </view>
        </view>
        
        <!-- 自定义分组 -->
        <view class="group-section-header">
          <text class="group-section-title">自定义分组</text>
          <view class="add-group-btn" bindtap="onShowNewGroupDialog">+ 新建分组</view>
        </view>
        
        <view class="group-list custom">
          <view class="group-item-custom" wx:for="{{customGroups}}" wx:key="id">
             <view class="group-info-area" bindtap="onSwitchGroup" data-id="{{item.id}}">
                <text class="group-name {{activeGroupId === item.id ? 'active-text' : ''}}">{{item.name}}</text>
                <text class="group-count">{{groupCountsById[item.id] || 0}}</text>
             </view>
             <view class="group-actions">
                <view class="action-btn more {{item._protected ? 'disabled' : ''}}" catchtap="onOpenGroupActions" data-id="{{item.id}}" data-name="{{item.name}}" data-protected="{{item._protected}}" aria-label="分组操作" role="button">⋯</view>
             </view>
          </view>
          
          <view class="empty-tip" wx:if="{{customGroups.length === 0}}">
            暂无自定义分组
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 新建分组弹窗 -->
  <view class="dialog-mask" wx:if="{{showNewGroupDialog}}">
    <view class="dialog-box">
      <view class="dialog-title">新建分组</view>
      <input class="dialog-input" placeholder="请输入分组名称" value="{{newGroupName}}" bindinput="onNewGroupNameInput" maxlength="10" focus="{{showNewGroupDialog}}" />
      <view class="error-text">{{newGroupError}}</view>
      <view class="dialog-btns">
        <view class="d-btn cancel" bindtap="onCloseNewGroupDialog">取消</view>
        <view class="d-btn confirm {{canConfirmNewGroup ? '' : 'disabled'}}" bindtap="onConfirmNewGroup">确定</view>
      </view>
    </view>
  </view>

  <!-- 重命名分组弹窗 -->
  <view class="dialog-mask" wx:if="{{showRenameGroupDialog}}">
    <view class="dialog-box">
      <view class="dialog-title">重命名分组</view>
      <input class="dialog-input" placeholder="请输入新名称" value="{{editingGroupName}}" bindinput="onRenameGroupNameInput" maxlength="10" focus="{{showRenameGroupDialog}}" />
      <view class="error-text">{{renameGroupError}}</view>
      <view class="dialog-btns">
        <view class="d-btn cancel" bindtap="onCloseRenameGroupDialog">取消</view>
        <view class="d-btn confirm {{canConfirmRenameGroup ? '' : 'disabled'}}" bindtap="onConfirmRenameGroup">确定</view>
      </view>
    </view>
  </view>

  <!-- 删除分组确认弹窗 -->
  <view class="dialog-mask" wx:if="{{showDeleteGroupDialog}}">
    <view class="dialog-box">
      <view class="dialog-title">确认删除分组</view>
      <view class="delete-dialog-desc">您确定要删除该分组吗？</view>
      <view class="delete-dialog-checkbox-row" bindtap="onToggleDeleteRemoveFavorites">
        <view class="delete-checkbox {{deleteRemoveFavorites ? 'checked' : ''}}"></view>
        <view class="delete-checkbox-text">同时将分组内产品移出自选列表</view>
      </view>
      <view class="dialog-btns">
        <view class="d-btn cancel" bindtap="onCancelDeleteGroupDialog">取消</view>
        <view class="d-btn danger" bindtap="onConfirmDeleteGroupDialog">确认</view>
      </view>
    </view>
  </view>
</view>
