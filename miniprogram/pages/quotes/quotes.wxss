/* 页面容器 */
.page-container {
  width: 100vw;
  height: 100vh;
  background-color: #fff;
  display: flex;
  flex-direction: column;
}

/* 1. 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(to right, #6ebdfc, #89cff0); /* 接近图片的浅蓝色 */
  background-color: #7bbfea;
  z-index: 1000;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 200rpx; /* 给右侧胶囊留空 */
  box-sizing: border-box;
}

.nav-tabs {
  display: flex;
  align-items: flex-end; /* 底部对齐 */
  height: 100%;
  padding-bottom: 12rpx;
  gap: 32rpx;
}

.nav-tab {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
  position: relative;
  transition: all 0.3s;
}

.nav-tab.active {
  font-size: 40rpx; /* 选中变大 */
  color: #ffffff;
  font-weight: 600;
}

.nav-tab.active::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background-color: #fff;
  border-radius: 4rpx;
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  width: 100%;
  background-color: #fff;
}

/* 2. 次级筛选栏 */
.sub-filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 24rpx 30rpx 16rpx 24rpx; /* 右边距 30rpx = 15px */
}

.sub-filters {
  display: flex;
  gap: 32rpx;
  padding-bottom: 4rpx; /* 微调对齐 */
}

.top-groups {
  flex: 1;
  min-width: 0;
}

.top-groups-inner {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding-right: 8rpx;
}

.top-groups.fade-in {
  animation: topGroupFadeIn 0.25s ease-out;
}

.top-group-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}

.top-group-count-inline {
  font-size: 24rpx;
}

.top-group-item-hover {
  opacity: 0.7;
}

.top-group-skeleton {
  display: flex;
  align-items: center;
}

.top-group-skeleton-chip {
  width: 110rpx;
  height: 32rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f3f6fb 0%, #e9eef6 50%, #f3f6fb 100%);
  background-size: 200% 100%;
  animation: topGroupShimmer 1.0s ease-in-out infinite;
}

@keyframes topGroupFadeIn {
  from { opacity: 0; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes topGroupShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.sub-filter-item {
  font-size: 28rpx;
  color: #333;
}

.sub-filter-item.active {
  color: #409eff; /* 选中蓝 */
  font-weight: 600;
  position: relative;
}

.sub-filter-item.active::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  width: 100%;
  height: 2rpx;
  background-color: #409eff;
}

.filter-right-area {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 20rpx; /* 间距 20rpx = 10px */
}

.group-func-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  margin-right: -10rpx; /* 补偿内边距，保持视觉上的 15px 边距 */
}

.group-icon-svg {
  width: 36rpx;
  height: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.svg-line {
  width: 100%;
  height: 4rpx;
  background-color: #333;
  border-radius: 2rpx;
}

.group-func-btn:active {
  opacity: 0.5;
  transform: scale(0.9);
}

@media (hover: hover) {
  .group-func-btn:hover {
    opacity: 0.7;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 8rpx;
  }
}

.filter-right-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.vanilla-tag {
  background-color: #eaf4fe;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.vanilla-tag text {
  font-size: 22rpx;
  color: #409eff;
}

.data-info {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.info-label {
  font-size: 22rpx;
  color: #999;
}

.info-icon {
  width: 24rpx;
  height: 24rpx;
  border: 1px solid #999;
  border-radius: 50%;
  font-size: 18rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 3. 搜索框 */
.search-bar {
  padding: 0 24rpx 16rpx 24rpx;
}

.search-input-box {
  background-color: #f7f8fa;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #999;
}

.search-placeholder {
  font-size: 26rpx;
  color: #bbb;
}

/* 4. 期限和报价商 */
.term-trader-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.term-selector {
  display: flex;
  gap: 16rpx;
}

.term-item {
  width: 80rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  background-color: #fff;
}

.term-item.active {
  background-color: #eaf4fe;
  color: #409eff;
  border-color: #eaf4fe;
}

.trader-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.arrow-down {
  font-size: 20rpx;
  color: #999;
}

/* 5. 数据表格 */
.data-table {
  width: 100%;
}

.table-header {
  display: flex;
  padding: 16rpx 24rpx;
  background-color: #fcfcfc;
  border-bottom: 1rpx solid #f0f0f0;
}

.th {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center; /* 默认居中 */
}

.th.col-name {
  justify-content: flex-start; /* 第一列左对齐 */
}

.sort-icon {
  font-size: 18rpx;
  margin-left: 4rpx;
}

/* 列宽定义 */
.col-check { width: 10%; }
.col-name { width: 22%; }
.col-change { width: 20%; }
.col-val { width: 16%; }

.table-body {
  /* min-height: 400rpx; */
}

/* 复选框样式 */
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  box-sizing: border-box;
}

.checkbox.checked {
  background-color: #409eff;
  border-color: #409eff;
  position: relative;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  width: 18rpx;
  height: 10rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg);
}

.table-row {
  display: flex;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #f8f8f8;
  align-items: center;
}

.td {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.td.col-name {
  flex-direction: column;
  align-items: flex-start; /* 左对齐 */
  justify-content: center;
}

.stock-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
  font-weight: 500;
}

.stock-code {
  font-size: 22rpx;
  color: #409eff;
}

.td.col-change {
  font-weight: 500;
}

.td.col-change.up { color: #f56c6c; }
.td.col-change.down { color: #67c23a; }

.td.col-val {
  color: #409eff;
}

/* 6. 底部按钮 */
.bottom-btns {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 24rpx;
}

.btn-outline {
  width: 300rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.btn-outline.blue {
  border: 1rpx solid #409eff;
  color: #409eff;
  background-color: #fff;
}

.btn-outline.gray {
  border: 1rpx solid #ccc;
  color: #999;
  background-color: #fff;
}

.plus {
  font-size: 36rpx;
  margin-right: 8rpx;
  line-height: 1;
}

/* ==================== 数据说明弹窗样式 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease-in-out;
}

.modal-mask.fade-in {
  opacity: 1;
  visibility: visible;
}

.modal-mask.fade-out {
  opacity: 0;
  visibility: hidden;
}

.modal-container {
  width: 85%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transform: scale(0.9);
  transition: transform 0.3s ease-in-out;
}

.modal-mask.fade-in .modal-container {
  transform: scale(1);
}

.modal-header {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 44rpx;
  color: #999;
  line-height: 1;
  padding: 10rpx;
}

.modal-content {
  flex: 1;
  padding: 32rpx;
  box-sizing: border-box;
}

.data-info-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.info-item {
  margin-bottom: 24rpx;
}

.modal-footer {
  padding: 24rpx 32rpx 40rpx;
  display: flex;
  justify-content: center;
}

.confirm-btn {
  width: 100% !important;
  height: 88rpx;
  background: linear-gradient(to right, #409eff, #66b1ff);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:active {
  opacity: 0.8;
}
/* ==================== 数据说明弹窗样式结束 ==================== */

/* ==================== 分组管理半屏弹窗 ==================== */
.half-screen-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 3000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.half-screen-mask.show {
  opacity: 1;
  visibility: visible;
}

.half-screen-container {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 60vh;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.half-screen-container.show {
  transform: translateY(0);
}

.hs-header {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.hs-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.hs-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.hs-content {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.group-section-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
  display: block;
}

.group-list {
  margin-bottom: 40rpx;
}

.group-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.group-item.active .group-name {
  color: #409eff;
  font-weight: 500;
}

.group-name {
  font-size: 30rpx;
  color: #333;
}

.group-count {
  font-size: 26rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.group-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.add-group-btn {
  font-size: 26rpx;
  color: #409eff;
}

.group-item-custom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.group-info-area {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-right: 24rpx;
}

.active-text {
  color: #409eff;
  font-weight: 500;
}

.group-actions {
  display: flex;
  gap: 32rpx;
}

.action-btn {
  font-size: 32rpx;
  color: #999;
  padding: 10rpx;
}

.action-btn.more {
  font-size: 44rpx;
  line-height: 44rpx;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  color: #666;
}

.action-btn.disabled {
  opacity: 0.4;
}

.empty-tip {
  text-align: center;
  color: #ccc;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* ==================== 弹窗通用样式 ==================== */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 4000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-box {
  width: 560rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.delete-dialog-desc {
  font-size: 28rpx;
  color: #333;
  text-align: center;
  margin-bottom: 28rpx;
}

.delete-dialog-checkbox-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 12rpx;
  margin-bottom: 32rpx;
}

.delete-checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.delete-checkbox.checked {
  background-color: #409eff;
  border-color: #409eff;
  position: relative;
}

.delete-checkbox.checked::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  width: 14rpx;
  height: 8rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg);
}

.delete-checkbox-text {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #333;
}

.dialog-input {
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.error-text {
  height: 30rpx;
  font-size: 22rpx;
  color: #ff4d4f;
  margin-bottom: 20rpx;
}

.dialog-btns {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.d-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.d-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.d-btn.confirm {
  background-color: #409eff;
  color: #fff;
}

.d-btn.confirm.disabled {
  background-color: #a0cfff;
  opacity: 0.7;
}

.d-btn.danger {
  background-color: #ff4d4f;
  color: #fff;
}
