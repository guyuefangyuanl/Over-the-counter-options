/* 个股期权报价页面样式 - 严格按照设计稿 */

.quotes-container {
  background-color: #ffffff;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.time {
  font-size: 28rpx;
  font-weight: 600;
}

.signal-battery {
  display: flex;
  gap: 10rpx;
}

/* 股票信息头部 */
.stock-header {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.back-btn {
  margin-right: 20rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #007aff;
  font-weight: bold;
}

.stock-info {
  flex: 1;
}

.stock-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.stock-price {
  font-size: 28rpx;
  color: #333333;
  margin-top: 8rpx;
}

/* 收藏按钮 */
.favorite-btn {
  margin-left: 20rpx;
  padding: 10rpx;
  background-color: transparent;
  border: none;
}

.favorite-icon {
  font-size: 40rpx;
  color: #cccccc;
  transition: all 0.3s ease;
}

.favorite-icon.favorited {
  color: #ff3b30;
  transform: scale(1.1);
}

/* 页面标题 */
.page-title {
  text-align: center;
  padding: 30rpx 0;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  background-color: #ffffff;
}

/* 股票选择区域 */
.stock-selection {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  font-size: 32rpx;
  color: #007aff;
}

.stock-detail {
  flex: 1;
  text-align: center;
}

.stock-full-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.service-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  background-color: #f8f9fa;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666666;
}

.service-icon {
  font-size: 28rpx;
}

/* 搜索弹窗 */
.search-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: none;
}

.search-modal.show {
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-content {
  width: 80%;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  position: relative;
}

.search-input-wrapper {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.search-confirm-btn {
  height: 80rpx;
  padding: 0 30rpx;
  background-color: #007aff;
  color: #ffffff;
  border: none;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.search-close {
  position: absolute;
  top: 20rpx;
  right: 30rpx;
  font-size: 36rpx;
  color: #666666;
}

/* 筛选器区域 */
.filter-section {
  display: flex;
  padding: 30rpx 40rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 40rpx;
  flex-wrap: wrap;
}

.filter-group {
  position: relative;
  flex: 1;
}

.filter-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 10rpx;
  display: block;
}

.filter-dropdown {
  position: relative;
}

.dropdown-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  background-color: #ffffff;
  font-size: 28rpx;
  color: #333333;
}

.dropdown-icon {
  font-size: 20rpx;
  color: #666666;
  margin-left: 8rpx;
}

.dropdown-options {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  z-index: 100;
  max-height: 400rpx;
  overflow-y: auto;
  display: none;
}

.dropdown-options.show {
  display: block;
}

.dropdown-option {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #333333;
}

.dropdown-option:last-child {
  border-bottom: none;
}

.dropdown-option.active {
  background-color: #007aff;
  color: #ffffff;
}

/* 收藏按钮 */
.favorite-btn {
  margin-left: 20rpx;
  padding: 10rpx;
  background-color: transparent;
  border: none;
}

.favorite-icon {
  font-size: 40rpx;
  color: #cccccc;
  transition: all 0.3s ease;
}

.favorite-icon.favorited {
  color: #ff3b30;
  transform: scale(1.1);
}

/* 期权类型选择 */
.option-types {
  display: flex;
  padding: 20rpx 40rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 20rpx;
  flex-wrap: wrap;
}

.type-btn {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #666666;
  background-color: #ffffff;
}

.type-btn.active {
  background-color: #007aff;
  color: #ffffff;
  border-color: #007aff;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top: 4rpx solid #007aff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 报价列表 */
.quotes-list {
  padding: 20rpx;
  padding-bottom: 140rpx;
}

.quote-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 报价头部 */
.quote-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.option-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-type {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  align-self: flex-start;
}

.option-type.call {
  background-color: #ff3b30;
}

.option-type.put {
  background-color: #34c759;
}

.expiry-term {
  font-size: 26rpx;
  color: #666666;
}

.trader-info {
  text-align: right;
}

.trader-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  display: block;
}

.update-time {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
  display: block;
}

/* 报价详情 */
.quote-details {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.strike-price, .premium {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.label {
  font-size: 24rpx;
  color: #666666;
}

.value {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
}

.premium-value {
  color: #007aff;
}

.percentage {
  font-size: 24rpx;
  color: #666666;
  margin-left: 8rpx;
}

/* 买卖报价 */
.bid-ask-section {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 10rpx;
}

.bid, .ask {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  text-align: center;
}

.bid .price {
  color: #ff3b30;
  font-weight: 600;
  font-size: 28rpx;
}

.ask .price {
  color: #34c759;
  font-weight: 600;
  font-size: 28rpx;
}

/* 希腊字母 */
.greeks-section {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.greek-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 100rpx;
}

.greek-label {
  font-size: 22rpx;
  color: #666666;
}

.greek-value {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
  margin-top: 4rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
}

.detail-btn, .inquiry-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  border: none;
}

.detail-btn {
  background-color: #f8f9fa;
  color: #666666;
}

.inquiry-btn {
  background-color: #007aff;
  color: #ffffff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  color: #cccccc;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  gap: 20rpx;
  z-index: 900;
}

.calculator-btn, .workspace-btn, .add-favorite-btn {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #007aff;
  border-radius: 10rpx;
  background-color: #ffffff;
  color: #007aff;
  font-size: 28rpx;
}

.workspace-btn {
  background-color: #007aff;
  color: #ffffff;
}

.add-favorite-btn {
  background-color: #ff9500;
  color: #ffffff;
  border-color: #ff9500;
}

/* 下单弹窗 */
.order-modal {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 2000;
  display: none;
}
.order-modal.show { display: flex; align-items: flex-end; }
.order-content {
  width: 100%;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.08);
}
.order-row { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 0; }
.order-label { width: 180rpx; color: #333; font-size: 28rpx; }
.order-input { flex: 1; border: 2rpx solid #e0e0e0; border-radius: 10rpx; height: 80rpx; line-height: 80rpx; padding: 0 20rpx; font-size: 28rpx; color: #333; }
.order-input.readonly { background: #f8f9fa; }
.order-suffix { color: #666; font-size: 26rpx; }
.order-actions { display: flex; gap: 20rpx; padding-top: 20rpx; }
.order-cancel { flex: 1; height: 80rpx; border-radius: 10rpx; background: #f1f2f3; color: #333; }
.order-confirm { flex: 1; height: 80rpx; border-radius: 10rpx; background: #007aff; color: #fff; }
