/* ==================== 设计系统基础 ==================== */
/* 颜色 Token（语义化命名，便于维护） */
/* 注意：小程序不支持:root选择器，CSS变量必须定义在page下 */
/* ==================== 原型HTML配色方案 ==================== */
page {
  /* ==================== 修复：确保页面有默认背景色 ==================== */
  background-color: #f5f7fa;
  
  /* 主色调 - 匹配原型HTML */
  --color-primary: #409EFF;          /* 主题蓝 - 原型主色 */
  --color-primary-light: #e6f4ff;
  --color-primary-dark: #0297D7;     /* 选中蓝 - 原型选中色 */
  --color-prototype-blue: #71B7FF;   /* 原型蓝 - 股票代码颜色 */
  
  /* 涨跌色 */
  --color-rise: #cf1322;             /* 涨 - 红色 */
  --color-rise-bg: #fff1f0;
  --color-rise-light: #ff4d4f;
  --color-fall: #389e0d;             /* 跌 - 绿色 */
  --color-fall-bg: #f6ffed;
  --color-fall-light: #52c41a;
  
  /* 警示/强调 */
  --color-warning: #fa8c16;
  --color-warning-bg: #fff7e6;
  
  /* 文字颜色 - 匹配原型 */
  --color-text-primary: #333333;     /* 原型文字主色 */
  --color-text-secondary: #606266;
  --color-text-tertiary: #909399;
  --color-text-quaternary: #bfbfbf;
  
  /* 边框与背景 */
  --color-border: #f0f0f0;
  --color-border-light: #e8e8e8;
  --color-bg-container: #ffffff;
  --color-bg-layout: #f5f7fa;
  --color-bg-elevated: #ffffff;
  
  /* 阴影 */
  --shadow-card: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-elevated: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  
  /* 圆角 */
  --radius-sm: 6rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;

  /* 新增：间距系统 */
  --spacing-xs: 4rpx;
  --spacing-sm: 8rpx;
  --spacing-md: 16rpx;
  --spacing-lg: 24rpx;
  --spacing-xl: 32rpx;
  --spacing-xxl: 48rpx;
  
  /* 新增：动画曲线 */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 页面容器 */
.page-container {
  width: 100vw;
  height: 100vh;
  /* 修复：添加硬编码颜色备用，防止 CSS 变量失效导致黑屏 */
  background-color: #f5f7fa;
  background-color: var(--color-bg-layout, #f5f7fa);
  display: flex;
  flex-direction: column;
}

/* 1. 自定义导航栏（白色主题） */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #ffffff;
  z-index: 1000;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  padding-right: 200rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-tabs {
  display: flex;
  align-items: flex-end;
  height: 100%;
  padding-bottom: 16rpx;
  gap: 40rpx;
}

.nav-tab {
  font-size: 30rpx;
  color: #666666;
  font-weight: 400;
  position: relative;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 1rpx;
}

.nav-tab.active {
  font-size: 36rpx;
  color: #1677ff;
  font-weight: 600;
  letter-spacing: 0;
}

.nav-tab.active::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 4rpx;
  background-color: #1677ff;
  border-radius: 2rpx;
  animation: tabIndicatorIn 0.25s ease-out;
}

@keyframes tabIndicatorIn {
  from { width: 0; opacity: 0; }
  to { width: 24rpx; opacity: 1; }
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  width: 100%;
  background-color: #fff;
}

/* 2. 次级筛选栏 */
.sub-filter-bar {
  display: flex;
  flex-direction: column;
  padding: 16rpx 24rpx;
  background-color: #fff;
}

.filter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.filter-row.top-row {
  margin-bottom: 20rpx;
}

.sub-filters {
  display: flex;
  align-items: center;
  gap: 32rpx;
  flex: 1;
  min-width: 0;
}

.top-groups {
  flex: 1;
  min-width: 0;
}

.top-groups-inner {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding-right: 8rpx;
}

.top-groups.fade-in {
  animation: topGroupFadeIn 0.25s ease-out;
}

.top-group-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}

.top-group-count-inline {
  font-size: 24rpx;
}

.top-group-item-hover {
  opacity: 0.7;
}

.top-group-skeleton {
  display: flex;
  align-items: center;
}

.top-group-skeleton-chip {
  width: 110rpx;
  height: 32rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f3f6fb 0%, #e9eef6 50%, #f3f6fb 100%);
  background-size: 200% 100%;
  animation: topGroupShimmer 1.0s ease-in-out infinite;
}

@keyframes topGroupFadeIn {
  from { opacity: 0; transform: translateY(6rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes topGroupShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.sub-filter-item {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
  flex-shrink: 0;
}

.sub-filter-item.active {
  color: #409eff; /* 选中蓝 */
  font-weight: 600;
  position: relative;
}

.sub-filter-item.active::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  width: 100%;
  height: 2rpx;
  background-color: #409eff;
}

.filter-right-area {
  display: flex;
  align-items: center;
}

.group-func-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  margin-right: -10rpx; /* 补偿内边距，保持视觉上的 15px 边距 */
}

.group-icon-svg {
  width: 36rpx;
  height: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.svg-line {
  width: 100%;
  height: 4rpx;
  background-color: #333;
  border-radius: 2rpx;
}

.group-func-btn:active {
  opacity: 0.5;
  transform: scale(0.9);
}

@media (hover: hover) {
  .group-func-btn:hover {
    opacity: 0.7;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 8rpx;
  }
}

.filter-right-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.vanilla-tag {
  background-color: #eaf4fe;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.vanilla-tag text {
  font-size: 22rpx;
  color: #409eff;
}

.data-info {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.info-label {
  font-size: 22rpx;
  color: #999;
}

.info-icon {
  width: 24rpx;
  height: 24rpx;
  border: 1px solid #999;
  border-radius: 50%;
  font-size: 18rpx;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 3. 搜索框 */
.search-bar {
  padding: 0 24rpx 16rpx 24rpx;
}

.search-input-box {
  background-color: #f7f8fa;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
}

.current-stock-info {
  margin-top: 16rpx;
  background-color: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.stock-basic {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.stock-basic .stock-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stock-basic .stock-code {
  font-size: 24rpx;
  color: #999;
  margin-left: 12rpx;
  flex: 1;
}

.favorite-btn {
  padding: 10rpx;
}

.stock-price-row {
  display: flex;
  align-items: baseline;
}

.stock-price-row .price {
  font-size: 38rpx;
  font-weight: bold;
}

.stock-price-row .change {
  font-size: 24rpx;
  margin-left: 16rpx;
}

.up { color: #e54d42; }
.down { color: #39b54a; }

/* 期权报价列表样式 */
.option-type {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.option-term {
  font-size: 22rpx;
  color: #999;
}

.strike {
  font-size: 28rpx;
  color: #333;
}

.text-blue {
  color: #409eff;
}

.search-icon {
  font-size: 28rpx;
  color: #999;
}

.search-placeholder {
  font-size: 26rpx;
  color: #bbb;
}

/* 4. 期限和报价商 */
.term-trader-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.term-selector {
  display: flex;
  gap: 16rpx;
}

.term-item {
  width: 80rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  background-color: #fff;
}

.term-item.active {
  background-color: #eaf4fe;
  color: #409eff;
  border-color: #eaf4fe;
}

.trader-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.arrow-down {
  font-size: 20rpx;
  color: #999;
}

/* 5. 数据表格（现代化设计 - 优化版） */
.data-table {
  width: calc(100% - 48rpx);
  background-color: #ffffff !important;
  border-radius: 24rpx;
  border-radius: var(--radius-xl, 24rpx);
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  box-shadow: var(--shadow-elevated, 0 4rpx 16rpx rgba(0, 0, 0, 0.08));
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.table-header {
  display: flex;
  padding: 24rpx 20rpx;
  background: #ffffff !important;
  border-bottom: 2rpx solid rgba(22, 119, 255, 0.1);
  position: sticky;
  top: 0;
  z-index: 10;
}

.th {
  font-size: 24rpx;
  font-size: var(--font-size-sm, 24rpx);
  color: #909399;
  color: var(--color-text-tertiary, #909399);
  font-weight: 600;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif;
  font-family: var(--font-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  transition: all 0.2s var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  letter-spacing: 0.5rpx;
}

.th[data-sort]:active {
  color: #409EFF;
  color: var(--color-primary, #409EFF);
  transform: scale(1.02);
}

.th.col-name {
  justify-content: flex-start;
  padding-left: 8rpx;
  padding-left: var(--spacing-sm, 8rpx);
}

.sort-icon {
  font-size: 14rpx;
  margin-left: 8rpx;
  color: #bfbfbf;
  color: var(--color-text-quaternary, #bfbfbf);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  transition: transform 0.3s var(--ease-spring, cubic-bezier(0.34, 1.56, 0.64, 1));
  opacity: 0.6;
}

.th[data-sort]:active .sort-icon {
  transform: scale(1.2);
  opacity: 1;
}

/* 列宽优化（更合理的比例分配 + 弹性适配） */
.col-check { width: 8%; min-width: 60rpx; flex-shrink: 0; }
.col-name { width: 28%; min-width: 180rpx; flex-shrink: 0; }
.col-change { width: 18%; min-width: 120rpx; flex-shrink: 0; }
.col-val { width: 15%; min-width: 100rpx; flex-shrink: 0; display: flex; justify-content: flex-end; padding-right: 4rpx; padding-right: var(--spacing-xs, 4rpx); }

.table-body {
  overflow: hidden;
}

/* 复选框样式（现代化） */
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #e8e8e8;
  border: 2rpx solid var(--color-border-light, #e8e8e8);
  border-radius: 6rpx;
  border-radius: var(--radius-sm, 6rpx);
  box-sizing: border-box;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox:active {
  transform: scale(0.9);
}

.checkbox.checked {
  background-color: #409EFF;
  background-color: var(--color-primary, #409EFF);
  border-color: #409EFF;
  border-color: var(--color-primary, #409EFF);
}

.checkbox.checked::after {
  content: '';
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

/* 表格行样式（卡片化、层次感） */
.table-row {
  display: flex;
  padding: 28rpx 24rpx;
  background-color: #ffffff !important;
  align-items: center;
  transition: all 0.2s ease;
  position: relative;
}

.table-row::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 24rpx;
  right: 24rpx;
  height: 1rpx;
  background-color: #f0f0f0;
  background-color: var(--color-border, #f0f0f0);
}

.table-row:last-child::after {
  display: none;
}

.table-row:active {
  background-color: #e6f4ff !important;
}

/* 数据单元格样式（确保无异常边框背景） */
.td {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background-color: transparent;
  border: none;
  box-shadow: none;
}

.td.col-name {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 6rpx;
}

.stock-name {
  font-size: 30rpx;
  color: #333333;
  color: var(--color-text-primary, #333333);
  font-weight: 600;
  line-height: 1.2;
}

.stock-code {
  font-size: 22rpx;
  color: #71B7FF;
  color: var(--color-prototype-blue, #71B7FF);  /* 原型蓝 #71B7FF */
  font-weight: 400;
  background-color: transparent;
  padding: 0;
  border-radius: 0;
  border: none;
}

/* 涨跌幅样式（醒目、简洁版 - 移除异常边框背景） */
.td.col-change {
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  min-width: 80rpx;
  background-color: transparent;
  border: none;
  box-shadow: none;
  padding: 0;
}

.td.col-change.up {
  color: #cf1322;
  color: var(--color-rise, #cf1322);
  background-color: transparent;
  border: none;
  box-shadow: none;
}

.td.col-change.down {
  color: #389e0d;
  color: var(--color-fall, #389e0d);
  background-color: transparent;
  border: none;
  box-shadow: none;
}

/* 涨跌幅闪烁动画（价格变化时触发 - 修复版） */
.td.col-change.flash-up {
  animation: flashUpEnhanced 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  animation: flashUpEnhanced 0.5s var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
}

.td.col-change.flash-down {
  animation: flashDownEnhanced 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  animation: flashDownEnhanced 0.5s var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
}

@keyframes flashUpEnhanced {
  0% {
    background-color: rgba(255, 77, 79, 0.3);
    transform: scale(1.02);
  }
  100% {
    background-color: transparent;
    transform: scale(1);
  }
}

@keyframes flashDownEnhanced {
  0% {
    background-color: rgba(82, 196, 26, 0.3);
    transform: scale(1.02);
  }
  100% {
    background-color: transparent;
    transform: scale(1);
  }
}

/* 期权费率样式 - 匹配原型HTML */
.td.col-val {
  color: #333333;
  color: var(--color-text-primary, #333333);  /* 原型中为深灰色 #333 */
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  position: relative;
  padding-right: 4rpx;
  padding-right: var(--spacing-xs, 4rpx);
}

.td.col-val.text-blue {
  color: #333333;
  color: var(--color-text-primary, #333333);  /* 原型中为深灰色 */
}

.td.col-val.text-gray {
  color: #606266;
  color: var(--color-text-secondary, #606266);  /* 灰色 #666 */
  font-weight: 500;
}

/* 费率趋势指示器（增强版） */
.rate-trend-up::before {
  content: '↑';
  font-size: 16rpx;
  color: #cf1322;
  color: var(--color-rise, #cf1322);
  margin-right: 6rpx;
  animation: trendUpPulse 1s ease-in-out infinite;
}

.rate-trend-down::before {
  content: '↓';
  font-size: 16rpx;
  color: #389e0d;
  color: var(--color-fall, #389e0d);
  margin-right: 6rpx;
  animation: trendDownPulse 1s ease-in-out infinite;
}

@keyframes trendUpPulse {
  0%, 100% { opacity: 1; transform: translateY(0); }
  50% { opacity: 0.7; transform: translateY(-2rpx); }
}

@keyframes trendDownPulse {
  0%, 100% { opacity: 1; transform: translateY(0); }
  50% { opacity: 0.7; transform: translateY(2rpx); }
}

/* 费率趋势指示器 */
.rate-trend-up::before {
  content: '↑';
  font-size: 18rpx;
  color: #cf1322;
  color: var(--color-rise, #cf1322);
  margin-right: 4rpx;
}

.rate-trend-down::before {
  content: '↓';
  font-size: 18rpx;
  color: #389e0d;
  color: var(--color-fall, #389e0d);
  margin-right: 4rpx;
}

/* 6. 底部按钮 */
.bottom-btns {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 24rpx;
}

.btn-outline {
  width: 300rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.btn-outline.blue {
  border: 1rpx solid #409eff;
  color: #409eff;
  background-color: #fff;
}

.btn-outline.gray {
  border: 1rpx solid #ccc;
  color: #999;
  background-color: #fff;
}

.plus {
  font-size: 36rpx;
  margin-right: 8rpx;
  line-height: 1;
}

/* ==================== 数据说明弹窗样式 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease-in-out;
}

.modal-mask.fade-in {
  opacity: 1;
  visibility: visible;
}

.modal-mask.fade-out {
  opacity: 0;
  visibility: hidden;
}

.modal-container {
  width: 85%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transform: scale(0.9);
  transition: transform 0.3s ease-in-out;
}

.modal-mask.fade-in .modal-container {
  transform: scale(1);
}

.modal-header {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 44rpx;
  color: #999;
  line-height: 1;
  padding: 10rpx;
}

.modal-content {
  flex: 1;
  padding: 32rpx;
