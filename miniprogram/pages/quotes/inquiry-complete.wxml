<!-- 基于HTML设计稿的小程序询价页面 -->
<wxs src="./quotes.wxs" module="utils" />

<view class="inquiry-container">
  <!-- 页面状态指示器 -->
  <view wx:if="{{showLoading}}" class="page-loading">
    <van-loading size="24px">加载中...</van-loading>
  </view>
  
  <!-- 网络状态提示 -->
  <view wx:if="{{!networkStatus}}" class="network-status-bar">
    <text class="network-status-text">网络连接不可用</text>
  </view>
  
  <!-- 错误提示 -->
  <view wx:if="{{showError}}" class="error-bar">
    <text class="error-text">{{errorMessage}}</text>
    <van-icon name="cross" bindtap="hideError" />
  </view>

  <!-- 顶部固定区域 -->
  <view class="top-fixed-section">
    <!-- 1. 市场指数和时间 -->
    <view class="market-header">
      <scroll-view class="market-indexes" scroll-x show-scrollbar="{{false}}">
        <view class="market-index-item" wx:for="{{marketIndexes}}" wx:key="code">
          <view class="market-index-name">{{item.name}}</view>
          <view class="market-index-value {{item.changePercent > 0 ? 'is-rise' : (item.changePercent < 0 ? 'is-fall' : '')}}">
            {{item.value}}
          </view>
          <view class="market-index-change {{item.changePercent > 0 ? 'is-rise' : (item.changePercent < 0 ? 'is-fall' : '')}}">
            {{utils.formatChange(item.changePercent)}}
          </view>
        </view>
      </scroll-view>
      <view class="current-time">{{currentTime}}</view>
    </view>

    <!-- 2. Tab导航 -->
    <view class="tabs-container">
      <!-- 主Tab导航 -->
      <view class="primary-tabs">
        <view class="primary-tab-item {{filters.primaryTab === 'self' ? 'is-active' : ''}}" 
              hover-class="tab-hover" 
              bindtap="switchPrimaryTab" 
              data-tab="self">
          自选
        </view>
        <view class="primary-tab-item {{filters.primaryTab === 'stock' ? 'is-active' : ''}}" 
              hover-class="tab-hover" 
              bindtap="switchPrimaryTab" 
              data-tab="stock">
          个股
        </view>
        <view class="primary-tab-item {{filters.primaryTab === 'index' ? 'is-active' : ''}}" 
              hover-class="tab-hover" 
              bindtap="switchPrimaryTab" 
              data-tab="index">
          指数
        </view>
        <view class="primary-tab-item {{filters.primaryTab === 'etf' ? 'is-active' : ''}}" 
              hover-class="tab-hover" 
              bindtap="switchPrimaryTab" 
              data-tab="etf">
          ETF
        </view>
      </view>
      
      <!-- 子Tab导航（自选分组） -->
      <view class="sub-tabs" wx:if="{{filters.primaryTab === 'self'}}">
        <scroll-view class="sub-tabs-scroll" scroll-x show-scrollbar="{{false}}">
          <block wx:for="{{groups.system}}" wx:key="id">
            <view class="sub-tab-item {{filters.subTab === item.id ? 'is-active' : ''}}" 
                  hover-class="tab-hover" 
                  bindtap="switchSubTab" 
                  data-tab="{{item.id}}">
              {{item.name}}
            </view>
          </block>
          <block wx:for="{{groups.custom}}" wx:key="id">
            <view class="sub-tab-item {{filters.subTab === item.id ? 'is-active' : ''}}" 
                  hover-class="tab-hover" 
                  bindtap="switchSubTab" 
                  data-tab="{{item.id}}">
              {{item.name}}
            </view>
          </block>
        </scroll-view>
        <view class="edit-group-btn" bindtap="showGroupManage">
          <image src="/images/edit.svg" class="edit-icon" mode="aspectFit" lazy-load="true" />
        </view>
      </view>
    </view>

    <!-- 3. 搜索和筛选区域 -->
    <view class="filter-section">
      <!-- 搜索框 -->
      <view class="search-bar">
        <image src="/images/icons/search.png" class="search-icon" mode="aspectFit" lazy-load="true" />
        <input class="search-input" 
               placeholder="搜索股票名称/代码" 
               value="{{filters.keyword}}" 
               bindinput="onSearchInput"
               bindconfirm="onSearchConfirm"
               confirm-type="search" />
        <image wx:if="{{filters.keyword}}" 
               src="/images/close.svg"
               class="clear-icon" 
               bindtap="clearSearch" 
               mode="aspectFit" 
               lazy-load="true" />
      </view>
      
      <!-- 筛选条件 -->
      <view class="filter-controls">
        <!-- 期限筛选 -->
        <view class="filter-group">
          <text class="filter-label">期限</text>
          <view class="filter-options">
            <view class="filter-option {{filters.term === '1M' ? 'is-active' : ''}}" 
                  bindtap="switchTerm" 
                  data-term="1M">1M</view>
            <view class="filter-option {{filters.term === '2M' ? 'is-active' : ''}}" 
                  bindtap="switchTerm" 
                  data-term="2M">2M</view>
            <view class="filter-option {{filters.term === '3M' ? 'is-active' : ''}}" 
                  bindtap="switchTerm" 
                  data-term="3M">3M</view>
            <view class="filter-option {{filters.term === '6M' ? 'is-active' : ''}}" 
                  bindtap="switchTerm" 
                  data-term="6M">6M</view>
          </view>
        </view>
        
        <!-- 结构筛选 -->
        <view class="filter-group">
          <text class="filter-label">结构</text>
          <view class="filter-options">
            <view class="filter-option {{filters.structure === 'vanilla' ? 'is-active' : ''}}" 
                  bindtap="switchStructure" 
                  data-structure="vanilla">香草</view>
            <view class="filter-option {{filters.structure === 'snowball' ? 'is-active' : ''}}" 
                  bindtap="switchStructure" 
                  data-structure="snowball">雪球</view>
          </view>
        </view>
        
        <!-- 数据说明 -->
        <view class="data-info-trigger" bindtap="showDataInfo">
          <text>数据说明</text>
          <image src="/images/info.png" class="info-icon" mode="aspectFit" lazy-load="true" />
        </view>
      </view>
    </view>
  </view>

  <!-- 主要内容区域 -->
  <scroll-view class="main-content" 
               scroll-y 
               enable-back-to-top="{{true}}"
               bindscrolltolower="onReachBottom"
               refresher-enabled="{{true}}"
               refresher-triggered="{{isRefreshing}}"
               bindrefresherrefresh="onPullDownRefresh">
    
    <!-- 产品列表 -->
    <view class="product-list" wx:if="{{filteredProducts.length > 0}}">
      <!-- 列表头部 -->
      <view class="list-header">
        <view class="header-cell header-name">标的|代码</view>
        <view class="header-cell header-change">涨跌幅</view>
        <view class="header-cell header-rate">平值</view>
        <view class="header-cell header-rate">虚值105</view>
        <view class="header-cell header-rate">虚值110</view>
        <view class="header-cell header-action">操作</view>
      </view>
      
      <!-- 产品项 -->
      <block wx:for="{{filteredProducts}}" wx:key="id">
        <view class="product-item {{selectedFavorites.indexOf(item.id) > -1 ? 'is-selected' : ''}}" 
              hover-class="item-hover"
              bindtap="{{isEditingFavorites ? 'toggleFavoriteSelection' : 'goToProductDetail'}}"
              data-id="{{item.id}}">
          
          <!-- 产品基本信息 -->
          <view class="product-basic">
            <view class="product-name">{{item.name}}</view>
            <view class="product-code">{{item.code}}</view>
          </view>
          
          <!-- 涨跌幅 -->
          <view class="product-change {{item.changePercent > 0 ? 'is-rise' : (item.changePercent < 0 ? 'is-fall' : '')}}">
            {{utils.formatChange(item.changePercent)}}
          </view>
          
          <!-- 费率信息 -->
          <view class="product-rate">{{item.rates['100']}}%</view>
          <view class="product-rate">{{item.rates['105']}}%</view>
          <view class="product-rate">{{item.rates['110']}}%</view>
          
          <!-- 操作按钮 -->
          <view class="product-actions">
            <van-button type="primary" size="mini" bindtap="showInquiryForm" data-id="{{item.id}}">
              询价
            </van-button>
            <view class="favorite-btn" bindtap="toggleFavorite" data-id="{{item.id}}">
              <van-icon name="{{favorites[item.id] ? 'star' : 'star-o'}}" size="20px" color="{{favorites[item.id] ? '#ffd700' : '#969799'}}" />
            </view>
          </view>
        </view>
      </block>
      
      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{pagination.hasMore}}">
        <van-loading wx:if="{{pagination.isLoadingMore}}" size="16px">加载中...</van-loading>
        <text wx:else>上拉加载更多</text>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredProducts.length === 0 && !isLoading}}">
      <image src="/images/empty.svg" class="empty-icon" mode="aspectFit" lazy-load="true" />
      <text class="empty-title">暂无数据</text>
      <text class="empty-desc">{{getEmptyStateText()}}</text>
      <van-button type="primary" size="small" bindtap="clearAllFilters" wx:if="{{hasActiveFilters()}}">
        清除筛选条件
      </van-button>
    </view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="bottom-actions" wx:if="{{filters.primaryTab === 'self'}}">
    <view class="action-buttons" wx:if="{{!isEditingFavorites}}">
      <van-button type="primary" round bindtap="batchInquiry">
        批量询价
      </van-button>
      <van-button type="info" round bindtap="quickInquiry">
        快速询价
      </van-button>
      <van-button plain type="primary" round bindtap="startEditFavorites">
        编辑自选
      </van-button>
    </view>
    
    <view class="edit-actions" wx:if="{{isEditingFavorites}}">
      <van-button plain round bindtap="cancelEditFavorites">
        取消
      </van-button>
      <van-button type="primary" round bindtap="removeSelectedFavorites" disabled="{{selectedFavorites.length === 0}}">
        删除选中 ({{selectedFavorites.length}})
      </van-button>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="quick-action-item" bindtap="goToCalculator" hover-class="quick-action-hover">
      <image src="/images/calculator.png" class="quick-action-icon" mode="aspectFit" lazy-load="true" />
      <text class="quick-action-text">计算器</text>
    </view>
    <view class="quick-action-item" bindtap="goToInquiryRecords" hover-class="quick-action-hover">
      <image src="/images/records.png" class="quick-action-icon" mode="aspectFit" lazy-load="true" />
      <text class="quick-action-text">询价记录</text>
    </view>
    <view class="quick-action-item" bindtap="goToProfile" hover-class="quick-action-hover">
      <image src="/images/profile.png" class="quick-action-icon" mode="aspectFit" lazy-load="true" />
      <text class="quick-action-text">个人中心</text>
    </view>
  </view>

  <!-- 分组管理弹窗 -->
  <van-popup show="{{showGroupManage}}" round position="bottom" custom-style="height: 60%;">
    <view class="group-manage-popup">
      <view class="popup-header">
        <text class="popup-title">分组管理</text>
        <van-icon name="cross" bindtap="hideGroupManage" />
      </view>
      
      <scroll-view scroll-y class="popup-content">
        <view class="group-section">
          <text class="section-title">系统分组</text>
          <block wx:for="{{groups.system}}" wx:key="id">
            <view class="group-item" bindtap="selectGroup" data-id="{{item.id}}">
              <text class="group-name">{{item.name}}</text>
              <text class="group-count">({{item.count}})</text>
              <van-icon name="success" size="20px" wx:if="{{filters.subTab === item.id}}" />
            </view>
          </block>
        </view>
        
        <view class="group-section">
          <text class="section-title">自定义分组</text>
          <block wx:for="{{groups.custom}}" wx:key="id">
            <view class="group-item" bindtap="selectGroup" data-id="{{item.id}}">
              <text class="group-name">{{item.name}}</text>
              <text class="group-count">({{item.count}})</text>
              <view class="group-actions">
                <van-icon name="edit" bindtap="editGroupName" data-id="{{item.id}}" />
                <van-icon name="delete" bindtap="deleteGroup" data-id="{{item.id}}" />
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
      
      <view class="popup-footer">
        <van-button type="primary" block round bindtap="createNewGroup">
          新建分组
        </van-button>
      </view>
    </view>
  </van-popup>

  <!-- 询价表单弹窗 -->
  <van-popup show="{{showInquiryForm}}" round position="bottom" custom-style="height: 80%;">
    <view class="inquiry-form-popup">
      <view class="popup-header">
        <text class="popup-title">产品询价</text>
        <van-icon name="cross" bindtap="hideInquiryForm" />
      </view>
      
      <scroll-view scroll-y class="popup-content">
        <!-- 产品信息 -->
        <view class="form-section">
          <text class="section-title">产品信息</text>
          <view class="product-info-card" wx:if="{{inquiryForm.selectedProduct}}">
            <view class="product-header">
              <text class="product-name">{{inquiryForm.selectedProduct.name}}</text>
              <text class="product-code">{{inquiryForm.selectedProduct.code}}</text>
            </view>
            <view class="product-details">
              <text class="product-detail">结构：{{inquiryForm.selectedProduct.structure === 'vanilla' ? '香草' : '雪球'}}</text>
              <text class="product-detail">期限：{{inquiryForm.selectedProduct.term}}</text>
              <text class="product-detail">平值费率：{{inquiryForm.selectedProduct.rates['100']}}%</text>
            </view>
          </view>
        </view>
        
        <!-- 询价数量 -->
        <view class="form-section">
          <text class="section-title">询价数量</text>
          <van-field
            value="{{inquiryForm.quantity}}"
            placeholder="请输入询价数量"
            type="number"
            data-field="quantity"
            bind:change="onFormInput"
            error-message="{{formErrors.quantity}}"
            required
            label="数量"
          />
        </view>
        
        <!-- 联系信息 -->
        <view class="form-section">
          <text class="section-title">联系信息</text>
          <van-field
            value="{{inquiryForm.contactName}}"
            placeholder="请输入联系人姓名"
            data-field="contactName"
            bind:change="onFormInput"
            error-message="{{formErrors.contactName}}"
            required
            label="姓名"
          />
          <van-field
            value="{{inquiryForm.contactPhone}}"
            placeholder="请输入联系电话"
            type="tel"
            data-field="contactPhone"
            bind:change="onFormInput"
            error-message="{{formErrors.contactPhone}}"
            required
            label="电话"
          />
          <van-field
            value="{{inquiryForm.contactEmail}}"
            placeholder="请输入邮箱地址（可选）"
            type="email"
            data-field="contactEmail"
            bind:change="onFormInput"
            error-message="{{formErrors.contactEmail}}"
            label="邮箱"
          />
          <van-field
            value="{{inquiryForm.notes}}"
            placeholder="请输入备注信息（可选）"
            type="textarea"
            rows="3"
            data-field="notes"
            bind:change="onFormInput"
            label="备注"
          />
        </view>
      </scroll-view>
      
      <!-- 提交按钮 -->
      <view class="popup-footer">
        <van-button 
          type="primary" 
          block 
          round 
          bind:click="submitInquiryForm"
          loading="{{isSubmitting}}"
          disabled="{{isSubmitting}}"
        >
          {{isSubmitting ? '提交中...' : '提交询价'}}
        </van-button>
      </view>
    </view>
  </van-popup>

  <!-- 数据说明弹窗 -->
  <van-popup show="{{showDataInfo}}" round position="center" custom-style="width: 80%; max-height: 60%;">
    <view class="data-info-popup">
      <view class="popup-header">
        <text class="popup-title">数据说明</text>
        <van-icon name="cross" bindtap="hideDataInfo" />
      </view>
      <scroll-view scroll-y class="popup-content">
        <view class="info-content">
          <text class="info-text">
            1. 香草看涨期权费率百分比费率，即期权费除以名义本金的比值。例如：期权费率为5%，则买入香草看涨期权100万的名义本金，付出期权费为5万元。
          </text>
          <text class="info-text">
            2. 期权费率为参考费率，与交易台报价或成交价可能有区别。
          </text>
          <text class="info-text">
            3. 虚值期权费率会根据执行价格的不同而有所差异。
          </text>
          <text class="info-text">
            4. 询价结果以交易商最终确认为准。
          </text>
        </view>
      </scroll-view>
      <view class="popup-footer">
        <van-button type="primary" block round bindtap="hideDataInfo">
          我知道了
        </van-button>
      </view>
    </view>
  </van-popup>
</view>