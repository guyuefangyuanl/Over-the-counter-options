/* 用户协议页面样式 */

/*
  优化说明:
  1. 使用全局 CSS 变量统一颜色和阴影，保持视觉一致性。
  2. 重构按钮样式，提取公共代码，使用 BEM 命名法提高可维护性。
  3. 优化布局，使用 Flexbox 进行垂直居中和对齐。
  4. 添加注释，提高代码可读性。
*/

.agreement-container {
  min-height: 100vh;
  background-color: var(--background-color, #f8f9fa);
  display: flex;
  flex-direction: column;
}

.agreement-header {
  background-color: var(--white, #ffffff);
  padding: 40rpx 30rpx 30rpx;
  text-align: center;
  box-shadow: var(--card-shadow, 0 2rpx 8rpx rgba(0, 0, 0, 0.1));
  position: sticky;
  top: 0;
  z-index: 100;
}

.agreement-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-color-primary, #333333);
  margin-bottom: 12rpx;
}

.update-time {
  display: block;
  font-size: 24rpx;
  color: var(--text-color-secondary, #999999);
}

.agreement-content {
  flex: 1;
  padding: 20rpx 30rpx 120rpx;
  /* 使用 calc 动态计算高度，减去头部和底部的高度 */
  height: calc(100vh - 200rpx);
}

.section {
  background-color: var(--white, #ffffff);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--card-shadow-light, 0 2rpx 8rpx rgba(0, 0, 0, 0.05));
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color-primary, #333333);
  margin-bottom: 20rpx;
  border-left: 6rpx solid var(--primary-color, #409EFF);
  padding-left: 20rpx;
}

.section-content {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-color-regular, #666666);
  text-align: justify;
  white-space: pre-line;
}

.agreement-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--white, #ffffff);
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: var(--card-shadow-dark, 0 -2rpx 8rpx rgba(0, 0, 0, 0.1));
  z-index: 100;
}

/* 按钮基础样式 */
.btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease;
}

/* 返回按钮 */
.btn--secondary {
  background-color: var(--background-color, #f5f5f5);
  color: var(--text-color-regular, #666666);
}

.btn--secondary:hover {
  background-color: #e9e9e9;
}

/* 同意按钮 */
.btn--primary {
  background-color: var(--primary-color, #409EFF);
  color: var(--white, #ffffff);
}

.btn--primary:hover {
  background-color: var(--primary-color-dark, #3a8ee6);
}