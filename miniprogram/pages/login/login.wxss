/* 登录页面样式 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
  overflow: hidden;
  padding: 40rpx 60rpx;
  box-sizing: border-box;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05); /* 降低透明度，更柔和 */
}

.circle1 {
  width: 200rpx;
  height: 200rpx;
  top: 10%;
  right: 10%;
}

.circle2 {
  width: 150rpx;
  height: 150rpx;
  bottom: 20%;
  left: 5%;
}

.circle3 {
  width: 100rpx;
  height: 100rpx;
  top: 30%;
  left: 20%;
}

/* 顶部Logo区域 */
.header-section {
  text-align: center;
  margin-bottom: 80rpx;
  padding-top: 40rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.app-name {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.app-slogan {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 300;
}

/* 登录方式切换 */
.login-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50rpx;
  padding: 8rpx;
  margin-bottom: 60rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 42rpx;
  transition: all 0.2s ease; /* 加快过渡速度 */
}

.tab-item text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.tab-item.active {
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.tab-item.active text {
  color: #667eea;
  font-weight: 600;
}

/* 登录内容区域 */
.login-content {
  position: relative;
  z-index: 10;
}

.login-panel {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 50rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 40rpx;
}

/* 面板头部 */
.panel-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.login-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.panel-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.panel-desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
  font-weight: 400;
}

/* 表单区域 */
.form-section {
  margin-bottom: 50rpx;
}

.input-group {
  position: relative;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 24rpx;
  padding: 0 30rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease;
}

.input-group:focus-within {
  border-color: #667eea;
  background: #ffffff;
}

.input-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 20rpx;
  opacity: 0.6;
}

.phone-input,
.code-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: #333333;
  background: transparent;
  border: none;
}

.send-code-btn {
  background: #667eea;
  color: #ffffff;
  font-size: 24rpx;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  border: none;
  font-weight: 500;
}

.send-code-btn:not(.disabled):active {
  background: #5a6fd8;
}

.send-code-btn.disabled {
  background: #cccccc;
  color: #888888;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.login-btn:active {
  transform: scale(0.98);
}

.login-btn:disabled {
  opacity: 0.6;
  transform: none !important;
  box-shadow: none !important;
}

.wechat-btn {
  background: linear-gradient(135deg, #07c160 0%, #1aad19 100%);
}

.qq-btn {
  background: linear-gradient(135deg, #12b7f5 0%, #027eff 100%);
}

.phone-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
}

.btn-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

/* 登录提示 */
.login-tips {
  background: rgba(102, 126, 234, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
}

.login-tips text {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.login-tips text:last-child {
  margin-bottom: 0;
}

.login-tips text::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  background: #667eea;
  border-radius: 50%;
  margin-right: 12rpx;
  vertical-align: middle;
}

/* 协议区域 */
.agreement-section {
  margin-bottom: 40rpx;
}

.agreement-check {
  display: flex;
  align-items: flex-start;
  padding: 0 20rpx;
}

.agreement-checkbox {
  margin-right: 16rpx;
  margin-top: 4rpx;
  transform: scale(0.8); /* 缩小复选框 */
}

.agreement-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
  flex: 1;
}

.link-text {
  color: #ffd700;
  text-decoration: underline;
  font-weight: 500;
}

/* 其他登录方式 */
.other-login {
  margin-bottom: 60rpx;
}

.divider {
  text-align: center;
  margin-bottom: 40rpx;
  position: relative;
}

.divider::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.3);
}

.divider text {
  background: transparent; /* 背景透明，避免遮挡渐变背景 */
  padding: 0 30rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  position: relative;
  z-index: 1;
}

.quick-login {
  display: flex;
  justify-content: center;
  gap: 80rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.15);
}

.quick-item:active {
  background: rgba(255, 255, 255, 0.25);
}

.quick-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
}

.quick-item text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

/* 帮助区域 */
.help-section {
  display: flex;
  justify-content: space-around;
  padding-bottom: 40rpx;
}

.help-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.15);
}

.help-item:active {
  background: rgba(255, 255, 255, 0.25);
}

.help-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.help-item text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

/* 加载遮罩 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5); /* 降低透明度 */
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-content {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx;
  text-align: center;
  min-width: 300rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.2);
}

/* 旋转动画样式替代 loading.gif */
.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid rgba(102, 126, 234, 0.2);
  border-top: 8rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .login-container {
    padding: 30rpx 40rpx;
  }
  
  .header-section {
    margin-bottom: 60rpx;
  }
  
  .login-panel {
    padding: 40rpx 30rpx;
  }
}
