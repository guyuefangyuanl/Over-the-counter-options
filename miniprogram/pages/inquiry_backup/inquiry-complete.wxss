/* 基于HTML设计稿的小程序询价页面样式 */

/* 全局变量定义 */
page {
  --primary-color: #2D8CF0;
  --secondary-color: #19BE6B;
  --warning-color: #FF9900;
  --error-color: #F56C6C;
  --text-primary: #303133;
  --text-secondary: #606266;
  --text-tertiary: #909399;
  --border-color: #E4E7ED;
  --background-color: #F5F7FA;
  --white: #FFFFFF;
  --rise-color: #F56C6C;
  --fall-color: #67C23A;
  --shadow-light: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-medium: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  --radius-small: 8rpx;
  --radius-medium: 12rpx;
  --radius-large: 16rpx;
}

/* 主容器 */
.inquiry-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--background-color);
  position: relative;
}

/* 页面加载状态 */
.page-loading {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.9);
  z-index: 9999;
}

/* 网络状态提示 */
.network-status-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: var(--warning-color);
  color: var(--white);
  text-align: center;
  padding: 8rpx 0;
  font-size: 24rpx;
  z-index: 1000;
}

.network-status-text {
  font-size: 24rpx;
  color: var(--white);
}

/* 错误提示条 */
.error-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: var(--error-color);
  color: var(--white);
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 1001;
}

.error-text {
  font-size: 28rpx;
  color: var(--white);
  flex: 1;
}

/* 顶部固定区域 */
.top-fixed-section {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: var(--white);
  box-shadow: var(--shadow-light);
}

/* 市场指数区域 */
.market-header {
  position: relative;
  padding: 16rpx 32rpx;
  background-color: var(--white);
  border-bottom: 1rpx solid var(--border-color);
}

.market-indexes {
  white-space: nowrap;
  padding-right: 120rpx;
}

.market-index-item {
  display: inline-block;
  margin-right: 40rpx;
  text-align: center;
  min-width: 120rpx;
}

.market-index-item:last-child {
  margin-right: 0;
}

.market-index-name {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.market-index-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.market-index-change {
  font-size: 24rpx;
  font-weight: 500;
}

.market-index-change.is-rise {
  color: var(--rise-color);
}

.market-index-change.is-fall {
  color: var(--fall-color);
}

.current-time {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* Tab导航 */
.tabs-container {
  background-color: var(--white);
}

.primary-tabs {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  height: 88rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.primary-tab-item {
  position: relative;
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-secondary);
  height: 88rpx;
  line-height: 88rpx;
  transition: all 0.3s ease;
}

.primary-tab-item.is-active {
  color: var(--primary-color);
  font-weight: 600;
}

.primary-tab-item.is-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

.tab-hover {
  opacity: 0.7;
}

/* 子Tab导航 */
.sub-tabs {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background-color: var(--white);
}

.sub-tabs-scroll {
  flex: 1;
  white-space: nowrap;
}

.sub-tab-item {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background-color: var(--background-color);
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.sub-tab-item.is-active {
  color: var(--white);
  background-color: var(--primary-color);
}

.edit-group-btn {
  margin-left: 16rpx;
  padding: 8rpx;
  border-radius: var(--radius-small);
  background-color: var(--background-color);
}

.edit-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 搜索和筛选区域 */
.filter-section {
  padding: 24rpx 32rpx;
  background-color: var(--white);
  border-bottom: 1rpx solid var(--border-color);
}

.search-bar {
  position: relative;
  margin-bottom: 24rpx;
}

.search-input {
  width: 100%;
  height: 64rpx;
  padding: 0 80rpx 0 64rpx;
  font-size: 28rpx;
  background-color: var(--background-color);
  border-radius: 32rpx;
  border: none;
  outline: none;
  transition: all 0.3s ease;
}

.search-input:focus {
  background-color: var(--white);
  box-shadow: 0 0 0 2rpx var(--primary-color);
}

.search-input::placeholder {
  color: var(--text-tertiary);
}

.search-icon {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.clear-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  padding: 8rpx;
  opacity: 0.6;
}

.filter-controls {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 24rpx;
}

.filter-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

.filter-options {
  display: flex;
  gap: 8rpx;
}

.filter-option {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background-color: var(--background-color);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.filter-option.is-active {
  color: var(--white);
  background-color: var(--primary-color);
}

.data-info-trigger {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background-color: var(--background-color);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.data-info-trigger:active {
  opacity: 0.7;
}

.info-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.6;
}

/* 主要内容区域 */
.main-content {
  flex: 1;
  background-color: var(--white);
}

/* 产品列表 */
.product-list {
  padding: 0 32rpx;
}

.list-header {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  background-color: var(--white);
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-cell {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  text-align: center;
}

.header-name {
  flex: 1;
  text-align: left;
}

.header-change,
.header-rate {
  width: 120rpx;
}

.header-action {
  width: 160rpx;
}

/* 产品项 */
.product-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.product-item:last-child {
  border-bottom: none;
}

.product-item.item-hover {
  background-color: var(--background-color);
}

.product-item.is-selected {
  background-color: rgba(45, 140, 240, 0.1);
}

.product-basic {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.product-code {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.product-change {
  width: 120rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', monospace;
}

.product-change.is-rise {
  color: var(--rise-color);
}

.product-change.is-fall {
  color: var(--fall-color);
}

.product-rate {
  width: 120rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--primary-color);
  font-family: 'DIN Alternate', monospace;
}

.product-actions {
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
}

.favorite-btn {
  padding: 8rpx;
  border-radius: var(--radius-small);
  transition: all 0.3s ease;
}

.favorite-btn:active {
  background-color: var(--background-color);
}

/* 加载更多 */
.load-more {
  padding: 32rpx;
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--white);
  border-top: 1rpx solid var(--border-color);
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
  padding: 24rpx 32rpx;
  z-index: 100;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.action-buttons van-button {
  flex: 1;
}

.edit-actions {
  display: flex;
  gap: 16rpx;
}

.edit-actions van-button {
  flex: 1;
}

/* 快捷入口 */
.quick-actions {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 99;
}

.quick-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  background-color: var(--white);
  border-radius: 48rpx;
  box-shadow: var(--shadow-medium);
  transition: all 0.3s ease;
}

.quick-action-item.quick-action-hover {
  transform: scale(0.95);
}

.quick-action-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}

.quick-action-text {
  font-size: 20rpx;
  color: var(--text-secondary);
}

/* 弹窗样式 */
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.popup-content {
  flex: 1;
  padding: 32rpx;
}

.popup-footer {
  padding: 24rpx 32rpx 32rpx;
  border-top: 1rpx solid var(--border-color);
}

/* 分组管理弹窗 */
.group-manage-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.group-section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.group-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  font-size: 30rpx;
  color: var(--text-primary);
  transition: all 0.3s ease;
}

.group-item:active {
  background-color: var(--background-color);
}

.group-name {
  flex: 1;
  font-weight: 500;
}

.group-count {
  color: var(--text-secondary);
  margin-right: 16rpx;
}

.group-actions {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

/* 询价表单弹窗 */
.inquiry-form-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: var(--white);
}

.product-info-card {
  background-color: var(--background-color);
  padding: 24rpx;
  border-radius: var(--radius-medium);
  margin-bottom: 32rpx;
}

.product-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.product-code {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.product-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-detail {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.form-section {
  margin-bottom: 48rpx;
}

.form-section .section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 数据说明弹窗 */
.data-info-popup {
  background: var(--white);
  border-radius: var(--radius-large);
  overflow: hidden;
}

.info-content {
  padding: 0 32rpx;
}

.info-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.info-text:last-child {
  margin-bottom: 0;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .market-index-item {
    margin-right: 24rpx;
    min-width: 100rpx;
  }
  
  .primary-tab-item {
    font-size: 28rpx;
  }
  
  .filter-controls {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .product-actions {
    width: 140rpx;
  }
  
  .quick-actions {
    right: 24rpx;
    bottom: 180rpx;
  }
  
  .quick-action-item {
    width: 88rpx;
    height: 88rpx;
  }
}

@media (max-width: 320px) {
  .filter-options {
    flex-wrap: wrap;
  }
  
  .filter-option {
    margin-bottom: 8rpx;
  }
  
  .product-rate {
    width: 100rpx;
    font-size: 26rpx;
  }
  
  .product-actions {
    width: 120rpx;
  }
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.popup-animation {
  animation: slideUp 0.3s ease-out;
}

.fade-in {
  animation: fadeIn 0.3s ease-out;
}
