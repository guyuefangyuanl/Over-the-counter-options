<!--pages/inquiry/inquiry.wxml-->
<wxs src="./inquiry.wxs" module="utils" />

<view class="container" style="position: relative; left: 0rpx; top: -173rpx">
  <!-- 顶部固定内容 -->
  <view class="top-fixed-section">
    
    <market-bar style="position: relative; left: 0rpx; top: -24rpx" indexes="{{marketIndexes}}" currentTime="{{currentTime}}" />

    <!-- 2. Tab导航容器 -->
    <view class="tabs-container">
      
      <view class="tabs-header-row">
        <primary-tabs class="primary-tabs-flex" active="{{activePrimaryTab}}" bind:change="switchPrimaryTabFromComponent" />
        <view class="group-manage-btn" bindtap="showGroupManage" wx:if="{{activePrimaryTab === 'self'}}">
           <van-icon name="ellipsis" size="24px" color="#333" />
        </view>
      </view>
      
      <!-- 子Tab (自选时显示) -->
      <view class="sub-tabs" wx:if="{{activePrimaryTab === 'self'}}">
        <scroll-view class="sub-tabs-scroll" scroll-x show-scrollbar="{{false}}" enable-flex="true">
          <view class="sub-tab-item {{activeSubTab === item.id ? 'is-active' : ''}}" 
                hover-class="press" 
                wx:for="{{systemGroups}}" 
                wx:key="id" 
                bindtap="switchSubTab" 
                data-tab="{{item.id}}">{{item.name}}</view>
          <view class="sub-tab-item {{activeSubTab === item.id ? 'is-active' : ''}}" 
                hover-class="press" 
                wx:for="{{customGroups}}" 
                wx:key="id" 
                bindtap="switchSubTab" 
                data-tab="{{item.id}}">{{item.name}}</view>
        </scroll-view>
      </view>

      <!-- 添加自选和编辑自选按钮 -->
      <view class="favorites-action-buttons" wx:if="{{activePrimaryTab === 'self' && !isEditing}}">
        <view class="action-row">
          <view class="favorites-btn add-favorites-btn" hover-class="press" bindtap="addFavorites">
            <text class="btn-icon">+</text>
            <text class="btn-text">添加自选</text>
          </view>
          <view class="favorites-btn edit-favorites-btn {{!canEditFavorites ? 'is-disabled' : ''}}" 
                hover-class="press" 
                bindtap="editFavorites">
            <text class="btn-text">编辑自选</text>
          </view>
        </view>
      </view>
      

    </view>

    <!-- 3. 搜索与筛选 -->
    <filter-bar keyword="{{searchKeyword}}" activeTerm="{{activeTerm}}" activeStructure="{{activeStructure}}"
                bind:searchinput="onSearchInputFromComponent"
                bind:searchconfirm="openSearchPage"
                bind:clear="onSearchClear"
                bind:opensearch="openSearchPage"
                bind:switchterm="switchTermFromComponent"
                bind:switchstructure="switchStructureFromComponent"
                bind:info="showDataExplanation" />
  </view>

  <!-- 分组管理底部弹层 -->
  <van-popup show="{{showGroupManagePopup}}" 
             round 
             position="bottom" 
             custom-style="height: 60%;" 
             bind:close="onGroupManageClose">
    <view class="group-manage-sheet">
      <view class="sheet-title">全部分组设置</view>
      
      <!-- 顶部操作按钮区域 -->
      <view class="sheet-actions top-actions" style="margin-top: 20rpx; margin-bottom: 10rpx; padding-top: 0;">
        <van-button round type="primary" size="normal" custom-style="width: 330rpx; background: #07c160; border: none;" disabled="{{isEditMode}}" bind:click="openNewGroupDialog">添加分组</van-button>
        <view class="spacer"></view>
        <van-button round type="info" size="normal" custom-style="width: 330rpx;" bind:click="toggleEditMode">{{isEditMode ? '完成' : '编辑分组'}}</van-button>
      </view>

      <view class="sheet-subtitle">显示分组</view>
      <view class="group-list">
        <view class="group-item {{pendingDisplayGroupId === 'all' ? 'active' : ''}} {{isEditMode ? 'edit-mode-disabled' : ''}}" 
                  bindtap="{{!isEditMode ? 'selectPendingGroup' : ''}}" 
                  data-id="all">
          <text>全部 ({{groupCountsById.all || 0}})</text>
          <van-icon name="success" size="20px" wx:if="{{!isEditMode && pendingDisplayGroupId === 'all'}}" />
        </view>
        <view class="group-item {{pendingDisplayGroupId === 'holding' ? 'active' : ''}} {{isEditMode ? 'edit-mode-disabled' : ''}}" 
                  bindtap="{{!isEditMode ? 'selectPendingGroup' : ''}}" 
                  data-id="holding">
          <text>持仓 ({{groupCountsById.holding || 0}})</text>
          <van-icon name="success" size="20px" wx:if="{{!isEditMode && pendingDisplayGroupId === 'holding'}}" />
        </view>
        <block wx:for="{{customGroups}}" wx:key="id">
          <view class="group-item {{pendingDisplayGroupId === item.id ? 'active' : ''}} {{isEditMode ? 'edit-mode' : ''}}" 
                    bindtap="{{!isEditMode ? 'selectPendingGroup' : ''}}" 
                    data-id="{{item.id}}">
            <text>{{item.name}} ({{groupCountsById[item.id] || 0}})</text>
            <van-icon name="success" size="20px" wx:if="{{!isEditMode && pendingDisplayGroupId === item.id}}" />
            <view class="edit-actions" wx:if="{{isEditMode}}">
              <van-icon name="edit" size="18px" bindtap="openRenameGroupDialog" data-id="{{item.id}}" />
              <van-icon name="delete" size="18px" bindtap="openDeleteGroupDialog" data-id="{{item.id}}" />
            </view>
          </view>
        </block>
      </view>
    </view>
  </van-popup>
  
  <!-- 重命名分组弹窗 -->
  <van-popup show="{{showRenameGroupDialog}}" 
             round 
             position="center" 
             bind:close="closeRenameGroupDialog">
    <view class="new-group-dialog">
      <view class="dialog-title">重命名分组</view>
      <van-field value="{{editingGroupName}}" 
                 placeholder="最多20个字" 
                 maxlength="20" 
                 bind:change="onRenameGroupInput" />
      <view class="input-error" wx:if="{{renameGroupError}}">{{renameGroupError}}</view>
      <view class="dialog-actions">
        <van-button size="small" type="default" bind:click="closeRenameGroupDialog">取消</van-button>
        <van-button size="small" type="primary" disabled="{{!canConfirmRename}}" bind:click="confirmRenameGroup">确定</van-button>
      </view>
    </view>
  </van-popup>
  
  <!-- 删除分组确认弹窗 -->
  <van-popup show="{{showDeleteGroupDialog}}" 
             round 
             position="center" 
             bind:close="closeDeleteGroupDialog">
    <view class="new-group-dialog delete-dialog">
      <view class="dialog-title">删除分组</view>
      <view class="delete-content">
        <text wx:if="{{deleteMigrationCount > 0}}">该分组下有{{deleteMigrationCount}}个自选，请选择迁移目标：</text>
        <text wx:else>确认删除该分组？</text>
      </view>
      <picker wx:if="{{deleteMigrationCount > 0 && availableTargetGroups.length > 0}}" 
              value="{{selectedTargetGroupIndex}}" 
              range="{{availableTargetGroups}}" 
              range-key="name"
              bindchange="onTargetGroupChange">
        <view class="picker-view">
          <text>{{targetGroupDisplayText}}</text>
          <van-icon name="arrow-down" size="14px" />
        </view>
      </picker>
      <view class="dialog-actions">
        <van-button size="small" type="default" bind:click="closeDeleteGroupDialog">取消</van-button>
        <van-button size="small" type="danger" bind:click="confirmDeleteGroup">删除</van-button>
      </view>
    </view>
  </van-popup>
  
  <!-- 新建分组弹窗 -->
  <van-popup show="{{showNewGroupDialog}}" 
             round 
             position="center" 
             bind:close="closeNewGroupDialog">
    <view class="new-group-dialog">
      <view class="dialog-title">新建分组</view>
      <van-field value="{{newGroupName}}" 
                 placeholder="最多20个字" 
                 maxlength="20" 
                 bind:change="onNewGroupInput" />
      <view class="input-error" wx:if="{{newGroupError}}">{{newGroupError}}</view>
      <view class="dialog-actions">
        <van-button size="small" type="default" bind:click="closeNewGroupDialog">取消</van-button>
        <van-button size="small" type="primary" disabled="{{!canConfirmNewGroup || newGroupLoading}}" loading="{{newGroupLoading}}" bind:click="confirmNewGroup">确定</van-button>
      </view>
    </view>
  </van-popup>

  <!-- 成功动画提示 -->
  <view wx:if="{{showSuccessAnim}}" class="success-toast">
    <view class="success-toast-inner">添加成功</view>
  </view>

  <!-- 4. 金融卡片式列表 -->
  <scroll-view class="cards-wrapper" scroll-y enable-flex="true" show-scrollbar="{{false}}">
    <cards-list list="{{quoteList}}"
                selectedSet="{{selectedForEditSet}}"
                favoritesById="{{favoritesById}}"
                animatingFavoriteId="{{animatingFavoriteId}}"
                disableFavoriteActions="{{disableFavoriteActions}}"
                isEditing="{{isEditing}}"
                bind:rowtap="onRowTap"
                bind:togglefavorite="toggleFavorite"
                bind:inquiry="showInquiryForm" />
  </scroll-view>

  <!-- 底部固定操作栏 (自选编辑模式) -->
  <view class="bottom-actions" wx:if="{{isEditing}}">
    <van-button round type="default" bind:click="cancelEditing">取消</van-button>
    <van-button round type="primary" bind:click="onBottomConfirm">
      {{isAddingMode ? '添加选中' : '删除选中'}}
    </van-button>
  </view>

  <!-- 底部批量操作栏 -->
  <view class="bottom-batch-actions" 
        wx:if="{{activePrimaryTab === 'self' && !isEditing}}">
    <van-button round type="primary" bind:click="batchInquiry">批量询价</van-button>
    <van-button round type="info" bind:click="quickInquiry">快速询价</van-button>
  </view>

  <!-- 数据说明弹窗 -->
  <van-popup show="{{showDataInfo}}" 
             round 
             position="center" 
             custom-style="width: 80%; max-height: 60%;" 
             bind:close="onDataInfoClose">
    <view class="data-info-popup">
      <view class="data-info-header">
        <text class="data-info-title">数据说明</text>
        <van-icon name="cross" bind:click="onDataInfoClose" />
      </view>
      <scroll-view scroll-y class="data-info-content" enable-flex="true">
        <text class="data-info-text" user-select="true">
          1. 香草看涨期权费率百分比费率，即期权费除以名义本金的比值。例如：期权费率为5%，则买入香草看涨期权100万的名义本金，付出期权费为5万元。
          
          2. 期权费率为参考费率，与交易台报价或成交价可能有区别。
        </text>
      </scroll-view>
      <view class="data-info-footer">
        <van-button type="primary" round block bind:click="onDataInfoClose">我知道了</van-button>
      </view>
    </view>
  </van-popup>

  <!-- 询价表单弹窗 -->
  <van-popup show="{{showInquiryForm}}" 
             round 
             position="bottom" 
             custom-style="height: 80%;" 
             bind:close="hideInquiryForm">
    <view class="inquiry-form-popup">
      <view class="form-header">
        <text class="form-title">产品询价</text>
        <van-icon name="cross" bind:click="hideInquiryForm" />
      </view>
      
      <scroll-view scroll-y class="form-content">
        
        <!-- 产品信息 -->
        <view class="form-section">
          <view class="section-title">产品信息</view>
          <view class="product-info" wx:if="{{inquiryForm.selectedProduct}}">
            <view class="product-name">{{inquiryForm.selectedProduct.name}}</view>
            <view class="product-code">{{inquiryForm.selectedProduct.code}}</view>
            <view class="product-rate">平值费率: {{inquiryForm.selectedProduct.rates['100']}}%</view>
          </view>
        </view>

        <!-- 数量输入 -->
        <view class="form-section">
          <view class="section-title">询价数量</view>
          <van-field
            value="{{inquiryForm.quantity}}"
            placeholder="请输入数量"
            type="number"
            data-field="quantity"
            bind:change="onFormInput"
            error-message="{{formErrors.quantity || ''}}"
            required
          />
        </view>

        <!-- 联系信息 -->
        <view class="form-section">
          <view class="section-title">联系信息</view>
          <van-field
            value="{{inquiryForm.contactName}}"
            placeholder="请输入联系人姓名"
            data-field="contactName"
            bind:change="onFormInput"
            error-message="{{formErrors.contactName || ''}}"
            required
          />
          <van-field
            value="{{inquiryForm.contactPhone}}"
            placeholder="请输入联系电话"
            type="tel"
            data-field="contactPhone"
            bind:change="onFormInput"
            error-message="{{formErrors.contactPhone || ''}}"
            required
          />
          <van-field
            value="{{inquiryForm.contactEmail}}"
            placeholder="请输入邮箱地址（可选）"
            type="email"
            data-field="contactEmail"
            bind:change="onFormInput"
            error-message="{{formErrors.contactEmail || ''}}"
          />
          <van-field
            value="{{inquiryForm.notes}}"
            placeholder="请输入备注信息（可选）"
            type="textarea"
            rows="3"
            data-field="notes"
            bind:change="onFormInput"
          />
        </view>
      </scroll-view>

      <!-- 提交按钮 -->
      <view class="form-footer">
        <van-button 
          type="primary" 
          round 
          block 
          bind:click="submitInquiryForm"
          loading="{{isSubmitting}}"
          disabled="{{isSubmitting}}"
        >
          {{isSubmitting ? '提交中...' : '提交询价'}}
        </van-button>
      </view>
    </view>
  </van-popup>

  <!-- 添加自选弹窗 -->
  <van-popup show="{{showAddFavoritesPopup}}" 
             round 
             position="bottom" 
             custom-style="height: 80%;" 
             bind:close="hideAddFavoritesPopup">
    <view class="add-favorites-popup">
      <view class="popup-header">
        <text class="popup-title">添加自选</text>
        <van-icon name="cross" bind:click="hideAddFavoritesPopup" />
      </view>
      
      <!-- 搜索框 -->
      <view class="search-section">
        <van-field
          value="{{addFavoritesSearch}}"
          placeholder="搜索股票代码或名称"
          left-icon="search"
          bind:input="onAddFavoritesSearch"
          bind:confirm="onAddFavoritesSearchConfirm"
          clearable
        />
      </view>
      
      <!-- 分类筛选 -->
      <view class="category-tabs">
        <view class="category-tab {{addFavoritesCategory === 'all' ? 'is-active' : ''}}" 
              bindtap="switchAddFavoritesCategory" 
              data-category="all">全部</view>
        <view class="category-tab {{addFavoritesCategory === 'industry' ? 'is-active' : ''}}" 
              bindtap="switchAddFavoritesCategory" 
              data-category="industry">行业</view>
        <view class="category-tab {{addFavoritesCategory === 'sector' ? 'is-active' : ''}}" 
              bindtap="switchAddFavoritesCategory" 
              data-category="sector">板块</view>
        <view class="category-tab {{addFavoritesCategory === 'market' ? 'is-active' : ''}}" 
              bindtap="switchAddFavoritesCategory" 
              data-category="market">市场</view>
      </view>
      
      <!-- 股票列表 -->
      <scroll-view scroll-y class="stock-list">
        <block wx:for="{{addFavoritesStockList}}" wx:key="code">
          <view class="stock-item" hover-class="press" bindtap="openOptionQuote" data-id="{{item.id}}">
            <view class="stock-info">
              <view class="stock-name">{{item.name}}</view>
              <view class="stock-code">{{item.code}}</view>
              <view class="stock-category">{{item.category}}</view>
            </view>
            <view class="stock-price-info">
              <view class="stock-price {{item.changePercent > 0 ? 'is-rise' : (item.changePercent < 0 ? 'is-fall' : '')}}">{{item.price}}</view>
              <view class="stock-change {{item.changePercent > 0 ? 'is-rise' : (item.changePercent < 0 ? 'is-fall' : '')}}">{{utils.formatChange(item.changePercent)}}</view>
            </view>
            <view class="stock-action">
              <view wx:if="{{item.favorited}}" class="added-status">
                <van-icon name="success" size="16px" />
                <text>已添加</text>
              </view>
              <view wx:else class="add-btn" hover-class="press" bindtap="quickAddStock" data-id="{{item.id}}">
                <text>+</text>
              </view>
            </view>
          </view>
        </block>
        
        <!-- 空状态 -->
        <view class="empty-state" wx:if="{{!addFavoritesStockList.length}}">
          <image src="../../images/empty.svg" class="empty-icon" mode="aspectFit" lazy-load="true" />
          <text class="empty-text">暂无股票数据</text>
        </view>
      </scroll-view>
      
      <!-- 底部关闭按钮 -->
      <view class="popup-footer">
        <van-button round block bind:click="hideAddFavoritesPopup">关闭</van-button>
      </view>
    </view>
  </van-popup>
</view>