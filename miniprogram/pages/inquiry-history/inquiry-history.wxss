/* pages/inquiry-history/inquiry-history.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f7f8fa;
}

/* 状态筛选 Tab */
.status-tabs {
  background-color: #fff;
  border-bottom: 1rpx solid #e5e5e5;
  padding: 0 16rpx;
}

.tabs-scroll {
  white-space: nowrap;
  height: 80rpx;
  line-height: 80rpx;
}

.tab-item {
  display: inline-block;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #606266;
  position: relative;
  font-weight: 500;
}

.tab-item.is-active {
  color: #409EFF;
  font-weight: 600;
}

.tab-item.is-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #409EFF;
  border-radius: 2rpx;
}

/* 列表区域 */
.list-wrapper {
  flex: 1;
  padding: 16rpx 24rpx;
}

/* 询价卡片 */
.inquiry-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-hover {
  background-color: #f5f7fa;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-product {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-code {
  font-size: 24rpx;
  color: #909399;
  flex-shrink: 0;
}

/* 参数区域 */
.card-params {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.param-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  min-width: 130rpx;
  flex: 1;
}

.param-label {
  font-size: 22rpx;
  color: #909399;
}

.param-value {
  font-size: 26rpx;
  color: #303133;
  font-weight: 500;
}

/* 底部 */
.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 12rpx;
}

.card-time {
  font-size: 24rpx;
  color: #c0c4cc;
}

/* 加载状态 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 24rpx 0;
}

.no-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #c0c4cc;
}

.empty-wrapper {
  padding: 80rpx 0;
}
