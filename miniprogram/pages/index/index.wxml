<view class="container" style="position: relative; left: 0rpx; top: -188rpx">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <van-loading type="spinner" color="#409EFF" size="48rpx" vertical>加载中...</van-loading>
  </view>

  <!-- 主内容 -->
  <view class="main-content" wx:else>
    
    <!-- 搜索区域 -->
    <view class="search-container">
      <view class="search-box">
        <view class="search-icon">🔍</view>
        <input 
          class="search-input" 
          placeholder="搜索" 
          value="{{searchValue}}"
          bindinput="onSearchInput"
          bindfocus="onSearchFocus"
          bindconfirm="onSearch"
        />
        <view class="search-btn" bindtap="onSearch" wx:if="{{searchValue}}">
          搜索
        </view>
      </view>
    </view>

    <!-- 快捷功能 -->
    <view class="section quick-actions-section" wx:if="{{!showSearchResults}}">
      <view class="quick-actions">
        <view 
          class="action-item" 
          wx:for="{{quickActions}}" 
          wx:key="id"
          data-path="{{item.path}}"
          data-params="{{item.params}}"
          bindtap="onQuickActionTap">
          <view wx:if="{{item.id == 1}}" class="action-icon-svg action-icon-fav-selected"></view>
          <image wx:elif="{{item.id == 4}}" class="action-icon-img action-icon-inquiry" src="{{item.icon}}" mode="aspectFit" />
          <image wx:elif="{{item.id == 5}}" class="action-icon-img action-icon-calculator" src="{{item.icon}}" mode="aspectFit" />
          <image wx:else class="action-icon-img" src="{{item.icon}}" mode="aspectFit" />
          <text class="action-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 轮播图卡片 -->
    <view class="banner-container enhanced-card" wx:if="{{!showSearchResults}}">
      <swiper 
        class="banner-swiper"
        indicator-dots="{{swiperConfig.indicatorDots}}"
        autoplay="{{swiperConfig.autoplay}}"
        interval="{{swiperConfig.interval}}"
        duration="{{swiperConfig.duration}}"
        circular="{{swiperConfig.circular}}"
        indicator-color="rgba(255,255,255,0.5)"
        indicator-active-color="#4caf50"
      >
        <swiper-item 
          wx:for="{{swiperImgurls}}" 
          wx:key="id"
          data-index="{{index}}"
          bindtap="onBannerTap"
        >
          <view class="banner-item">
            <view class="banner-placeholder" wx:if="{{!item.loaded && !item.error}}">
              <van-loading type="spinner" color="#409EFF" size="36rpx" />
            </view>
            <view class="banner-error" wx:if="{{item.error}}">
              <van-icon name="photo-fail" size="48rpx" color="#c0c4cc" />
              <text class="banner-error-text">{{item.title || '加载失败'}}</text>
            </view>
            <image 
              class="banner-image {{item.loaded ? 'loaded' : ''}}" 
              src="{{item.url}}" 
              mode="aspectFill"
              bindload="onBannerImageLoad"
              binderror="onBannerImageError"
              data-index="{{index}}"
            />
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- 搜索结果 -->
    <view class="search-results" wx:if="{{showSearchResults}}">
      <view class="search-header">
        <text class="search-title">搜索结果</text>
        <text class="search-cancel" bindtap="onSearchCancel">取消</text>
      </view>

      <view class="searching-state" wx:if="{{isSearching}}">
        <van-loading type="spinner" color="#409EFF" size="36rpx" />
        <text class="searching-text">搜索中...</text>
      </view>

      <view class="result-list" wx:elif="{{searchResults.length > 0}}">
        <view 
          class="result-item" 
          wx:for="{{searchResults}}" 
          wx:key="code"
          data-code="{{item.code}}"
          bindtap="onOptionTap"
        >
          <view class="result-info">
            <text class="result-name">{{item.displayText}}</text>
            <text class="result-code">{{item.code}}</text>
          </view>
        </view>
        <view class="pager" wx:if="{{page * pageSize < totalResults}}">
          <view class="load-more" bindtap="loadMore">加载更多</view>
        </view>
      </view>

      <view class="empty-result" wx:elif="{{!isSearching && searchValue}}">
        <text class="empty-icon">🔍</text>
        <text class="empty-text">未找到相关期权</text>
      </view>
    </view>

    <!-- 首页内容 -->
    <view class="home-content" wx:if="{{!showSearchResults}}">

      <!-- 市场指数 -->
      <view class="section market-indices-section" wx:if="{{marketIndices.length > 0}}">
        <view class="section-header">
          <view class="section-title-wrapper">
            <view class="section-title-icon index-section-icon"></view>
            <text class="section-title">市场指数</text>
          </view>
          <text class="more-btn" data-type="indices" bindtap="onViewMore">></text>
        </view>
        <view class="indices-scroll-wrapper">
          <scroll-view scroll-x class="indices-scroll" enable-flex>
            <view 
              class="index-chip" 
              wx:for="{{marketIndices}}" 
              wx:key="code"
              data-code="{{item.code}}"
              bindtap="onIndexTap"
            >
              <text class="index-chip-name">{{item.name}}</text>
              <text class="index-chip-price">{{item.formattedPrice}}</text>
              <text class="index-chip-change {{item.changeRate.indexOf('-') !== -1 ? 'down' : 'up'}}">{{item.changeRate}}</text>
            </view>
          </scroll-view>
        </view>
      </view>

      <!-- 持仓案例卡片 -->
      <view class="section holding-section">
        <view class="section-header">
          <view class="section-title-wrapper">
            <view class="section-title-icon case-icon"></view>
            <text class="section-title">持仓案例</text>
            <text class="holdings-mock-badge" wx:if="{{holdingsIsMock}}">示例</text>
          </view>
          <text class="more-btn" data-type="holdings" bindtap="onViewMore">查看全部</text>
        </view>

        <view class="holding-card enhanced-card">
          <!-- Tab 导航（与账户页分类对齐：存续中 / 临近到期 / 已完结） -->
          <view class="holding-tabs">
            <view
              class="holding-tab-item {{holdingsData.activeTab === 'active' ? 'active' : ''}}"
              data-tab="active"
              bindtap="onHoldingTabChange"
            >存续中</view>
            <view
              class="holding-tab-item {{holdingsData.activeTab === 'expiring' ? 'active' : ''}}"
              data-tab="expiring"
              bindtap="onHoldingTabChange"
            >临近到期</view>
            <view
              class="holding-tab-item {{holdingsData.activeTab === 'finished' ? 'active' : ''}}"
              data-tab="finished"
              bindtap="onHoldingTabChange"
            >已完结</view>
          </view>

          <!-- 加载错误提示 -->
          <view class="holding-error-tip" wx:if="{{holdingsError}}">
            <text class="holding-error-text">持仓数据暂时无法加载，下拉刷新重试</text>
          </view>

          <!-- 持仓列表 -->
          <block wx:elif="{{holdingsData.filteredPositions.length > 0}}">
            <view class="holding-list {{holdingsAnimate ? 'fade-in' : ''}}">
              <view
                class="holding-item"
                wx:for="{{holdingsData.filteredPositions}}"
                wx:key="id"
                data-id="{{item.id}}"
                data-indexstatus="{{item.indexStatus}}"
                bindtap="onHoldingItemTap"
              >
                <view class="holding-left">
                  <text class="holding-name">{{item.productName}}</text>
                  <view class="holding-row">
                    <text class="holding-code">{{item.productCode}}</text>
                    <text class="holding-dealer">{{item.dealer}}</text>
                  </view>
                  <view class="holding-row">
                    <text class="holding-notional">{{item.notionalWan}}万</text>
                    <text class="holding-days {{item.daysLeft <= 7 && item.status === 'CONTINUING' ? 'expiring-tip' : ''}}"
                      wx:if="{{item.status === 'CONTINUING'}}"
                    >剩{{item.daysLeft}}天</text>
                  </view>
                </view>
                <view class="holding-right">
                  <view class="holding-profit">
                    <text class="profit {{item.pnl >= 0 ? 'up' : 'down'}}">{{item.pnl >= 0 ? '+' : ''}}{{item.pnl}}</text>
                    <text class="profit-rate {{item.pnlRate >= 0 ? 'up' : 'down'}}">{{item.pnlRate >= 0 ? '+' : ''}}{{item.pnlRate}}%</text>
                  </view>
                  <text class="holding-nav-hint">查看详情 ›</text>
                </view>
              </view>
            </view>
          </block>

          <!-- 空状态 -->
          <view class="holding-empty" wx:else>
            <text class="holding-empty-icon">∅</text>
            <text class="holding-empty-text">
              {{holdingsData.activeTab === 'active' ? '暂无存续中持仓' : (holdingsData.activeTab === 'expiring' ? '暂无临近到期持仓' : '暂无已完结持仓')}}
            </text>
            <view class="holding-empty-action" data-type="holdings" bindtap="onViewMore">
              <text>前往账户录入持仓</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 热门产品 -->
      <view class="section">
        <view class="section-header">
          <view class="section-title-wrapper">
             <view class="section-title-icon hot-icon"></view>
             <text class="section-title">热门产品</text>
          </view>
          <text class="more-btn" data-type="options" bindtap="onViewMore">
            >
          </text>
        </view>
        <view class="option-list">
          <view 
            class="option-card enhanced-card" 
            wx:for="{{hotOptions}}" 
            wx:key="code"
            data-code="{{item.code}}"
            data-name="{{item.name}}"
            data-market="{{item.market}}"
            data-structure="{{item.structure}}"
            bindtap="onOptionTap"
          >
            <view class="option-header">
              <view class="option-info-row">
                <view class="market-badge {{item.market === 'SH' ? 'sh' : 'sz'}}">{{item.market || 'SH'}}</view>
                <text class="option-name">{{item.name}}</text>
                <text class="option-code">{{item.code}}</text>
                <text class="option-structure">{{item.structure || '100C6m'}}</text>
              </view>
              <view class="option-tags">
                 <text class="tag-vanilla">香草</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 知识 -->
      <view class="section knowledge-section-outer">
         <view class="section-header knowledge-header">
            <view class="section-title-wrapper">
               <view class="section-title-icon knowledge-icon"></view>
               <text class="section-title">知识</text>
               <view class="knowledge-count-badge" wx:if="{{knowledgeArticles.length > 0}}">{{knowledgeArticles.length}}篇</view>
            </view>
            <text class="more-btn" data-type="knowledge" bindtap="onViewMore">查看全部 ›</text>
         </view>
         <view class="knowledge-list enhanced-card">
            <!-- 加载骨架屏 -->
            <view class="knowledge-skeleton" wx:if="{{knowledgeLoading}}">
              <view class="skeleton-item">
                <view class="skeleton-cover"></view>
                <view class="skeleton-content">
                  <view class="skeleton-title"></view>
                  <view class="skeleton-meta"></view>
                </view>
              </view>
              <view class="skeleton-item">
                <view class="skeleton-cover"></view>
                <view class="skeleton-content">
                  <view class="skeleton-title"></view>
                  <view class="skeleton-meta"></view>
                </view>
              </view>
            </view>

            <!-- 文章列表 -->
            <block wx:for="{{knowledgeArticles}}" wx:key="id" wx:if="{{!knowledgeLoading}}">
              <view class="knowledge-item-new {{index === 0 ? 'first-item' : ''}}" data-id="{{item.id}}" bindtap="onKnowledgeItemTap">
                <!-- 封面图 -->
                <view class="knowledge-cover-wrap" wx:if="{{item.cover}}">
                  <image
                    class="knowledge-cover"
                    src="{{item.cover}}"
                    mode="aspectFill"
                    lazy-load="{{true}}"
                  />
                  <view class="knowledge-cover-placeholder" wx:if="{{!item.coverLoaded}}">
                    <view class="cover-loading"></view>
                  </view>
                </view>
                <!-- 文章内容 -->
                <view class="knowledge-content">
                  <view class="knowledge-header-row">
                    <view class="knowledge-category-tag">{{item.categoryName}}</view>
                    <view class="knowledge-views" wx:if="{{item.views}}">
                      <text class="views-icon">👁</text>
                      <text class="views-count">{{item.views}}</text>
                    </view>
                  </view>
                  <text class="knowledge-title-new">{{item.title}}</text>
                  <text class="knowledge-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
                  <view class="knowledge-footer-row">
                    <text class="knowledge-date">{{item.date}}</text>
                    <view class="knowledge-arrow">
                      <text class="arrow-icon">›</text>
                    </view>
                  </view>
                </view>
              </view>
            </block>

            <!-- 空状态 -->
            <view class="knowledge-empty" wx:if="{{!knowledgeLoading && knowledgeArticles.length === 0}}">
              <text class="empty-icon-text">📚</text>
              <text class="empty-text">暂无知识文章</text>
              <view class="empty-action" data-type="knowledge" bindtap="onViewMore">
                <text>浏览更多内容</text>
              </view>
            </view>
         </view>
      </view>

    </view>
  </view>
</view>
