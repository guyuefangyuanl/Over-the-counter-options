<view class="container">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <van-loading type="spinner" color="#409EFF" size="48rpx" vertical>加载中...</van-loading>
  </view>

  <!-- 主内容 -->
  <view class="main-content" wx:else>
    
    <!-- 搜索区域 -->
    <view class="search-container">
      <view class="search-box">
        <view class="search-icon">🔍</view>
        <input 
          class="search-input" 
          placeholder="搜索" 
          value="{{searchValue}}"
          bindinput="onSearchInput"
          bindfocus="onSearchFocus"
          bindconfirm="onSearch"
        />
        <view class="search-btn" bindtap="onSearch" wx:if="{{searchValue}}">
          搜索
        </view>
      </view>
    </view>

    <!-- 快捷功能 -->
    <view class="section quick-actions-section" wx:if="{{!showSearchResults}}">
      <view class="quick-actions">
        <view 
          class="action-item" 
          wx:for="{{quickActions}}" 
          wx:key="id"
          data-path="{{item.path}}"
          data-params="{{item.params}}"
          bindtap="onQuickActionTap">
          <view wx:if="{{item.id == 1}}" class="action-icon-svg action-icon-fav-selected"></view>
          <image wx:elif="{{item.id == 4}}" class="action-icon-img action-icon-inquiry" src="{{item.icon}}" mode="aspectFit" />
          <image wx:elif="{{item.id == 5}}" class="action-icon-img action-icon-calculator" src="{{item.icon}}" mode="aspectFit" />
          <image wx:else class="action-icon-img" src="{{item.icon}}" mode="aspectFit" />
          <text class="action-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 轮播图卡片 -->
    <view class="banner-container enhanced-card" wx:if="{{!showSearchResults}}">
      <swiper 
        class="banner-swiper"
        indicator-dots="{{swiperConfig.indicatorDots}}"
        autoplay="{{swiperConfig.autoplay}}"
        interval="{{swiperConfig.interval}}"
        duration="{{swiperConfig.duration}}"
        circular="{{swiperConfig.circular}}"
        indicator-color="rgba(255,255,255,0.5)"
        indicator-active-color="#4caf50"
      >
        <swiper-item 
          wx:for="{{swiperImgurls}}" 
          wx:key="id"
          data-index="{{index}}"
          bindtap="onBannerTap"
        >
          <view class="banner-item">
            <view class="banner-placeholder" wx:if="{{!item.loaded && !item.error}}">
              <van-loading type="spinner" color="#409EFF" size="36rpx" />
            </view>
            <view class="banner-error" wx:if="{{item.error}}">
              <van-icon name="photo-fail" size="48rpx" color="#c0c4cc" />
              <text class="banner-error-text">{{item.title || '加载失败'}}</text>
            </view>
            <image 
              class="banner-image {{item.loaded ? 'loaded' : ''}}" 
              src="{{item.url}}" 
              mode="aspectFill"
              bindload="onBannerImageLoad"
              binderror="onBannerImageError"
              data-index="{{index}}"
            />
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- 搜索结果 -->
    <view class="search-results" wx:if="{{showSearchResults}}">
      <view class="search-header">
        <text class="search-title">搜索结果</text>
        <text class="search-cancel" bindtap="onSearchCancel">取消</text>
      </view>

      <view class="searching-state" wx:if="{{isSearching}}">
        <van-loading type="spinner" color="#409EFF" size="36rpx" />
        <text class="searching-text">搜索中...</text>
      </view>

      <view class="result-list" wx:elif="{{searchResults.length > 0}}">
        <view 
          class="result-item" 
          wx:for="{{searchResults}}" 
          wx:key="code"
          data-code="{{item.code}}"
          bindtap="onOptionTap"
        >
          <view class="result-info">
            <text class="result-name">{{item.displayText}}</text>
            <text class="result-code">{{item.code}}</text>
          </view>
        </view>
        <view class="pager" wx:if="{{page * pageSize < totalResults}}">
          <view class="load-more" bindtap="loadMore">加载更多</view>
        </view>
      </view>

      <view class="empty-result" wx:elif="{{!isSearching && searchValue}}">
        <text class="empty-icon">🔍</text>
        <text class="empty-text">未找到相关期权</text>
      </view>
    </view>

    <!-- 首页内容 -->
    <view class="home-content" wx:if="{{!showSearchResults}}">

      <!-- 市场指数 -->
      <view class="section market-indices-section" wx:if="{{marketIndices.length > 0}}">
        <view class="section-header">
          <view class="section-title-wrapper">
            <view class="section-title-icon index-section-icon"></view>
            <text class="section-title">市场指数</text>
          </view>
          <text class="more-btn" data-type="indices" bindtap="onViewMore">></text>
        </view>
        <view class="indices-scroll-wrapper">
          <scroll-view scroll-x class="indices-scroll" enable-flex>
            <view 
              class="index-chip" 
              wx:for="{{marketIndices}}" 
              wx:key="code"
              data-code="{{item.code}}"
              bindtap="onIndexTap"
            >
              <text class="index-chip-name">{{item.name}}</text>
              <text class="index-chip-price">{{item.formattedPrice}}</text>
              <text class="index-chip-change {{item.changeRate.indexOf('-') !== -1 ? 'down' : 'up'}}">{{item.changeRate}}</text>
            </view>
          </scroll-view>
        </view>
      </view>

      <!-- 持仓案例卡片 -->
      <view class="section holding-section">
        <view class="section-header">
          <view class="section-title-wrapper">
            <view class="section-title-icon case-icon"></view>
            <text class="section-title">持仓案例</text>
          </view>
          <text class="more-btn" data-type="holdings" bindtap="onViewMore">></text>
        </view>

        <view class="holding-card enhanced-card">
          <!-- Tab导航 -->
          <view class="holding-tabs">
            <view 
              class="holding-tab-item {{holdingsData.activeTab === 'active' ? 'active' : ''}}"
              data-tab="active"
              bindtap="onHoldingTabChange"
            >存续持仓</view>
            <view 
              class="holding-tab-item {{holdingsData.activeTab === 'expiring' ? 'active' : ''}}"
              data-tab="expiring"
              bindtap="onHoldingTabChange"
            >近期到期</view>
            <view 
              class="holding-tab-item {{holdingsData.activeTab === 'expired' ? 'active' : ''}}"
              data-tab="expired"
              bindtap="onHoldingTabChange"
            >已到期</view>
            <view 
              class="holding-tab-item {{holdingsData.activeTab === 'finished' ? 'active' : ''}}"
              data-tab="finished"
              bindtap="onHoldingTabChange"
            >已完结</view>
          </view>

          <!-- 持仓列表 -->
          <view class="holding-list {{holdingsAnimate ? 'fade-in' : ''}}">
            <block wx:for="{{holdingsData.holdings}}" wx:key="id">
              <view wx:if="{{item.status === holdingsData.activeTab}}" class="holding-item" data-id="{{item.id}}" bindtap="onHoldingItemTap">
                <view class="holding-left">
                  <text class="holding-name">{{item.name}} {{item.structure}}</text>
                  <view class="holding-row">
                     <text class="holding-fee">{{item.feeRate}}</text>
                     <text class="holding-scale">{{item.scale}}</text>
                  </view>
                </view>
                <view class="holding-right">
                  <view class="holding-profit">
                    <text class="profit {{item.profit >= 0 ? 'up' : 'down'}}">{{item.profit >= 0 ? '+' : ''}}{{item.profit}}万</text>
                    <text class="profit-rate {{item.profitRate >= 0 ? 'up' : 'down'}}">{{item.profitRate >= 0 ? '+' : ''}}{{item.profitRate}}%</text>
                  </view>
                </view>
              </view>
            </block>
          </view>
        </view>
      </view>

      <!-- 热门产品 -->
      <view class="section">
        <view class="section-header">
          <view class="section-title-wrapper">
             <view class="section-title-icon hot-icon"></view>
             <text class="section-title">热门产品</text>
          </view>
          <text class="more-btn" data-type="options" bindtap="onViewMore">
            >
          </text>
        </view>
        <view class="option-list">
          <view 
            class="option-card enhanced-card" 
            wx:for="{{hotOptions}}" 
            wx:key="code"
            data-code="{{item.code}}"
            bindtap="onOptionTap"
          >
            <view class="option-header">
              <view class="option-info-row">
                <view class="market-badge {{item.market === 'SH' ? 'sh' : 'sz'}}">{{item.market || 'SH'}}</view>
                <text class="option-name">{{item.name}}</text>
                <text class="option-code">{{item.code}}</text>
                <text class="option-structure">{{item.structure || '100C6m'}}</text>
              </view>
              <view class="option-tags">
                 <text class="tag-vanilla">香草</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 知识 -->
      <view class="section knowledge-section-outer">
         <view class="section-header">
            <view class="section-title-wrapper">
               <view class="section-title-icon knowledge-icon"></view>
               <text class="section-title">知识</text>
            </view>
            <text class="more-btn" data-type="knowledge" bindtap="onViewMore">></text>
         </view>
         <view class="knowledge-list enhanced-card">
            <block wx:for="{{holdingsData.knowledge}}" wx:key="id">
              <view class="knowledge-item" data-id="{{item.id}}" bindtap="onKnowledgeItemTap">
                <view class="knowledge-info">
                  <text class="knowledge-title">{{item.title}}</text>
                  <text class="knowledge-meta">{{item.date}}</text>
                </view>
              </view>
            </block>
         </view>
      </view>

    </view>
  </view>
</view>
