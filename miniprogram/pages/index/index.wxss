/* ====== 全局容器 ====== */
.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: calc(env(safe-area-inset-bottom) + 200rpx);
  box-sizing: border-box;
}

/* ====== 加载状态 ====== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
  border-width: 4rpx;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ====== 主内容区 ====== */
.main-content {
  padding: 16rpx 24rpx 0;
  width: 100%;
  box-sizing: border-box;
}

/* ====== 顶部用户信息 ====== */
.header-section {
  padding: 48rpx 0 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.1);
}

.avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.login-btn {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1.2;
  text-align: left;
}

.login-btn::after {
  border: none;
}

.welcome-text {
  font-size: 24rpx;
  color: #8593a3;
}

/* ====== 搜索区域 ====== */
.search-container {
  margin-bottom: 16rpx;
}
.advanced-toggle{margin-top:12rpx;color:#409EFF;font-size:26rpx}
.advanced-panel{margin-top:12rpx;background:#fff;border-radius:16rpx;padding:12rpx 16rpx;box-shadow:0 4rpx 12rpx rgba(0,0,0,0.06);display:flex;flex-direction:column;gap:10rpx}
.advanced-row{display:flex;align-items:center;gap:12rpx}
.label{color:#666;font-size:26rpx;white-space:nowrap}
.advanced-input{flex:1;height:64rpx;border:1rpx solid #E5E6EB;border-radius:12rpx;padding:0 12rpx;font-size:26rpx}
.radio-item{margin-right:16rpx;color:#666}

.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 12rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-btn {
  padding: 8rpx 24rpx;
  background: #409EFF;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 32rpx;
  margin-left: 12rpx;
}

/* ====== 轮播图卡片 ====== */
.banner-container {
  margin-bottom: 16rpx;
  padding: 0;
  overflow: hidden;
  animation: fade-in 0.5s ease both;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  background: #f5f7fa;
}

.banner-placeholder, .banner-error {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  z-index: 1;
}

.banner-error text {
  color: #909399;
  font-size: 28rpx;
}

.banner-error-text {
  display: block;
  color: #909399;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.banner-error {
  flex-direction: column;
}

.banner-image {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.banner-image.loaded {
  opacity: 1;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.7) 0%,
    rgba(0, 0, 0, 0.4) 50%,
    transparent 100%
  );
  padding: 32rpx 24rpx 24rpx;
}

.banner-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.banner-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  line-height: 1.3;
}

.banner-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

@keyframes fade-in {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ====== 搜索结果 ====== */
.search-results {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  min-height: 400rpx;
}
.search-stats{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx;color:#8593a3}
.page-info{color:#8593a3}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.search-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.search-cancel {
  font-size: 28rpx;
  color: #667eea;
}

.searching-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 24rpx;
}

.searching-text {
  font-size: 28rpx;
  color: #999999;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  transition: background-color 0.2s ease-in-out, transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out, border-color 0.2s ease-in-out;
  border: 2rpx solid transparent;
  will-change: transform, background-color;
}
.result-line{font-size:28rpx;color:#1F2329;letter-spacing:0.3rpx}

.result-item:active {
  background: #e9ecef;
  transform: scale(0.98);
}

.result-item.is-selected {
  background: #EEF6FF;
  border-color: #409EFF;
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.16);
  transform: scale(1.01);
  animation: select-spring 0.26s cubic-bezier(.22,.61,.36,1) both;
}
.result-item.is-selected::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  background: rgba(64,158,255,0.22);
  border-radius: 50%;
  transform: translate(-50%, -50%) scale(0);
  pointer-events: none;
  animation: ripple 0.5s ease-out both;
}

@keyframes select-spring {
  0%   { transform: scale(1); }
  60%  { transform: scale(1.03); }
  100% { transform: scale(1.01); }
}

@keyframes ripple {
  0%   { opacity: 0.35; transform: translate(-50%, -50%) scale(0); }
  70%  { opacity: 0.12; transform: translate(-50%, -50%) scale(18); }
  100% { opacity: 0;    transform: translate(-50%, -50%) scale(22); }
}

.result-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.result-code {
  font-size: 24rpx;
  color: #999999;
}

.result-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.result-price .price {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.result-price .change {
  font-size: 24rpx;
  font-weight: 600;
}

.result-price .change.up {
  color: #f44336;
}

.result-price .change.down {
  color: #4caf50;
}

.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 96rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #666666;
}

.empty-hint {
  font-size: 24rpx;
  color: #999999;
}

.search-suggestions {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.suggestion-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.clear-btn {
  font-size: 24rpx;
  color: #999999;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: #f0f0f0;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
  transition: all 0.3s ease;
}

.tag-item:active {
  background: #e0e0e0;
  transform: scale(0.95);
}

.tag-item.hot {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe5e5 100%);
  color: #f44336;
}

/* ====== 首页内容 ====== */
.home-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 48rpx;
}

/* ====== 市场指数横向滑动卡片 ====== */
.market-indices-section {
  margin-bottom: 0;
}

.index-section-icon {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #409EFF 0%, #66b1ff 100%);
  border-radius: 6rpx;
}

.indices-scroll-wrapper {
  width: 100%;
  overflow: hidden;
}

.indices-scroll {
  white-space: nowrap;
  padding: 4rpx 0 8rpx;
}

.index-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-right: 12rpx;
  min-width: 180rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.index-chip:last-child {
  margin-right: 0;
}

.index-chip:active {
  transform: scale(0.97);
}

.index-chip-name {
  font-size: 24rpx;
  color: #909399;
  font-weight: 500;
  white-space: nowrap;
}

.index-chip-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #303133;
  white-space: nowrap;
}

.index-chip-change {
  font-size: 24rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.index-chip-change.up {
  background: #fef0f0;
  color: #f56c6c;
}

.index-chip-change.down {
  background: #f0f9eb;
  color: #67c23a;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.section-title-icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.case-icon {
  background-image: url('data:image/svg+xml;base64,');
}

.hot-icon {
  background-image: url('data:image/svg+xml;base64,');
}

.knowledge-icon {
  background-image: url('data:image/svg+xml;base64,');
}

.more-btn {
  font-size: 24rpx;
  color: #409EFF;
}

/* ====== 增强卡片样式 ====== */
.enhanced-card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.enhanced-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* ====== 快捷功能 ====== */
.quick-actions-section {
  margin-bottom: 16rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon-img {
  width: 64rpx;
  height: 64rpx;
  object-fit: contain;
}

.action-icon-svg {
  width: 64rpx;
  height: 64rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.action-icon-fav-selected {
  background-image: url('data:image/svg+xml;base64,');
}

.action-icon-stock,
.action-icon-index,
.action-icon-calculator,
.action-icon-inquiry,
.action-icon-etf {
  width: 64rpx;
  height: 64rpx;
  transition: opacity 0.2s ease;
}

.action-item:active .action-icon-index,
.action-item:active .action-icon-calculator,
.action-item:active .action-icon-inquiry,
.action-item:active .action-icon-etf {
  opacity: 0.8;
}

.action-name {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
  line-height: 1.2;
}

/* ====== 持仓案例调整 ====== */
.holding-row {
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
}

.holding-fee, .holding-scale {
  font-size: 22rpx;
  color: #999;
}

/* ====== 热门产品 ====== */
.option-info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.market-badge {
  font-size: 18rpx;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  color: #fff;
}

.market-badge.sh {
  background: #E91E63; /* Pink/Red for SH */
}

.market-badge.sz {
  background: #E91E63; /* Pink/Red for SZ too based on screenshot? Or differ. */
}

.option-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.option-code {
  font-size: 22rpx;
  color: #409EFF; /* Blue for code */
}

.option-structure {
  font-size: 22rpx;
  color: #333;
}

.option-tags {
  display: flex;
}

.tag-vanilla {
  font-size: 20rpx;
  color: #E6A23C; /* Orange/Gold */
  background: #FDF6EC;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

/* ====== 知识区域 ====== */
.knowledge-section-outer {
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

/* 知识模块响应式布局 */
.knowledge-header {
  margin-top: 16rpx;
}

.knowledge-count-badge {
  display: inline-block;
  font-size: 20rpx;
  color: var(--primary-color);
  background: rgba(64, 158, 255, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  margin-left: 8rpx;
  vertical-align: middle;
}

.knowledge-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  min-height: 280rpx;
}

/* 骨架屏样式 */
.knowledge-skeleton {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-item {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
}

.skeleton-cover {
  width: 120rpx;
  height: 90rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skeleton-title {
  height: 32rpx;
  width: 70%;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 4rpx;
}

.skeleton-meta {
  height: 24rpx;
  width: 40%;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 4rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 新版知识文章卡片 */
.knowledge-item-new {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
  transition: all 0.2s ease;
}

.knowledge-item-new.first-item {
  padding-top: 0;
}

.knowledge-item-new:last-child {
  border-bottom: none;
}

.knowledge-item-new:active {
  background: #f5f7fa;
  border-radius: 12rpx;
  margin: 0 -8rpx;
  padding: 20rpx 8rpx;
}

/* 封面图 */
.knowledge-cover-wrap {
  width: 120rpx;
  height: 90rpx;
  flex-shrink: 0;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f7fa;
}

.knowledge-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.knowledge-cover-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-loading {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e0e0e0;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* 文章内容 */
.knowledge-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.knowledge-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.knowledge-category-tag {
  font-size: 20rpx;
  color: var(--primary-color);
  background: rgba(64, 158, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.knowledge-views {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #909399;
}

.views-icon {
  font-size: 20rpx;
}

.views-count {
  font-size: 22rpx;
}

.knowledge-title-new {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.knowledge-summary {
  font-size: 24rpx;
  color: #606266;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.knowledge-footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.knowledge-date {
  font-size: 22rpx;
  color: #909399;
}

.knowledge-arrow {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 32rpx;
  color: #c0c4cc;
  font-weight: 300;
}

/* 空状态 */
.knowledge-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 16rpx;
}

.empty-icon-text {
  font-size: 64rpx;
  color: #dcdfe6;
}

.empty-text {
  font-size: 28rpx;
  color: #909399;
}

.empty-action {
  margin-top: 8rpx;
  padding: 12rpx 32rpx;
  background: rgba(64, 158, 255, 0.1);
  border-radius: 32rpx;
  color: var(--primary-color);
  font-size: 26rpx;
}

/* 响应式适配 */
@media (max-width: 360px) {
  .knowledge-cover-wrap {
    width: 100rpx;
    height: 75rpx;
  }

  .knowledge-title-new {
    font-size: 26rpx;
  }

  .knowledge-summary {
    font-size: 22rpx;
  }
}
.index-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ====== 持仓案例板块 ====== */
.holding-section {
  margin: 12rpx 0 16rpx;
}

.holding-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

/* Tab 导航（三栏，与账户页对齐） */
.holding-tabs {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #f0f2f5;
  margin-bottom: 16rpx;
}

.holding-tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #909399;
  border-bottom: 4rpx solid transparent;
  margin-bottom: -2rpx;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.holding-tab-item.active {
  color: #1677FF;
  border-bottom-color: #1677FF;
  font-weight: 600;
}

/* 持仓列表 */
.holding-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  transition: opacity 0.3s ease;
}

.holding-list.fade-in {
  animation: holdingFadeIn 0.25s ease both;
}

@keyframes holdingFadeIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.holding-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f5f7fa;
  transition: background 0.15s ease;
}

.holding-item:last-child {
  border-bottom: none;
}

.holding-item:active {
  background: #f0f6ff;
  border-radius: 12rpx;
}

.holding-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.holding-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.holding-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.holding-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.holding-code {
  font-size: 22rpx;
  color: #409EFF;
}

.holding-dealer {
  font-size: 22rpx;
  color: #909399;
}

.holding-notional {
  font-size: 24rpx;
  color: #606266;
  font-weight: 500;
}

.holding-days {
  font-size: 22rpx;
  color: #909399;
  background: #f5f7fa;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.holding-days.expiring-tip {
  color: #E6A23C;
  background: #fdf6ec;
}

.holding-profit {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.profit {
  font-size: 28rpx;
  font-weight: 700;
}

.profit.up  { color: #F56C6C; }
.profit.down { color: #67C23A; }

.profit-rate {
  font-size: 22rpx;
  font-weight: 500;
}

.profit-rate.up  { color: #F56C6C; }
.profit-rate.down { color: #67C23A; }

.holding-nav-hint {
  font-size: 20rpx;
  color: #c0c4cc;
}

/* 示例数据角标 */
.holdings-mock-badge {
  font-size: 20rpx;
  color: #E6A23C;
  background: #fdf6ec;
  border: 1rpx solid #f5dab1;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
  vertical-align: middle;
  line-height: 1.6;
}

/* 错误提示 */
.holding-error-tip {
  padding: 32rpx 0;
  text-align: center;
}

.holding-error-text {
  font-size: 26rpx;
  color: #909399;
}

/* 空状态 */
.holding-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
  gap: 12rpx;
}

.holding-empty-icon {
  font-size: 64rpx;
  color: #dcdfe6;
}

.holding-empty-text {
  font-size: 28rpx;
  color: #909399;
}

.holding-empty-action {
  margin-top: 8rpx;
  padding: 12rpx 32rpx;
  background: #ecf5ff;
  border-radius: 32rpx;
  color: #1677FF;
  font-size: 26rpx;
}

.knowledge-section {
  margin-top: 12rpx;
  border-top: 1rpx solid #f2f3f5;
  padding-top: 12rpx;
}

.knowledge-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 8rpx;
  transition: transform 0.2s ease;
}

.knowledge-item:active {
  transform: scale(0.98);
}

.knowledge-icon {
  font-size: 32rpx;
}

.knowledge-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 0 12rpx;
}

.knowledge-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.knowledge-meta {
  font-size: 24rpx;
  color: #999999;
}

.knowledge-arrow {
  font-size: 28rpx;
  color: #909399;
}

.index-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.index-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.index-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.index-code {
  font-size: 24rpx;
  color: #999999;
}

.index-data {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.index-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.index-change {
  font-size: 26rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.index-change.up {
  background: #ffebee;
  color: #f44336;
}

.index-change.down {
  background: #e8f5e9;
  color: #4caf50;
}

/* ====== 热门期权 ====== */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-card {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.option-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.option-code {
  font-size: 22rpx;
  color: #999999;
}

.option-type {
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.option-type.call {
  background: #ffebee;
  color: #f44336;
}

.option-type.put {
  background: #e8f5e9;
  color: #4caf50;
}

.option-data {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.data-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
}

.data-label {
  font-size: 24rpx;
  color: #999999;
}

.data-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.data-value.price {
  font-size: 32rpx;
  color: #333333;
}

.data-value.up {
  color: #f44336;
}

.data-value.down {
  color: #4caf50;
}

/* ====== 响应式适配 ====== */
@media (max-width: 360px) {
  .banner-swiper {
    height: 300rpx;
  }
  
  .banner-title {
    font-size: 28rpx;
  }
  
  .banner-desc {
    font-size: 22rpx;
  }

  .quick-actions {
    grid-template-columns: repeat(3, 1fr);
    gap: 16rpx;
    padding: 24rpx 16rpx;
  }

  .action-icon {
    width: 80rpx;
    height: 80rpx;
    font-size: 40rpx;
  }

  .action-name {
    font-size: 22rpx;
  }
}

/* ====== 动画效果 ====== */
@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.index-card,
.option-card {
  animation: slideIn 0.3s ease both;
}

.index-card:nth-child(1) { animation-delay: 0.05s; }
.index-card:nth-child(2) { animation-delay: 0.1s; }
.index-card:nth-child(3) { animation-delay: 0.15s; }

.option-card:nth-child(1) { animation-delay: 0.05s; }
.option-card:nth-child(2) { animation-delay: 0.1s; }
.option-card:nth-child(3) { animation-delay: 0.15s; }
.option-card:nth-child(4) { animation-delay: 0.2s; }
.option-card:nth-child(5) { animation-delay: 0.25s; }
.pager{display:flex;justify-content:center;margin-top:12rpx}
.load-more{padding:12rpx 24rpx;border:1rpx solid #409EFF;color:#409EFF;border-radius:12rpx}
