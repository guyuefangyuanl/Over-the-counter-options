/* ====== 原型设计规范 ====== */
/*
 * 颜色规范：
 * - 主色蓝：#409EFF
 * - 底部导航激活蓝：#389BFF
 * - 底部导航默认黑：#2C2C2C / #474747
 * - 文字主色：#333333
 * - 文字次要：#999999 / #909399
 * 
 * 字体规范：
 * - 主标题：PingFang SC Regular 20px #333333
 * - 标题：PingFang SC Regular 18px #333333
 * - 小标题：PingFang SC Regular 16px #333333
 * - 正文：PingFang SC Regular 14px #333333
 */

/* ====== CSS变量定义 ====== */
page {
  --color-primary: #409EFF;
  --color-primary-light: #389BFF;
  --color-text-primary: #333333;
  --color-text-regular: #606266;
  --color-text-secondary: #909399;
  --color-success: #67C23A;
  --color-danger: #F56C6C;
  --color-warning: #E6A23C;
  --bg-color: #F5F7FA;
  --bg-card: #FFFFFF;
  --font-size-title: 40rpx;    /* 20px */
  --font-size-subtitle: 36rpx; /* 18px */
  --font-size-small-title: 32rpx; /* 16px */
  --font-size-base: 28rpx;     /* 14px */
  --font-size-small: 26rpx;    /* 13px */
  --font-size-mini: 24rpx;     /* 12px */
}

/* ====== 全局容器 ====== */
.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: calc(env(safe-area-inset-bottom) + 200rpx);
  box-sizing: border-box;
}

/* ====== 加载状态 ====== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  gap: 24rpx;
}

/* ====== 主内容区 ====== */
.main-content {
  padding: 16rpx 24rpx 0;
  width: 100%;
  box-sizing: border-box;
}

/* ====== 顶部标题和搜索 ====== */
.header-section {
  padding: 24rpx 0 16rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.app-title {
  font-size: var(--font-size-subtitle);
  font-weight: 600;
  color: var(--color-text-primary);
  font-family: 'PingFang SC', sans-serif;
}

.search-container {
  margin-bottom: 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
}

.search-btn {
  padding: 8rpx 24rpx;
  background: var(--color-primary);
  color: var(--bg-card);
  font-size: var(--font-size-small);
  font-weight: 600;
  border-radius: 32rpx;
  margin-left: 12rpx;
}

/* ====== 轮播图卡片 ====== */
.banner-container {
  margin-bottom: 16rpx;
  padding: 0;
  overflow: hidden;
  position: relative;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  background: var(--bg-color);
}

.banner-placeholder, .banner-error {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
  z-index: 1;
}

.banner-error {
  flex-direction: column;
}

.banner-error-text {
  display: block;
  color: var(--color-text-secondary);
  font-size: var(--font-size-mini);
  margin-top: 8rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.banner-image.loaded {
  opacity: 1;
}

/* 横线指示器样式 */
.banner-indicators {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 0;
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.indicator-line {
  width: 40rpx;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 3rpx;
  transition: all 0.3s ease;
}

.indicator-line.active {
  background: var(--bg-card);
  width: 60rpx;
}

/* ====== 快捷功能 ====== */
.quick-actions-section {
  margin-bottom: 16rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon-img {
  width: 64rpx;
  height: 64rpx;
  object-fit: contain;
}

.action-icon-svg {
  width: 64rpx;
  height: 64rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.action-icon-fav-selected {
  background-image: url('data:image/svg+xml;base64,');
}

.action-name {
  font-size: var(--font-size-mini);
  color: var(--color-text-primary);
  text-align: center;
  font-weight: 500;
  line-height: 1.2;
}

/* ====== 搜索结果 ====== */
.search-results {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  min-height: 400rpx;
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.search-title {
  font-size: var(--font-size-subtitle);
  font-weight: 700;
  color: var(--color-text-primary);
}

.search-cancel {
  font-size: var(--font-size-base);
  color: var(--color-primary);
}

.searching-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 24rpx;
}

.searching-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
  transition: background-color 0.2s ease-in-out, transform 0.2s ease-in-out;
  border: 2rpx solid transparent;
}

.result-item:active {
  background: #e9ecef;
  transform: scale(0.98);
}

.result-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.result-code {
  font-size: var(--font-size-mini);
  color: var(--color-text-secondary);
}

.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 96rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #666666;
}

/* ====== 首页内容 ====== */
.home-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 48rpx;
}

/* ====== 区块通用样式 ====== */
.section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.section-title {
  font-size: var(--font-size-small-title);
  font-weight: 700;
  color: var(--color-text-primary);
  font-family: 'PingFang SC', sans-serif;
}

.section-title-icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.index-section-icon {
  background: linear-gradient(135deg, var(--color-primary) 0%, #66b1ff 100%);
  border-radius: 6rpx;
}

.case-icon {
  background-image: url('data:image/svg+xml;base64,');
}

.hot-icon {
  background-image: url('data:image/svg+xml;base64,');
}

.knowledge-icon {
  background-image: url('data:image/svg+xml;base64,');
}

.more-btn {
  font-size: var(--font-size-mini);
  color: var(--color-primary);
}

/* ====== 增强卡片样式 ====== */
.enhanced-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.enhanced-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* ====== 市场指数 ====== */
.market-indices-section {
  margin-bottom: 0;
}

.indices-scroll-wrapper {
  width: 100%;
  overflow: hidden;
}

.indices-scroll {
  white-space: nowrap;
  padding: 4rpx 0 8rpx;
}

.index-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-right: 12rpx;
  min-width: 180rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.index-chip:last-child {
  margin-right: 0;
}

.index-chip:active {
  transform: scale(0.97);
}

.index-chip-name {
  font-size: var(--font-size-mini);
  color: var(--color-text-secondary);
  font-weight: 500;
  white-space: nowrap;
}

.index-chip-price {
  font-size: var(--font-size-subtitle);
  font-weight: 700;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.index-chip-change {
  font-size: var(--font-size-mini);
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.index-chip-change.up {
  background: #fef0f0;
  color: var(--color-danger);
}

.index-chip-change.down {
  background: #f0f9eb;
  color: var(--color-success);
}

/* ====== 持仓案例板块 ====== */
.holding-section {
  margin: 12rpx 0 16rpx;
}

.holding-card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* Tab 导航（原型样式） */
.holding-tabs {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #f0f2f5;
  margin-bottom: 16rpx;
}

.holding-tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--font-size-small);
  color: var(--color-text-secondary);
  border-bottom: 4rpx solid transparent;
  margin-bottom: -2rpx;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.holding-tab-item.active {
  color: var(--color-primary);
  border-bottom-color: var(--color-primary);
  font-weight: 600;
}

/* 持仓表格样式 */
.holding-list {
  display: flex;
  flex-direction: column;
  transition: opacity 0.3s ease;
}

.holding-list.fade-in {
  animation: holdingFadeIn 0.25s ease both;
}

@keyframes holdingFadeIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 表头 */
.holding-table-header {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
  background: #FAFAFA;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.table-header-cell {
  font-size: var(--font-size-mini);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.holding-item {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f5f7fa;
  transition: background 0.15s ease;
}

.holding-item:last-child {
  border-bottom: none;
}

.holding-item:active {
  background: #f0f6ff;
  border-radius: 12rpx;
}

/* 单元格布局 */
.holding-cell {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cell-first {
  flex: 1.2;
  min-width: 0;
}

.cell-second {
  flex: 1;
  min-width: 0;
  align-items: center;
}

.cell-third {
  flex: 1;
  min-width: 0;
  align-items: flex-end;
}

.holding-name {
  font-size: var(--font-size-small);
  font-weight: 600;
  color: var(--color-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.holding-structure {
  font-size: var(--font-size-mini);
  color: var(--color-primary);
}

.holding-fee {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  font-weight: 500;
}

.holding-scale {
  font-size: var(--font-size-mini);
  color: var(--color-text-secondary);
}

.profit {
  font-size: var(--font-size-small);
  font-weight: 700;
}

.profit.up  { color: var(--color-danger); }
.profit.down { color: var(--color-success); }

.profit-rate {
  font-size: var(--font-size-mini);
  font-weight: 500;
}

/* 示例数据角标 */
.holdings-mock-badge {
  font-size: 20rpx;
  color: var(--color-warning);
  background: #fdf6ec;
  border: 1rpx solid #f5dab1;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
  vertical-align: middle;
  line-height: 1.6;
}

/* 错误提示 */
.holding-error-tip {
  padding: 32rpx 0;
  text-align: center;
}

.holding-error-text {
  font-size: var(--font-size-small);
  color: var(--color-text-secondary);
}

/* 空状态 */
.holding-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
  gap: 12rpx;
}

.holding-empty-icon {
  font-size: 64rpx;
  color: #dcdfe6;
}

.holding-empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.holding-empty-action {
  margin-top: 8rpx;
  padding: 12rpx 32rpx;
  background: #ecf5ff;
  border-radius: 32rpx;
  color: var(--color-primary);
  font-size: var(--font-size-small);
}

/* ====== 热门产品 ====== */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-card {
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option-info-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

/* 市场徽章 - 原型样式 */
.market-badge {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  color: #fff;
  font-weight: 500;
}

.market-badge.sh {
  background: var(--color-primary);
}

.market-badge.sz {
  background: var(--color-primary);
}

.option-name {
  font-size: var(--font-size-small);
  font-weight: 600;
  color: var(--color-text-primary);
}

.option-code {
  font-size: var(--font-size-mini);
  color: var(--color-primary);
}

.option-structure-tag {
  font-size: var(--font-size-mini);
  color: var(--color-text-primary);
  padding: 4rpx 12rpx;
  background: #f5f7fa;
  border-radius: 6rpx;
}

.option-footer {
  display: flex;
  justify-content: flex-end;
}

.vanilla-tag {
  font-size: 20rpx;
  color: var(--color-warning);
  background: #FDF6EC;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* ====== 知识区域 ====== */
.knowledge-section-outer {
  margin-top: 16rpx;
  margin-bottom: 24rpx;
}

.knowledge-header {
  margin-top: 16rpx;
}

.knowledge-count-badge {
  display: inline-block;
  font-size: 20rpx;
  color: var(--color-primary);
  background: rgba(64, 158, 255, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  margin-left: 8rpx;
  vertical-align: middle;
}

.knowledge-list {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  min-height: 280rpx;
}

/* 骨架屏样式 */
.knowledge-skeleton {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-item {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
}

.skeleton-cover {
  width: 120rpx;
  height: 90rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
}

.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skeleton-title {
  height: 32rpx;
  width: 70%;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 4rpx;
}

.skeleton-meta {
  height: 24rpx;
  width: 40%;
  background: linear-gradient(90deg, #f2f3f5 25%, #e6e8eb 50%, #f2f3f5 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 4rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 新版知识文章卡片 */
.knowledge-item-new {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
  transition: all 0.2s ease;
}

.knowledge-item-new.first-item {
  padding-top: 0;
}

.knowledge-item-new:last-child {
  border-bottom: none;
}

.knowledge-item-new:active {
  background: #f5f7fa;
  border-radius: 12rpx;
  margin: 0 -8rpx;
  padding: 20rpx 8rpx;
}

/* 封面图 */
.knowledge-cover-wrap {
  width: 120rpx;
  height: 90rpx;
  flex-shrink: 0;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f7fa;
}

.knowledge-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.knowledge-cover-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-loading {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #e0e0e0;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 文章内容 */
.knowledge-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.knowledge-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.knowledge-category-tag {
  font-size: 20rpx;
  color: var(--color-primary);
  background: rgba(64, 158, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.knowledge-views {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.views-icon {
  font-size: 20rpx;
}

.views-count {
  font-size: 22rpx;
}

.knowledge-title-new {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.knowledge-summary {
  font-size: var(--font-size-mini);
  color: var(--color-text-regular);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.knowledge-footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.knowledge-date {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.knowledge-arrow {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 32rpx;
  color: #c0c4cc;
  font-weight: 300;
}

/* 空状态 */
.knowledge-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 16rpx;
}

.empty-icon-text {
  font-size: 64rpx;
  color: #dcdfe6;
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.empty-action {
  margin-top: 8rpx;
  padding: 12rpx 32rpx;
  background: rgba(64, 158, 255, 0.1);
  border-radius: 32rpx;
  color: var(--color-primary);
  font-size: var(--font-size-small);
}

/* ====== 响应式适配 ====== */
@media (max-width: 360px) {
  .banner-swiper {
    height: 300rpx;
  }

  .quick-actions {
    grid-template-columns: repeat(3, 1fr);
    gap: 16rpx;
    padding: 24rpx 16rpx;
  }

  .knowledge-cover-wrap {
    width: 100rpx;
    height: 75rpx;
  }

  .knowledge-title-new {
    font-size: 26rpx;
  }
}

/* ====== 分页加载 ====== */
.pager {
  display: flex;
  justify-content: center;
  margin-top: 12rpx;
}

.load-more {
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: 12rpx;
  font-size: var(--font-size-small);
}