# ===========================================
# 生产环境配置 - 请勿提交到Git
# ===========================================

# 应用配置
NODE_ENV=production
FLASK_PORT=5002
FLASK_APP=app.py

# 【重要】安全密钥 - 必须修改
# 使用以下命令生成新密钥：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=4a8f9c2b1e7d3f6a9c8b5e2d1f4a7b9c3e6d8f1a4b7c9e2d5f8a1b4c7e9f2d5
JWT_SECRET=7b3e9f2c5a8d1f4b7e9c2a5d8f1b4e7a9c2d5f8b1e4a7c9d2f5b8e1a4c7d9f2

# JWT配置
JWT_EXPIRES_SECONDS=86400

# 跨域配置
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 数据库配置
MONGO_URI=mongodb://localhost:27017/option_data
DATABASE_NAME=option_trading

# 微信云开发配置（必填）
WX_APPID=wx83166cb97bfc0d4c
WX_SECRET=请从微信公众平台获取
WX_CLOUD_ENV=请填入云开发环境ID
WX_VERIFY_SSL=true

# 管理员账号配置（请修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请修改为强密码至少16字符
ADMIN_ROLE=admin

# API配置
API_BASE_URL=https://api.your-domain.com/api/v1

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/production.log

# 数据源配置
STOCK_DATA_SOURCE=akshare
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# API限流
API_RATE_LIMIT=100

# 第三方API密钥
AKSHARE_TOKEN=
