{
  "env": {
    "es6": true,
    "browser": true,
    "node": true
  },
  "globals": {
    "wx": "readonly",
    "App": "readonly",
    "Page": "readonly",
    "getApp": "readonly"
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", {"args": "none"}],
    "no-undef": "error",
    "no-console": ["warn", {"allow": ["warn", "error"]}]
  }
}
