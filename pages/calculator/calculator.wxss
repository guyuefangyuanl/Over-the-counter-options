/* 期权计算器页面样式 */
.calculator-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.subsection-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
}

/* 计算器类型选择 */
.calculator-type {
  background: white;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.picker-display {
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 15rpx;
  color: #333;
  font-size: 28rpx;
  text-align: center;
}

/* 输入参数区域 */
.input-section {
  background: white;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.input-group {
  margin-bottom: 25rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
  font-weight: 500;
}

.input-field {
  width: 100%;
  padding: 25rpx;
  background: #f8f8f8;
  border-radius: 15rpx;
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #007aff;
  background: white;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.clear-btn, .calculate-btn {
  flex: 1;
  padding: 25rpx;
  border-radius: 15rpx;
  font-size: 28rpx;
  border: none;
}

.clear-btn {
  background: #f8f8f8;
  color: #666;
}

.calculate-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

/* 计算结果区域 */
.results-section {
  background: white;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

/* 主要结果卡片 */
.result-card.main-result {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
  padding: 40rpx;
  border-radius: 20rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.result-card .result-label {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 15rpx;
  display: block;
}

.result-card .result-value.main {
  font-size: 48rpx;
  font-weight: bold;
}

/* 基本信息网格 */
.result-grid {
  display: flex;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.result-item {
  flex: 1;
  background: #f8f8f8;
  padding: 25rpx;
  border-radius: 15rpx;
  text-align: center;
}

.result-item .result-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.result-item .result-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* 希腊字母区域 */
.greeks-section {
  border-top: 2rpx solid #f0f0f0;
  padding-top: 25rpx;
}

.greeks-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.greek-item {
  width: calc(50% - 7.5rpx);
  background: #f8f8f8;
  padding: 25rpx;
  border-radius: 15rpx;
  text-align: center;
}

.greek-label {
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.greek-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #007aff;
  margin-bottom: 8rpx;
  display: block;
}

.greek-desc {
  font-size: 20rpx;
  color: #999;
}

/* 历史记录区域 */
.history-section {
  background: white;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.history-item {
  background: #f8f8f8;
  padding: 25rpx;
  border-radius: 15rpx;
  transition: background-color 0.2s ease;
}

.history-item:active {
  background-color: #e8e8e8;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.history-time {
  font-size: 22rpx;
  color: #666;
}

.delete-btn {
  background: #ff3b30;
  color: white;
  border: none;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.history-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-params {
  font-size: 24rpx;
  color: #333;
}

.history-result {
  font-size: 26rpx;
  font-weight: bold;
  color: #007aff;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .calculator-container {
    padding: 15rpx;
  }
  
  .input-section, .results-section, .history-section {
    padding: 25rpx;
  }
  
  .result-grid {
    flex-direction: column;
  }
  
  .result-item {
    margin-bottom: 10rpx;
  }
  
  .greek-item {
    width: 100%;
  }
}