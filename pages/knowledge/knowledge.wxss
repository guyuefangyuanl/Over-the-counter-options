/* pages/knowledge/knowledge.wxss */
.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #f0f0f0;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.placeholder {
  width: 64rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 24rpx;
  background: #ffffff;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 48rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 32rpx;
  line-height: 1;
  margin-right: 16rpx;
  opacity: 0.6;
  display: inline-block;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-btn {
  padding: 8rpx 24rpx;
  background: #409EFF;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 32rpx;
  margin-left: 12rpx;
}

/* 分类标签 */
.category-tabs {
  background: #ffffff;
  padding: 0 24rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.tabs-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #f5f7fa;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #409EFF;
  color: #ffffff;
}

.tab-item:last-child {
  margin-right: 0;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #409EFF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-spinner.small {
  width: 36rpx;
  height: 36rpx;
  border-width: 3rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
  margin-top: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 知识列表 */
.knowledge-list {
  padding: 24rpx;
}

.knowledge-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.knowledge-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.knowledge-cover {
  position: relative;
  width: 100%;
  height: 280rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.category-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 8rpx 20rpx;
  background: rgba(64, 158, 255, 0.9);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.knowledge-content {
  padding: 24rpx;
}

.knowledge-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.knowledge-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
}

.external-link-badge {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.knowledge-summary {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.knowledge-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.meta-date {
  font-size: 24rpx;
  color: #999999;
}

.meta-views {
  font-size: 24rpx;
  color: #999999;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.meta-icon {
  font-size: 24rpx;
}

.meta-right {
  display: flex;
  align-items: center;
}

.read-more {
  font-size: 26rpx;
  color: #409EFF;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 160rpx;
  line-height: 1;
  margin-bottom: 24rpx;
  opacity: 0.5;
  display: inline-block;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999999;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
}

.load-more-text {
  font-size: 26rpx;
  color: #999999;
  padding: 16rpx 32rpx;
  background: #ffffff;
  border-radius: 32rpx;
}

/* 到底提示 */
.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx;
}

.no-more text {
  font-size: 24rpx;
  color: #cccccc;
}
