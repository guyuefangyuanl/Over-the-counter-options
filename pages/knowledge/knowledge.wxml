<!--pages/knowledge/knowledge.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="back-btn" bindtap="goBack">
      <image src="/images/back.png" class="back-icon" mode="aspectFit"/>
    </view>
    <text class="page-title">知识中心</text>
    <view class="placeholder"></view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索知识文章..." 
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <view class="search-btn" bindtap="onSearch" wx:if="{{searchKeyword}}">
        搜索
      </view>
    </view>
  </view>

  <!-- 分类标签 -->
  <view class="category-tabs">
    <scroll-view class="tabs-scroll" scroll-x="true" show-scrollbar="false">
      <view 
        class="tab-item {{activeCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryChange"
      >
        {{item.name}}
      </view>
    </scroll-view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 知识列表 -->
  <view class="knowledge-list" wx:else>
    <view 
      class="knowledge-card"
      wx:for="{{filteredKnowledgeList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onKnowledgeTap"
    >
      <!-- 文章封面 -->
      <view class="knowledge-cover" wx:if="{{item.cover}}">
        <image src="{{item.cover}}" mode="aspectFill" class="cover-image"/>
        <view class="category-tag">{{item.categoryName}}</view>
      </view>
      
      <!-- 文章内容 -->
      <view class="knowledge-content">
        <view class="knowledge-title-row">
          <view class="knowledge-title">{{item.title}}</view>
          <text class="external-link-badge" wx:if="{{item.type === 'external'}}">Gitee</text>
        </view>
        <view class="knowledge-summary" wx:if="{{item.summary}}">{{item.summary}}</view>
        
        <!-- 文章元信息 -->
        <view class="knowledge-meta">
          <view class="meta-left">
            <text class="meta-date">{{item.date}}</text>
            <text class="meta-views" wx:if="{{item.views}}">
              <text class="meta-icon">👁</text> {{item.views}}
            </text>
          </view>
          <view class="meta-right">
            <text class="read-more">阅读全文 ></text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredKnowledgeList.length === 0}}">
      <text class="empty-icon">📑</text>
      <text class="empty-text">暂无相关文章</text>
      <text class="empty-hint">换个关键词试试</text>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{!loading && filteredKnowledgeList.length > 0 && hasMore}}">
    <view class="loading-spinner small" wx:if="{{loadingMore}}"></view>
    <text class="load-more-text" bindtap="loadMore" wx:else>点击加载更多</text>
  </view>

  <!-- 到底提示 -->
  <view class="no-more" wx:if="{{!hasMore && filteredKnowledgeList.length > 0}}">
    <text>已经到底了</text>
  </view>
</view>
