<!--首页模板 - 增强版-->
<view class="index-container">
  <!-- 加载状态 -->
  <view class="loading-overlay" wx:if="{{pageLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载...</text>
  </view>
  
  <!-- 错误状态 -->
  <view class="error-state" wx:if="{{pageError}}">
    <view class="error-icon"></view>
    <text class="error-message">{{errorMessage}}</text>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>
  
  <!-- 主内容区域 -->
  <view class="content-area" wx:if="{{!pageLoading && !pageError}}">
    <!-- 市场指数栏 -->
    <view class="market-indices" wx:if="{{marketIndices}}">
      <scroll-view class="indices-scroll" scroll-x="true">
        <view class="index-item" wx:for="{{marketIndices}}" wx:key="name">
          <text class="index-name">{{item.name}}</text>
          <text class="index-value">{{item.value}}</text>
          <text class="index-change" style="color: {{item.color}}">{{item.change}}</text>
        </view>
      </scroll-view>
    </view>
    <!-- 市场概览卡片 - 增强版 -->
    <view class="market-overview enhanced-card alipay-blue">
  <view class="overview-header">
    <text class="title">市场概览</text>
    <text class="subtitle">今日数据</text>
    <view class="refresh-icon" bindtap="refreshData" data-show-loading="{{true}}">
      <icon type="refresh" size="16"></icon>
    </view>
    
  </view>
  
  <view class="overview-stats">
    <view class="stat-item bounce-in" style="animation-delay: 0.1s">
      <text class="stat-value">{{marketData.overview.totalVolume}}</text>
      <text class="stat-label">总成交额</text>
    </view>
    <view class="stat-item bounce-in" style="animation-delay: 0.2s">
      <text class="stat-value">{{marketData.overview.dailyChange}}</text>
      <text class="stat-label">日涨跌</text>
    </view>
    <view class="stat-item bounce-in" style="animation-delay: 0.3s">
      <text class="stat-value">{{marketData.overview.activeOptions}}</text>
      <text class="stat-label">活跃期权</text>
    </view>
    <view class="stat-item bounce-in" style="animation-delay: 0.4s">
      <text class="stat-value">{{marketData.overview.topGainers}}</text>
      <text class="stat-label">领涨数量</text>
    </view>
  </view>
</view>

    <!-- 快捷操作 - 增强版 -->
    <view class="quick-actions enhanced-card">
      <text class="section-title">快捷操作</text>
      <view class="actions-grid">
        <view 
          class="action-item hover-effect" 
          wx:for="{{quickActions}}" 
          wx:key="id"
          data-action="{{item.id}}"
          data-path="{{item.path}}"
          bindtap="onQuickAction"
        >
          <view class="action-icon {{item.icon}}">
            <text class="icon-text">{{item.icon === 'chart' ? '📈' : item.icon === 'calculator' ? '🧮' : item.icon === 'message' ? '💬' : '📁'}}</text>
          </view>
          <text class="action-name">{{item.name}}</text>
          <text class="action-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 热门股票 - 增强版 -->
    <view class="hot-stocks enhanced-card">
      <view class="section-header">
        <text class="section-title">热门股票</text>
        <text class="section-subtitle">实时更新</text>
      </view>
      
      <view class="stocks-list">
        <view 
          class="stock-item slide-in hover-effect" 
          wx:for="{{marketData.hotStocks}}" 
          wx:key="code"
          data-stock="{{item}}"
          bindtap="onStockTap"
          style="animation-delay: {{index * 0.1}}s"
        >
          <view class="stock-main">
            <view class="stock-info">
              <text class="stock-name">{{item.name}}</text>
              <text class="stock-code">{{item.code}}</text>
            </view>
            <view class="stock-data">
              <text class="stock-price">￥{{item.price}}</text>
              <text class="stock-change {{item.change.indexOf('+') === 0 ? 'positive' : 'negative'}}">
                {{item.change}}
              </text>
            </view>
          </view>
          <view class="stock-volume">
            <text>成交量: {{item.volume}}</text>
          </view>
          <view class="stock-arrow">
            <icon type="arrowright" size="14"></icon>
          </view>
        </view>
      </view>
      
      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!marketData.hotStocks || marketData.hotStocks.length === 0}}">
        <text class="empty-text">暂无热门股票数据</text>
        <button class="refresh-btn" bindtap="loadMarketData">刷新</button>
      </view>
    </view>

    <!-- 公告通知 - 增强版 -->
    <view class="announcements enhanced-card">
      <view class="section-header">
        <text class="section-title">公告通知</text>
        <view class="notification-badge" wx:if="{{announcements && announcements.length > 0}}">
          <text class="badge-text">{{announcements.length}}</text>
        </view>
      </view>
      
      <view class="announcement-list">
        <view 
          class="announcement-item slide-in hover-effect" 
          wx:for="{{announcements}}" 
          wx:key="id"
          data-item="{{item}}"
          bindtap="onAnnouncementTap"
          style="animation-delay: {{index * 0.1}}s"
        >
          <view class="announcement-type-icon {{item.type}}">
            <text class="type-text">{{item.type === 'system' ? '🔧' : item.type === 'product' ? '🎆' : '📄'}}</text>
          </view>
          <view class="announcement-content">
            <text class="announcement-title">{{item.title}}</text>
            <text class="announcement-time">{{item.time}}</text>
          </view>
          <view class="announcement-arrow">
            <icon type="arrowright" size="16"></icon>
          </view>
        </view>
      </view>
      
      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!announcements || announcements.length === 0}}">
        <text class="empty-text">暂无公告通知</text>
      </view>
    </view>
  </view>
</view>