/* 支付宝风格蓝白配色 - 首页样式 */

/* 主色调定义 */
:root {
  --primary-blue: #1677FF;
  --light-blue: #4096FF;
  --pale-blue: #E6F4FF;
  --bg-blue: #F5F8FF;
  --deep-blue: #0958D9;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --border-color: #E8E8E8;
  --white: #FFFFFF;
  --success-green: #52C41A;
  --error-red: #FF4D4F;
}

/* 容器 */
.index-container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-blue) 0%, var(--white) 100%);
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  z-index: 1000;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid var(--pale-blue);
  border-top-color: var(--primary-blue);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  margin-top: 16px;
  font-size: 14px;
  color: var(--text-secondary);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 24px;
}

.error-icon {
  width: 60px;
  height: 60px;
  background: var(--pale-blue);
  border-radius: 50%;
  margin-bottom: 16px;
}

.error-message {
  font-size: 14px;
  color: var(--text-secondary);
  margin-bottom: 24px;
}

.retry-btn {
  background: var(--primary-blue);
  color: var(--white);
  border: none;
  padding: 10px 32px;
  border-radius: 20px;
  font-size: 14px;
}

/* 主内容区域 */
.content-area {
  padding: 16px;
}

/* 市场指数栏 */
.market-indices {
  background: var(--white);
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(22, 119, 255, 0.08);
}

.indices-scroll {
  white-space: nowrap;
}

.index-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 8px 16px;
  margin-right: 12px;
}

.index-name {
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.index-value {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 2px;
}

.index-change {
  font-size: 12px;
  font-weight: 500;
}

/* 增强卡片样式 */
.enhanced-card {
  background: var(--white);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(22, 119, 255, 0.08);
}

/* 市场概览 */
.market-overview {
  background: linear-gradient(135deg, var(--primary-blue) 0%, var(--light-blue) 100%);
  color: var(--white);
  box-shadow: 0 4px 12px rgba(22, 119, 255, 0.25);
}

.market-overview .section-title {
  color: var(--white);
}

.overview-header {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.overview-header .title {
  font-size: 18px;
  font-weight: 600;
  flex: 1;
}

.overview-header .subtitle {
  font-size: 12px;
  opacity: 0.8;
  margin-right: 12px;
}

.refresh-icon {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.overview-stats {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 4px;
}

.stat-label {
  font-size: 12px;
  opacity: 0.85;
}

/* 快捷操作 */
.section-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16px;
  display: block;
}

.actions-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 8px;
  background: var(--pale-blue);
  border-radius: 12px;
  transition: all 0.3s;
}

.action-icon {
  width: 48px;
  height: 48px;
  background: var(--white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
  font-size: 24px;
}

.action-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.action-desc {
  font-size: 11px;
  color: var(--text-tertiary);
  text-align: center;
}

/* 热门股票 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.section-subtitle {
  font-size: 12px;
  color: var(--text-tertiary);
}

.stocks-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.stock-item {
  display: flex;
  align-items: center;
  padding: 16px;
  background: var(--bg-blue);
  border-radius: 10px;
  border: 1px solid var(--border-color);
  transition: all 0.3s;
}

.stock-main {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stock-info {
  display: flex;
  flex-direction: column;
}

.stock-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.stock-code {
  font-size: 12px;
  color: var(--text-tertiary);
}

.stock-data {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.stock-price {
  font-size: 16px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.stock-change {
  font-size: 13px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 4px;
}

.stock-change.positive {
  color: var(--success-green);
  background: rgba(82, 196, 26, 0.1);
}

.stock-change.negative {
  color: var(--error-red);
  background: rgba(255, 77, 79, 0.1);
}

.stock-volume {
  margin-left: 16px;
  font-size: 12px;
  color: var(--text-secondary);
}

.stock-arrow {
  margin-left: 12px;
  color: var(--text-tertiary);
}

/* 公告通知 */
.notification-badge {
  background: var(--primary-blue);
  color: var(--white);
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 600;
}

.announcement-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.announcement-item {
  display: flex;
  align-items: center;
  padding: 12px;
  background: var(--bg-blue);
  border-radius: 8px;
  border-left: 3px solid var(--primary-blue);
  transition: all 0.3s;
}

.announcement-type-icon {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--white);
  border-radius: 8px;
  margin-right: 12px;
  font-size: 18px;
}

.announcement-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.announcement-title {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.announcement-time {
  font-size: 12px;
  color: var(--text-tertiary);
}

.announcement-arrow {
  color: var(--text-tertiary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 24px;
}

.empty-text {
  font-size: 14px;
  color: var(--text-secondary);
  margin-bottom: 16px;
}

.refresh-btn {
  background: var(--primary-blue);
  color: var(--white);
  border: none;
  padding: 8px 24px;
  border-radius: 16px;
  font-size: 13px;
}

/* 悬停效果 */
.hover-effect:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.action-item:active {
  background: var(--primary-blue);
}

.action-item:active .action-name {
  color: var(--white);
}

.action-item:active .action-desc {
  color: rgba(255, 255, 255, 0.8);
}

.stock-item:active {
  background: var(--white);
  border-color: var(--primary-blue);
  box-shadow: 0 2px 8px rgba(22, 119, 255, 0.15);
}

.announcement-item:active {
  background: var(--white);
  box-shadow: 0 2px 8px rgba(22, 119, 255, 0.15);
}

/* 动画 */
@keyframes bounce-in {
  0% {
    opacity: 0;
    transform: scale(0.3);
  }
  50% {
    transform: scale(1.05);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes slide-in {
  from {
    opacity: 0;
    transform: translateX(-20px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.bounce-in {
  animation: bounce-in 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.slide-in {
  animation: slide-in 0.4s ease-out;
}