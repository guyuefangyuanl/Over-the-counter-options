/* ====== 全局容器 ====== */
.container {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 40rpx;
}

/* ====== 加载状态 ====== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
  border-width: 4rpx;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ====== 主内容区 ====== */
.main-content {
  padding: 0 24rpx;
}

/* ====== 顶部用户信息 ====== */
.header-section {
  padding: 48rpx 0 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.1);
}

.avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.login-btn {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1.2;
  text-align: left;
}

.login-btn::after {
  border: none;
}

.welcome-text {
  font-size: 24rpx;
  color: #8593a3;
}

/* ====== 搜索区域 ====== */
.search-container {
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 48rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-btn {
  padding: 8rpx 24rpx;
  background: #409EFF;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 32rpx;
  margin-left: 12rpx;
}

/* ====== 轮播图卡片 ====== */
.banner-container {
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
  animation: fade-in 0.5s ease both;
}

.banner-swiper {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.7) 0%,
    rgba(0, 0, 0, 0.4) 50%,
    transparent 100%
  );
  padding: 32rpx 24rpx 24rpx;
}

.banner-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.banner-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  line-height: 1.3;
}

.banner-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

@keyframes fade-in {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ====== 搜索结果 ====== */
.search-results {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  min-height: 400rpx;
}

.search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.search-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.search-cancel {
  font-size: 28rpx;
  color: #667eea;
}

.searching-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 24rpx;
}

.searching-text {
  font-size: 28rpx;
  color: #999999;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.result-item:active {
  background: #e9ecef;
  transform: scale(0.98);
}

.result-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.result-code {
  font-size: 24rpx;
  color: #999999;
}

.result-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.result-price .price {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.result-price .change {
  font-size: 24rpx;
  font-weight: 600;
}

.result-price .change.up {
  color: #f44336;
}

.result-price .change.down {
  color: #4caf50;
}

.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 96rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #666666;
}

.empty-hint {
  font-size: 24rpx;
  color: #999999;
}

.search-suggestions {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.suggestion-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.clear-btn {
  font-size: 24rpx;
  color: #999999;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: #f0f0f0;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
  transition: all 0.3s ease;
}

.tag-item:active {
  background: #e0e0e0;
  transform: scale(0.95);
}

.tag-item.hot {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe5e5 100%);
  color: #f44336;
}

/* ====== 首页内容 ====== */
.home-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.more-btn {
  font-size: 26rpx;
  color: #409EFF;
}

/* ====== 增强卡片样式 ====== */
.enhanced-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.enhanced-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* ====== 快捷功能 ====== */
.quick-actions-section {
  margin-bottom: 24rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon-img {
  width: 80rpx;
  height: 80rpx;
}

.action-name {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

/* ====== 持仓案例调整 ====== */
.holding-row {
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
}

.holding-fee, .holding-scale {
  font-size: 22rpx;
  color: #999;
}

/* ====== 热门产品 ====== */
.option-info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.market-badge {
  font-size: 20rpx;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  color: #fff;
}

.market-badge.sh {
  background: #E91E63; /* Pink/Red for SH */
}

.market-badge.sz {
  background: #E91E63; /* Pink/Red for SZ too based on screenshot? Or differ. */
}

.option-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.option-code {
  font-size: 24rpx;
  color: #409EFF; /* Blue for code */
}

.option-structure {
  font-size: 24rpx;
  color: #333;
}

.option-tags {
  display: flex;
}

.tag-vanilla {
  font-size: 22rpx;
  color: #E6A23C; /* Orange/Gold */
  background: #FDF6EC;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* ====== 知识区域 ====== */
.knowledge-section-outer {
  margin-top: 24rpx;
}

.knowledge-list {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 24rpx;
}

.knowledge-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f7fa;
}

.knowledge-item:last-child {
  border-bottom: none;
}

.knowledge-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.knowledge-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  flex: 1;
}

.external-link-icon {
  font-size: 22rpx;
  line-height: 1;
  opacity: 0.6;
  display: inline-block;
  margin-left: 4rpx;
  flex-shrink: 0;
}

.knowledge-meta {
  font-size: 22rpx;
  color: #999;
}
.index-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 新增：持仓案例样式 */
.holding-section {
  margin: 16rpx 0 24rpx;
}

.holding-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
}

.holding-tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.holding-tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #909399;
  border-bottom: 4rpx solid transparent;
}

.holding-tab-item.active {
  color: #409EFF;
  border-bottom-color: #409EFF;
}

.holding-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.holding-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 8rpx;
  transition: transform 0.2s ease;
}

.holding-item:active {
  transform: scale(0.98);
}

.holding-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.holding-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.holding-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.holding-market {
  font-size: 24rpx;
  color: #999999;
}

.holding-structure {
  font-size: 24rpx;
  color: #8593a3;
}

.holding-fee,
.holding-scale {
  font-size: 24rpx;
  color: #666666;
}

.holding-profit {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.profit {
  font-size: 26rpx;
  font-weight: 600;
}

.profit.up {
  color: #67C23A;
}

.profit.down {
  color: #F56C6C;
}

.profit-rate.up {
  color: #67C23A;
}

.profit-rate.down {
  color: #F56C6C;
}

.knowledge-section {
  margin-top: 16rpx;
  border-top: 2rpx solid #f2f3f5;
  padding-top: 16rpx;
}

.knowledge-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx;
  transition: transform 0.2s ease;
}

.knowledge-item:active {
  transform: scale(0.98);
}

.knowledge-icon {
  font-size: 32rpx;
}

.knowledge-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 0 12rpx;
}

.knowledge-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.knowledge-meta {
  font-size: 24rpx;
  color: #999999;
}

.knowledge-arrow {
  font-size: 28rpx;
  color: #909399;
}

.index-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.index-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.index-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.index-code {
  font-size: 24rpx;
  color: #999999;
}

.index-data {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.index-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
}

.index-change {
  font-size: 26rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.index-change.up {
  background: #ffebee;
  color: #f44336;
}

.index-change.down {
  background: #e8f5e9;
  color: #4caf50;
}

/* ====== 热门期权 ====== */
.option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-card {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.option-code {
  font-size: 24rpx;
  color: #999999;
}

.option-type {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.option-type.call {
  background: #ffebee;
  color: #f44336;
}

.option-type.put {
  background: #e8f5e9;
  color: #4caf50;
}

.option-data {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.data-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
}

.data-label {
  font-size: 24rpx;
  color: #999999;
}

.data-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.data-value.price {
  font-size: 32rpx;
  color: #333333;
}

.data-value.up {
  color: #f44336;
}

.data-value.down {
  color: #4caf50;
}

/* ====== 响应式适配 ====== */
@media (max-width: 360px) {
  .banner-swiper {
    height: 300rpx;
  }
  
  .banner-title {
    font-size: 28rpx;
  }
  
  .banner-desc {
    font-size: 22rpx;
  }

  .quick-actions {
    grid-template-columns: repeat(3, 1fr);
    gap: 16rpx;
    padding: 24rpx 16rpx;
  }

  .action-icon {
    width: 80rpx;
    height: 80rpx;
    font-size: 40rpx;
  }

  .action-name {
    font-size: 22rpx;
  }
}

/* ====== 动画效果 ====== */
@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.index-card,
.option-card {
  animation: slideIn 0.3s ease both;
}

.index-card:nth-child(1) { animation-delay: 0.05s; }
.index-card:nth-child(2) { animation-delay: 0.1s; }
.index-card:nth-child(3) { animation-delay: 0.15s; }

.option-card:nth-child(1) { animation-delay: 0.05s; }
.option-card:nth-child(2) { animation-delay: 0.1s; }
.option-card:nth-child(3) { animation-delay: 0.15s; }
.option-card:nth-child(4) { animation-delay: 0.2s; }
.option-card:nth-child(5) { animation-delay: 0.25s; }
