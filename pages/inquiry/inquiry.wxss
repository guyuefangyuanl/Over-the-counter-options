/* 询价页面样式 - 优化版 */
.inquiry-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部操作栏 */
.top-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
  padding: 0 10rpx;
}

.filter-section {
  flex: 1;
  margin-right: 20rpx;
}

.filter-display {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 22rpx 30rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.filter-text {
  font-weight: 600;
}

.filter-count {
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 15rpx;
  font-size: 22rpx;
}

.create-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: white;
  border: none;
  padding: 22rpx 35rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 107, 0.3);
  font-weight: 600;
}

.create-icon {
  font-size: 30rpx;
  font-weight: bold;
}

/* 智能推荐区域 */
.smart-recommendations {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 25rpx;
  padding: 30rpx;
  margin-bottom: 25rpx;
  color: white;
}

.recommendation-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: center;
}

.strategy-recommendations {
  display: flex;
  gap: 15rpx;
}

.strategy-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 15rpx;
  padding: 20rpx;
  text-align: center;
  backdrop-filter: blur(10rpx);
}

.strategy-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.strategy-desc {
  font-size: 20rpx;
  opacity: 0.8;
}

/* 询价列表 */
.inquiry-list {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.inquiry-item {
  background: white;
  border-radius: 25rpx;
  padding: 35rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.12);
  transition: all 0.3s ease;
  border-left: 6rpx solid #667eea;
  position: relative;
  overflow: hidden;
}

.inquiry-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.inquiry-item:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 25rpx rgba(0,0,0,0.15);
}

/* 询价头部 */
.inquiry-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 25rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f8f8f8;
}

.inquiry-id-section {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.inquiry-id {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.urgency-badge {
  padding: 6rpx 16rpx;
  border-radius: 15rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: white;
}

.urgency-badge.urgent {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.status-section {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.inquiry-status {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: white;
  text-align: center;
}

.inquiry-status.pending {
  background: linear-gradient(135deg, #ffa726 0%, #ffb74d 100%);
}

.inquiry-status.confirmed {
  background: linear-gradient(135deg, #66bb6a 0%, #81c784 100%);
}

.inquiry-status.expired {
  background: linear-gradient(135deg, #bdbdbd 0%, #e0e0e0 100%);
  color: #666;
}

.inquiry-status.cancelled {
  background: linear-gradient(135deg, #ef5350 0%, #e57373 100%);
}

.quote-count {
  font-size: 20rpx;
  color: #666;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

/* 询价详情 */
.inquiry-details {
  margin-bottom: 25rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  padding: 8rpx 0;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-row .label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.detail-row .value {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  flex: 1;
  text-align: right;
}

.strategy-tag {
  font-size: 20rpx;
  color: #667eea;
  font-weight: normal;
}

.strike-price {
  color: #667eea !important;
  font-weight: bold;
}

.price-info {
  background: #f8f9fa;
  border-radius: 15rpx;
  padding: 20rpx;
  margin-top: 15rpx;
}

.target-price {
  color: #4caf50 !important;
}

.estimated-range {
  color: #ff9500 !important;
}

/* 市场情绪指示器 */
.market-sentiment {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 20rpx;
  padding: 15rpx 20rpx;
  background: #f0f4ff;
  border-radius: 15rpx;
}

.sentiment-label {
  font-size: 22rpx;
  color: #666;
}

.sentiment-indicator {
  padding: 6rpx 16rpx;
  border-radius: 15rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.sentiment-indicator.bullish {
  background: linear-gradient(135deg, #4caf50 0%, #66bb6a 100%);
  color: white;
}

.sentiment-indicator.bearish {
  background: linear-gradient(135deg, #f44336 0%, #ef5350 100%);
  color: white;
}

.sentiment-indicator.neutral {
  background: linear-gradient(135deg, #ff9800 0%, #ffa726 100%);
  color: white;
}

/* 增强的报价信息 */
.quotes-info {
  background: linear-gradient(135deg, #e8f5e8 0%, #f0f8f0 100%);
  padding: 25rpx;
  border-radius: 20rpx;
  margin-bottom: 25rpx;
  border: 2rpx solid #4caf50;
}

.quotes-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.quotes-title {
  font-size: 26rpx;
  color: #4caf50;
  font-weight: 600;
}

.best-price {
  font-size: 24rpx;
  color: #4caf50;
  font-weight: bold;
  background: white;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.quotes-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.quote-item {
  background: white;
  padding: 20rpx;
  border-radius: 15rpx;
  border: 2rpx solid #e8f5e8;
  position: relative;
}

.quote-trader-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.quote-trader {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

.confidence-badge {
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: white;
}

.confidence-badge.high {
  background: #4caf50;
}

.confidence-badge.medium {
  background: #ff9800;
}

.confidence-badge.low {
  background: #f44336;
}

.quote-price-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.quote-price {
  font-size: 30rpx;
  color: #4caf50;
  font-weight: bold;
}

.quote-validity {
  font-size: 20rpx;
  color: #999;
  background: #f0f0f0;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

.quote-time {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 10rpx;
  display: block;
}

.greeks-mini {
  display: flex;
  gap: 15rpx;
}

.greek-mini {
  font-size: 18rpx;
  color: #666;
  background: #f8f8f8;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
}

.selected-quote {
  padding: 20rpx;
  background: linear-gradient(135deg, #4caf50 0%, #66bb6a 100%);
  border-radius: 15rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
}

.selected-label {
  font-size: 22rpx;
  font-weight: 600;
}

.selected-trader {
  font-size: 26rpx;
  font-weight: 600;
}

.selected-price {
  font-size: 28rpx;
  font-weight: bold;
}

/* 时间信息 */
.time-info {
  margin-bottom: 20rpx;
  background: #f8f9fa;
  padding: 15rpx 20rpx;
  border-radius: 15rpx;
}

.create-time, .confirm-time, .expire-time, .cancel-time, .valid-until {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.create-time::before { content: '📅 '; }
.confirm-time::before { content: '✓ '; }
.expire-time::before { content: '⏰ '; }
.cancel-time::before { content: '❌ '; }
.valid-until::before { content: '⏳ '; }

.valid-until {
  color: #ff9800;
  font-weight: 600;
}

/* 备注 */
.notes {
  background: #fff8e1;
  padding: 20rpx;
  border-radius: 15rpx;
  margin-bottom: 25rpx;
  border-left: 4rpx solid #ff9800;
}

.notes-label {
  font-size: 22rpx;
  color: #ff9800;
  margin-bottom: 10rpx;
  display: block;
  font-weight: 600;
}

.notes-content {
  font-size: 24rpx;
  color: #333;
  line-height: 1.5;
}

/* 增强的操作按钮 */
.inquiry-actions {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.action-group {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.action-btn {
  flex: 1;
  min-width: 120rpx;
  padding: 18rpx 25rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.edit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.boost-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: white;
}

.cancel-btn {
  background: linear-gradient(135deg, #ffa726 0%, #ffb74d 100%);
  color: white;
}

.contract-btn {
  background: linear-gradient(135deg, #4caf50 0%, #66bb6a 100%);
  color: white;
}

.duplicate-btn {
  background: linear-gradient(135deg, #9c27b0 0%, #ba68c8 100%);
  color: white;
}

.delete-btn {
  background: linear-gradient(135deg, #f44336 0%, #ef5350 100%);
  color: white;
}

.share-btn {
  background: linear-gradient(135deg, #2196f3 0%, #42a5f5 100%);
  color: white;
  flex: 0 0 auto;
  padding: 18rpx 30rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: #999;
}

.empty-text {
  font-size: 32rpx;
  margin: 20rpx 0 10rpx;
}

.empty-hint {
  font-size: 26rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.loading text {
  margin-top: 20rpx;
  font-size: 26rpx;
}

/* 增强的创建询价弹窗 */
.create-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.create-modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(8rpx);
}

.modal-content, .search-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 85vh;
  overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.create-modal.show .modal-content,
.search-modal.show .search-content {
  transform: translateY(0);
}

.modal-header, .search-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 35rpx 40rpx 25rpx;
  border-bottom: 2rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  background: white;
  z-index: 10;
}

.modal-title, .search-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.close-icon {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
}

.modal-body {
  padding: 30rpx 40rpx;
}

/* 增强的表单样式 */
.form-group {
  margin-bottom: 35rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
  font-weight: 600;
}

.form-input, .form-picker, .form-textarea {
  width: 100%;
  padding: 25rpx 20rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #667eea;
  background: white;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

.form-textarea {
  height: 140rpx;
  resize: none;
  line-height: 1.5;
}

/* 期权类型选择器 */
.option-type-selector {
  display: flex;
  gap: 15rpx;
}

.option-type-btn {
  flex: 1;
  padding: 25rpx;
  text-align: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  background: #f8f9fa;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.option-type-btn.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-color: #667eea;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}

/* 紧急程度选择器 */
.urgency-selector {
  display: flex;
  gap: 15rpx;
}

.urgency-btn {
  flex: 1;
  padding: 20rpx 15rpx;
  text-align: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  background: #f8f9fa;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.urgency-btn.active {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: white;
  border-color: #ff6b6b;
}

.urgency-desc {
  font-size: 20rpx;
  opacity: 0.8;
}

/* 价格区间 */
.price-range {
  display: flex;
  gap: 15rpx;
  align-items: center;
}

.price-input {
  flex: 1;
}

.price-separator {
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
}

/* 股票输入 */
.stock-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.stock-input {
  flex: 1;
  padding-right: 60rpx;
}

.search-btn-mini {
  position: absolute;
  right: 20rpx;
  font-size: 28rpx;
  color: #667eea;
}

/* 智能推荐 */
.smart-suggestions {
  margin-top: 15rpx;
  padding: 20rpx;
  background: #f0f4ff;
  border-radius: 15rpx;
  border: 2rpx solid #e3f2fd;
}

.suggestion-label {
  font-size: 22rpx;
  color: #667eea;
  margin-bottom: 10rpx;
  display: block;
  font-weight: 600;
}

.strike-suggestions, .expiry-suggestions {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.strike-suggestion, .expiry-suggestion {
  padding: 8rpx 16rpx;
  background: white;
  border: 2rpx solid #667eea;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #667eea;
  font-weight: 600;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx 40rpx;
  border-top: 2rpx solid #f0f0f0;
  background: white;
  position: sticky;
  bottom: 0;
}

.cancel-modal-btn, .submit-btn {
  flex: 1;
  padding: 25rpx;
  border-radius: 15rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.cancel-modal-btn {
  background: #f8f8f8;
  color: #666;
}

.submit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}

/* 股票搜索弹窗 */
.search-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.search-modal.show {
  opacity: 1;
  visibility: visible;
}

.search-input-wrapper {
  padding: 20rpx 40rpx;
  background: #f8f9fa;
}

.search-input {
  width: 100%;
  padding: 25rpx 20rpx;
  background: white;
  border: 2rpx solid #e0e0e0;
  border-radius: 15rpx;
  font-size: 28rpx;
}

.search-results {
  padding: 20rpx 40rpx;
}

.results-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
  font-weight: 600;
}

.stock-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.stock-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 20rpx;
  background: white;
  border-radius: 15rpx;
  border: 2rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.stock-item:active {
  background: #f0f4ff;
  border-color: #667eea;
}

.stock-info {
  flex: 1;
}

.stock-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 6rpx;
  display: block;
}

.stock-code {
  font-size: 22rpx;
  color: #666;
}

.stock-price {
  text-align: right;
}

.stock-price .price {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 4rpx;
  display: block;
}

.stock-price .change {
  font-size: 20rpx;
  font-weight: 500;
}

.stock-price .change.positive {
  color: #4caf50;
}

.stock-price .change.negative {
  color: #f44336;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .inquiry-container {
    padding: 15rpx;
  }
  
  .inquiry-item {
    padding: 25rpx;
  }
  
  .modal-body {
    padding: 25rpx;
  }
  
  .urgency-selector {
    flex-direction: column;
  }
  
  .action-group {
    flex-direction: column;
  }
}