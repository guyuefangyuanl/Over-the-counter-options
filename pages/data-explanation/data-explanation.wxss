/* pages/data-explanation/data-explanation.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.header {
  background: linear-gradient(135deg, #4298EF 0%, #6BB6FF 100%);
  color: #fff;
  padding: 40rpx 30rpx 30rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.back-btn, .share-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon, .share-icon {
  width: 32rpx;
  height: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

.update-time {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 30rpx;
  text-align: center;
}

/* 搜索框 */
.search-box {
  position: relative;
  margin-bottom: 30rpx;
}

.search-input {
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 25rpx;
  padding: 20rpx 60rpx 20rpx 30rpx;
  font-size: 28rpx;
  color: #333;
}

.search-input::placeholder {
  color: #999;
}

.search-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 25rpx;
  height: 60rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn:active {
  background-color: rgba(255, 255, 255, 0.3);
}

/* 搜索结果 */
.search-results {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.results-header {
  background-color: #f8f9fa;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-section {
  font-size: 24rpx;
  color: #4298EF;
  margin-bottom: 8rpx;
}

.result-term {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.result-definition {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 内容章节 */
.content-sections {
  margin: 20rpx;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.section:last-child {
  margin-bottom: 0;
}

/* 章节标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: #f8f9fa;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.expand-icon {
  width: 32rpx;
  height: 32rpx;
  transition: transform 0.3s ease;
}

/* 章节内容 */
.section-content {
  padding: 30rpx;
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transition: all 0.3s ease;
}

.section-content.expanded {
  opacity: 1;
  max-height: none;
}

.content-item {
  margin-bottom: 40rpx;
}

.content-item:last-child {
  margin-bottom: 0;
}

/* 术语定义 */
.term-definition {
  margin-bottom: 20rpx;
}

.term {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.term-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #4298EF;
}

.copy-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.definition {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  padding-left: 20rpx;
  border-left: 4rpx solid #4298EF;
  background-color: #f8f9ff;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
}

/* 公式区域 */
.formula-section, .formulas-section {
  margin-top: 20rpx;
  background-color: #fff7f0;
  padding: 20rpx;
  border-left: 4rpx solid #FF8C00;
  border-radius: 8rpx;
}

.formula-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #FF8C00;
  margin-bottom: 12rpx;
}

.formula-content {
  font-size: 24rpx;
  color: #333;
  background-color: #fff;
  padding: 16rpx;
  border-radius: 6rpx;
  font-family: monospace;
  word-break: break-all;
}

.formulas-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.formula-item {
  border: 1rpx solid #ffd591;
  border-radius: 8rpx;
  padding: 16rpx;
  background-color: #fff;
}

.formula-type {
  font-size: 26rpx;
  font-weight: 600;
  color: #d48806;
  margin-bottom: 8rpx;
}

.formula-description {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

/* 示例区域 */
.example-section {
  margin-top: 20rpx;
  background-color: #f0f8f0;
  padding: 20rpx;
  border-left: 4rpx solid #03B615;
  border-radius: 8rpx;
}

.example-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #03B615;
  margin-bottom: 8rpx;
}

.example-content {
  font-size: 24rpx;
  color: #333;
  line-height: 1.5;
}

/* 风险提示 */
.risk-notice {
  background-color: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  margin: 20rpx;
  padding: 30rpx;
}

.notice-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.warning-icon {
  width: 32rpx;
  height: 32rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #d48806;
}

.notice-content {
  padding-left: 48rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #d48806;
  line-height: 1.6;
}

/* 页面底部 */
.page-footer {
  text-align: center;
  padding: 40rpx 30rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}