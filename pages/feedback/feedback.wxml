<!--意见反馈页面模板-->
<view class="feedback-container">
  <!-- 页面头部说明 -->
  <view class="feedback-header">
    <view class="header-icon">💡</view>
    <view class="header-text">
      <view class="title">意见反馈</view>
      <view class="subtitle">您的建议是我们前进的动力</view>
    </view>
  </view>

  <!-- 反馈表单 -->
  <view class="feedback-form">
    <!-- 反馈类型 -->
    <view class="form-group">
      <text class="form-label">反馈类型 *</text>
      <picker 
        bindchange="onTypeChange" 
        value="{{feedbackType}}" 
        range="{{typeOptions}}"
        range-key="label"
      >
        <view class="picker-display">
          {{getTypeLabel(feedbackType)}}
          <icon class="picker-arrow" type="arrowright" size="16"></icon>
        </view>
      </picker>
    </view>

    <!-- 反馈内容 -->
    <view class="form-group">
      <text class="form-label">反馈内容 *</text>
      <textarea 
        class="feedback-textarea"
        placeholder="请详细描述您的问题或建议，我们会认真对待每一条反馈"
        value="{{feedbackText}}"
        bindinput="onFeedbackInput"
        maxlength="{{maxWords}}"
        show-confirm-bar="{{false}}"
      />
      <view class="word-count">
        <text class="count {{wordCount > maxWords * 0.8 ? 'warning' : ''}}">
          {{wordCount}}/{{maxWords}}
        </text>
      </view>
    </view>

    <!-- 联系方式 -->
    <view class="form-group">
      <text class="form-label">联系方式（选填）</text>
      <input 
        class="form-input"
        placeholder="手机号或微信号，便于我们与您联系"
        value="{{contactInfo}}"
        bindinput="onContactInput"
        maxlength="50"
      />
      <view class="form-hint">
        <icon type="info" size="12" color="#999"></icon>
        <text>我们会保护您的隐私，不会泄露您的联系方式</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button 
      class="submit-btn"
      bindtap="submitFeedback"
      loading="{{submitting}}"
      disabled="{{submitting || !feedbackText.trim()}}"
    >
      {{submitting ? '提交中...' : '提交反馈'}}
    </button>
    
    <button 
      class="cancel-btn"
      bindtap="cancel"
      disabled="{{submitting}}"
    >
      取消
    </button>
  </view>

  <!-- 反馈须知 -->
  <view class="feedback-notice">
    <view class="notice-title">反馈须知</view>
    <view class="notice-list">
      <view class="notice-item">
        <text class="notice-dot">•</text>
        <text>我们会在1-3个工作日内处理您的反馈</text>
      </view>
      <view class="notice-item">
        <text class="notice-dot">•</text>
        <text>如需紧急处理，请直接联系客服</text>
      </view>
      <view class="notice-item">
        <text class="notice-dot">•</text>
        <text>感谢您对产品的关注和支持</text>
      </view>
    </view>
  </view>
</view>