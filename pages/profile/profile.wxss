/* 我的页面样式 */
.profile-container {
  padding: 0;
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 40rpx 30rpx 30rpx;
  position: relative;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-section {
  margin-right: 25rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.2);
}

.default-avatar {
  background: rgba(255,255,255,0.3);
}

.user-details {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.vip-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.vip-level {
  background: rgba(255,255,255,0.2);
  color: white;
  padding: 6rpx 15rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.vip-id {
  font-size: 24rpx;
  opacity: 0.8;
}

.login-hint {
  margin-top: 8rpx;
}

.hint-text {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 认证按钮 */
.auth-section {
  display: flex;
  justify-content: center;
}

.auth-btn {
  border: none;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  font-weight: 500;
}

.login-btn {
  background: rgba(255,255,255,0.9);
  color: #667eea;
}

.logout-btn {
  background: rgba(255,255,255,0.2);
  color: white;
  border: 2rpx solid rgba(255,255,255,0.5);
}

.auth-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 功能菜单 */
.menu-section {
  margin: 20rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.menu-title {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  border-bottom: 2rpx solid #f0f0f0;
}

.menu-list {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 30rpx;
  border-bottom: 2rpx solid #f8f8f8;
  transition: background-color 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f8f8f8;
}

.menu-content {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  position: relative;
}

.menu-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 24rpx;
  height: 24rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.menu-icon.member {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
}

.menu-icon.member::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-icon.profile {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.menu-icon.profile::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-icon.service {
  background: linear-gradient(135deg, #ffeaa7 0%, #fab1a0 100%);
}

.menu-icon.service::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-icon.suggestion {
  background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
}

.menu-icon.suggestion::before {
  background-image: url('data:image/svg+xml;base64,');
}

.menu-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.menu-arrow {
  color: #c0c0c0;
}

/* 功能介绍 */
.feature-intro {
  margin: 20rpx;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.intro-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
}

.intro-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.intro-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.intro-item icon {
  margin-right: 15rpx;
}

/* 统计信息 */
.stats-section {
  margin: 20rpx;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 25rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25rpx;
}

.stat-item {
  text-align: center;
  padding: 25rpx;
  background: #f8f9fa;
  border-radius: 15rpx;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 20rpx 80rpx;
}

.version-text {
  font-size: 22rpx;
  color: #999;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .profile-container {
    font-size: 26rpx;
  }
  
  .user-card {
    padding: 30rpx 20rpx 25rpx;
  }
  
  .nickname {
    font-size: 32rpx;
  }
  
  .menu-section, 
  .feature-intro, 
  .stats-section {
    margin: 15rpx;
    padding: 25rpx;
  }
  
  .stats-grid {
    gap: 20rpx;
  }
  
  .stat-item {
    padding: 20rpx;
  }
}