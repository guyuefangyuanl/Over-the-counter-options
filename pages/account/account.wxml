<!--pages/account/account.wxml-->
<view class="container">
  <!-- 页面标题栏 -->
  <view class="header">
    <view class="status-bar">
      <view class="time">1:21</view>
      <view class="signal-icons">
        <image src="/images/signal1.png" class="signal-icon"></image>
        <image src="/images/signal2.png" class="signal-icon"></image>
        <image src="/images/battery.png" class="battery-icon"></image>
      </view>
    </view>
    <view class="title-bar">
      <image src="/images/back.png" class="back-btn" bindtap="onBackTap"></image>
      <text class="title">账户</text>
    </view>
  </view>

  <!-- 账户选择器 -->
  <view class="account-selector">
    <view class="selector-container" bindtap="toggleAccountDropdown">
      <input class="account-input" value="{{selectedAccount}}" disabled />
      <image src="/images/dropdown{{showAccountDropdown ? '-up' : '-down'}}.png" class="dropdown-icon"></image>
    </view>
    
    <view class="dropdown-list {{showAccountDropdown ? 'show' : ''}}" wx:if="{{showAccountDropdown}}">
      <view class="dropdown-item" 
            wx:for="{{accountOptions}}" 
            wx:key="id"
            data-account="{{item}}"
            bindtap="selectAccount">
        {{item.name}}
      </view>
    </view>
  </view>

  <!-- 录持仓按钮 -->
  <view class="add-position-btn" bindtap="addPosition">
    录持仓
  </view>

  <!-- 账户概览 -->
  <view class="account-overview">
    <!-- 标签切换 -->
    <view class="tab-header">
      <view class="tab-list">
        <view class="tab-item {{currentTab == index ? 'active' : ''}}"
              wx:for="{{tabList}}" 
              wx:key="index"
              wx:for-index="index"
              data-index="{{index}}"
              bindtap="switchTab">
          {{item.name}}({{item.count}})
        </view>
      </view>
      <view class="data-explanation" bindtap="viewDataExplanation">
        <text>数据说明</text>
        <image src="/images/info.png" class="info-icon"></image>
      </view>
    </view>

    <!-- 账户统计信息 -->
    <view class="account-stats">
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-label">存续规模（万）</text>
          <text class="stat-value main">{{accountSummary.totalScale}}</text>
        </view>
      </view>
      
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-label">存续净收益（元）</text>
          <text class="stat-value {{accountSummary.totalProfit >= 0 ? 'profit' : 'loss'}}">
            {{accountSummary.totalProfit}}
          </text>
        </view>
      </view>
      
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-label">完结净收益（元）</text>
          <text class="stat-value">{{accountSummary.completedProfit}}</text>
        </view>
      </view>
    </view>

    <!-- 投入成本展示 -->
    <view class="cost-section">
      <view class="cost-header" bindtap="toggleCostDetail">
        <text class="cost-title">投入成本（万）</text>
        <text class="cost-value">{{accountSummary.totalInvestment / 10000}}</text>
        <image src="/images/arrow-{{showCostDetail ? 'down' : 'right'}}.png" class="arrow-icon"></image>
      </view>
      
      <view class="cost-detail {{showCostDetail ? 'show' : ''}}" wx:if="{{showCostDetail}}">
        <view class="cost-item">
          <text class="cost-label">期权费用</text>
          <text class="cost-amount">3.5万</text>
        </view>
        <view class="cost-item">
          <text class="cost-label">前端费用</text>
          <text class="cost-amount">1.5万</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 持仓列表 -->
  <view class="position-list" wx:if="{{positionList.length > 0}}">
    <view class="position-item" 
          wx:for="{{positionList}}" 
          wx:key="id"
          data-position="{{item}}"
          bindtap="viewPositionDetail">
      <view class="position-header">
        <view class="position-type">{{item.type}}</view>
        <view class="position-scale">{{item.scale}}万</view>
      </view>
      
      <view class="position-info">
        <view class="info-row">
          <text class="label">标的:</text>
          <text class="value">{{item.underlyingAsset}}</text>
        </view>
        
        <view class="info-row">
          <text class="label">现价:</text>
          <text class="value">{{item.currentPrice}}</text>
          <text class="label">执行价:</text>
          <text class="value">{{item.strikePrice}}</text>
        </view>
        
        <view class="info-row">
          <text class="label">距执行价:</text>
          <text class="value {{item.distanceToStrike >= 0 ? 'profit' : 'loss'}}">
            {{item.distanceToStrike}}%
          </text>
        </view>
        
        <view class="info-row">
          <text class="label">净盈利:</text>
          <text class="value {{item.profitLoss >= 0 ? 'profit' : 'loss'}}">
            {{item.profitLoss}}
          </text>
          <text class="label">净利率:</text>
          <text class="value {{item.profitRate >= 0 ? 'profit' : 'loss'}}">
            {{item.profitRate}}%
          </text>
        </view>
      </view>
      
      <view class="position-status">
        <text class="status">{{item.status}}</text>
        <text class="dates">{{item.createTime}} - {{item.expireTime}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <image src="/images/empty.png" class="empty-icon"></image>
    <text class="empty-text">选择账户，无持仓展示。</text>
  </view>

  <!-- 底部导航栏 -->
  <view class="bottom-nav">
    <view class="nav-item" bindtap="goToHome">
      <image src="/images/home.png" class="nav-icon"></image>
      <text class="nav-text">首页</text>
    </view>
    
    <view class="nav-item" bindtap="goToInquiry">
      <image src="/images/inquiry.png" class="nav-icon"></image>
      <text class="nav-text">询价</text>
    </view>
    
    <view class="nav-item active">
      <image src="/images/account-active.png" class="nav-icon"></image>
      <text class="nav-text">账户</text>
    </view>
    
    <view class="nav-item" bindtap="goToProfile">
      <image src="/images/profile.png" class="nav-icon"></image>
      <text class="nav-text">我的</text>
    </view>
  </view>
</view>