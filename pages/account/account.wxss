/* pages/account/account.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* 页面头部 */
.header {
  background-color: #fff;
  padding: 20rpx 30rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 40rpx;
  margin-bottom: 20rpx;
}

.time {
  font-size: 28rpx;
  font-weight: 600;
}

.signal-icons {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.signal-icon, .battery-icon {
  width: 24rpx;
  height: 24rpx;
}

.title-bar {
  display: flex;
  align-items: center;
  height: 60rpx;
}

.back-btn {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
}

/* 账户选择器 */
.account-selector {
  margin: 30rpx;
  position: relative;
}

.selector-container {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.account-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.dropdown-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 20rpx;
}

.dropdown-list {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  z-index: 1000;
  margin-top: 10rpx;
  opacity: 0;
  transform: translateY(-10rpx);
  transition: all 0.3s ease;
}

.dropdown-list.show {
  opacity: 1;
  transform: translateY(0);
}

.dropdown-item {
  padding: 24rpx 30rpx;
  font-size: 32rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item:active {
  background-color: #f8f8f8;
}

/* 录持仓按钮 */
.add-position-btn {
  margin: 0 30rpx 30rpx;
  background-color: #4298EF;
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.add-position-btn:active {
  background-color: #3482d1;
}

/* 账户概览 */
.account-overview {
  margin: 0 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.tab-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-list {
  display: flex;
  gap: 40rpx;
}

.tab-item {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 0;
  position: relative;
}

.tab-item.active {
  color: #4298EF;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: #4298EF;
  border-radius: 2rpx;
}

.data-explanation {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #666;
}

.info-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 账户统计 */
.account-stats {
  padding: 30rpx;
}

.stat-row {
  margin-bottom: 30rpx;
}

.stat-row:last-child {
  margin-bottom: 0;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-label {
  font-size: 28rpx;
  color: #666;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.stat-value.main {
  color: #4298EF;
  font-size: 36rpx;
}

.stat-value.profit {
  color: #03B615;
}

.stat-value.loss {
  color: #FF4444;
}

/* 投入成本 */
.cost-section {
  border-top: 1rpx solid #f0f0f0;
}

.cost-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  gap: 20rpx;
}

.cost-title {
  font-size: 28rpx;
  color: #666;
}

.cost-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
}

.cost-detail {
  padding: 0 30rpx 30rpx;
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transition: all 0.3s ease;
}

.cost-detail.show {
  opacity: 1;
  max-height: 200rpx;
}

.cost-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.cost-label {
  font-size: 26rpx;
  color: #999;
}

.cost-amount {
  font-size: 26rpx;
  color: #333;
}

/* 持仓列表 */
.position-list {
  margin: 30rpx;
}

.position-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.position-item:last-child {
  margin-bottom: 0;
}

.position-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.position-type {
  font-size: 32rpx;
  color: #4298EF;
  font-weight: 600;
}

.position-scale {
  font-size: 28rpx;
  color: #666;
}

.position-info {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
}

.value {
  font-size: 26rpx;
  color: #333;
}

.value.profit {
  color: #03B615;
}

.value.loss {
  color: #FF4444;
}

.position-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.status {
  font-size: 26rpx;
  color: #4298EF;
  font-weight: 600;
}

.dates {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 30rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部导航栏 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.nav-item.active .nav-text {
  color: #4298EF;
}

.nav-icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-text {
  font-size: 20rpx;
  color: #666;
}