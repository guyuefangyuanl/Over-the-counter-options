<view class="container">
  <view class="list">
    <view class="item" wx:for="{{items}}" wx:key="_id">
      <view class="row">
        <text class="type {{item.type}}">{{item.type === 'deposit' ? '充值' : item.type === 'withdraw' ? '提现' : item.type}}</text>
        <text class="amount {{item.amount >= 0 ? 'plus' : 'minus'}}">{{item.amount > 0 ? '+' : ''}}{{item.amount}}</text>
      </view>
      <view class="row sub">
        <text class="time">{{item.created_at}}</text>
        <text class="balance">余额: {{item.balance_after}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && items.length === 0}}">暂无记录</view>
  </view>
</view>
