.container {
  padding: 0;
  background: #f5f5f5;
  min-height: 100vh;
}
.list {
  background: #fff;
}
.item {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}
.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.sub {
  margin-bottom: 0;
}
.type {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}
.amount {
  font-size: 32rpx;
  font-weight: bold;
}
.amount.plus { color: #52c41a; }
.amount.minus { color: #333; }

.time {
  font-size: 24rpx;
  color: #999;
}
.balance {
  font-size: 24rpx;
  color: #666;
}
.empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
