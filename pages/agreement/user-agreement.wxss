/* 用户协议页面样式 */
.agreement-container {
  min-height: 100vh;
  background: #f8f9fa;
  display: flex;
  flex-direction: column;
}

.agreement-header {
  background: #ffffff;
  padding: 40rpx 30rpx 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}

.agreement-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.update-time {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.agreement-content {
  flex: 1;
  padding: 20rpx 30rpx 120rpx;
  height: calc(100vh - 200rpx);
}

.section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #409EFF;
  padding-left: 20rpx;
}

.section-content {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #666666;
  text-align: justify;
  white-space: pre-line;
}

.agreement-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.back-btn,
.agree-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  background: #f5f5f5;
  color: #666666;
}

.agree-btn {
  background: #409EFF;
  color: #ffffff;
}

.back-btn:hover {
  background: #e9e9e9;
}

.agree-btn:hover {
  background: #3a8ee6;
}