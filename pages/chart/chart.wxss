/* 价格趋势图表页面样式 */
.chart-container {
  padding: 0;
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 页面头部 */
.chart-header {
  background: white;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid #f0f0f0;
}

.option-info {
  display: flex;
  flex-direction: column;
}

.option-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.option-strike {
  font-size: 24rpx;
  color: #666;
}

.share-btn {
  background: #007aff;
  color: white;
  border: none;
  padding: 15rpx 25rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 图表类型切换 */
.chart-types {
  background: white;
  padding: 0 30rpx;
}

.type-tabs {
  display: flex;
  border-bottom: 2rpx solid #f0f0f0;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 25rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.type-tab.active {
  color: #007aff;
  font-weight: bold;
}

.type-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #007aff;
  border-radius: 2rpx;
}

/* 图表区域 */
.chart-area {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.chart-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.chart-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: #999;
}

.chart-loading text {
  margin-top: 20rpx;
  font-size: 26rpx;
}

/* 简化图表 */
.simple-chart {
  height: 400rpx;
  position: relative;
}

.chart-grid {
  display: flex;
  height: 300rpx;
  position: relative;
}

.y-axis {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-right: 15rpx;
}

.y-label {
  font-size: 20rpx;
  color: #999;
  text-align: right;
}

.chart-content {
  flex: 1;
  position: relative;
  border-left: 2rpx solid #e0e0e0;
  border-bottom: 2rpx solid #e0e0e0;
}

.data-points {
  position: relative;
  width: 100%;
  height: 100%;
}

.data-point {
  position: absolute;
  transform: translate(-50%, 50%);
}

.point-dot {
  width: 8rpx;
  height: 8rpx;
  background: #007aff;
  border-radius: 50%;
  position: relative;
}

.point-value {
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #007aff;
  background: white;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.2s;
}

.data-point:hover .point-value {
  opacity: 1;
}

.chart-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.x-axis {
  display: flex;
  justify-content: space-between;
  margin-top: 15rpx;
  padding-left: 80rpx;
}

.x-label {
  font-size: 20rpx;
  color: #999;
}

/* 时间范围选择 */
.time-range {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.range-tabs {
  display: flex;
  background: #f8f8f8;
  border-radius: 15rpx;
  padding: 8rpx;
}

.range-tab {
  flex: 1;
  text-align: center;
  padding: 15rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 10rpx;
  transition: all 0.2s ease;
}

.range-tab.active {
  background: #007aff;
  color: white;
}

/* 数据统计 */
.chart-stats {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.stat-item {
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stat-value.high {
  color: #4caf50;
}

.stat-value.low {
  color: #f44336;
}

/* 响应式适配 */
@media (max-width: 750rpx) {
  .chart-area {
    margin: 15rpx;
    padding: 25rpx;
  }
  
  .simple-chart {
    height: 350rpx;
  }
  
  .chart-grid {
    height: 250rpx;
  }
}