<!--价格趋势图表页面-->
<view class="chart-container">
  <!-- 页面头部 -->
  <view class="chart-header">
    <view class="option-info" wx:if="{{selectedOption}}">
      <text class="option-name">{{selectedOption.optionType}}</text>
      <text class="option-strike">执行价: {{selectedOption.strikePrice}}</text>
    </view>
    <view class="chart-actions">
      <button class="share-btn" bindtap="onShare">
        <icon type="share" size="16"></icon>
        分享
      </button>
    </view>
  </view>

  <!-- 图表类型切换 -->
  <view class="chart-types">
    <view class="type-tabs">
      <view 
        class="type-tab {{chartType === 'price' ? 'active' : ''}}"
        data-type="price"
        bindtap="onChartTypeChange"
      >
        价格
      </view>
      <view 
        class="type-tab {{chartType === 'volatility' ? 'active' : ''}}"
        data-type="volatility"
        bindtap="onChartTypeChange"
      >
        波动率
      </view>
      <view 
        class="type-tab {{chartType === 'greeks' ? 'active' : ''}}"
        data-type="greeks"
        bindtap="onChartTypeChange"
      >
        希腊字母
      </view>
    </view>
  </view>

  <!-- 图表区域 -->
  <view class="chart-area">
    <view class="chart-title">{{chartTitle}}</view>
    
    <!-- 加载状态 -->
    <view class="chart-loading" wx:if="{{loading}}">
      <icon type="waiting" size="20"></icon>
      <text>加载中...</text>
    </view>
    
    <!-- 简化版图表显示 -->
    <view class="simple-chart" wx:else>
      <view class="chart-grid">
        <!-- Y轴标签 -->
        <view class="y-axis">
          <view class="y-label" wx:for="{{yAxisLabels}}" wx:key="*this">
            {{item}}
          </view>
        </view>
        
        <!-- 图表数据点 -->
        <view class="chart-content">
          <view class="data-points">
            <view 
              class="data-point" 
              wx:for="{{chartData}}" 
              wx:key="time"
              style="left: {{item.leftPercent}}; bottom: {{item.bottomPercent}}"
            >
              <view class="point-dot"></view>
              <view class="point-value">{{item.value}}</view>
            </view>
          </view>
          
          <!-- 连接线 -->
          <view class="chart-line">
            <view class="line-segment" wx:for="{{chartData}}" wx:key="time"></view>
          </view>
        </view>
      </view>
      
      <!-- X轴时间标签 -->
      <view class="x-axis">
        <view 
          class="x-label" 
          wx:for="{{xAxisLabels}}"
          wx:key="*this"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <!-- 时间范围选择 -->
  <view class="time-range">
    <view class="range-tabs">
      <view 
        class="range-tab {{timeRange === '1D' ? 'active' : ''}}"
        data-range="1D"
        bindtap="onTimeRangeChange"
      >
        1日
      </view>
      <view 
        class="range-tab {{timeRange === '1W' ? 'active' : ''}}"
        data-range="1W"
        bindtap="onTimeRangeChange"
      >
        1周
      </view>
      <view 
        class="range-tab {{timeRange === '1M' ? 'active' : ''}}"
        data-range="1M"
        bindtap="onTimeRangeChange"
      >
        1月
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="chart-stats" wx:if="{{chartData.length > 0}}">
    <view class="stat-item">
      <text class="stat-label">最高</text>
      <text class="stat-value high">{{chartStats.max}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">最低</text>
      <text class="stat-value low">{{chartStats.min}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">平均</text>
      <text class="stat-value">{{chartStats.avg}}</text>
    </view>
  </view>
</view>