<!--登录页面-->
<view class="login-container">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="circle circle1"></view>
    <view class="circle circle2"></view>
    <view class="circle circle3"></view>
  </view>

  <!-- 顶部Logo区域 -->
  <view class="header-section">
    <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
    <text class="app-name">场外期权交易平台</text>
    <text class="app-slogan">专业、安全、便捷的期权交易体验</text>
  </view>

  <!-- 登录方式切换 -->
  <view class="login-tabs">
    <view class="tab-item {{currentTab === 'wechat' ? 'active' : ''}}" bindtap="switchTab" data-tab="wechat">
      <text>微信登录</text>
    </view>
    <view class="tab-item {{currentTab === 'qq' ? 'active' : ''}}" bindtap="switchTab" data-tab="qq">
      <text>QQ登录</text>
    </view>
    <view class="tab-item {{currentTab === 'phone' ? 'active' : ''}}" bindtap="switchTab" data-tab="phone">
      <text>手机登录</text>
    </view>
  </view>

  <!-- 登录内容区域 -->
  <view class="login-content">
    
    <!-- 微信登录 -->
    <view class="login-panel" wx:if="{{currentTab === 'wechat'}}">
      <view class="panel-header">
        <image class="login-icon" src="/images/wechat-icon.png" mode="aspectFit"></image>
        <text class="panel-title">微信一键登录</text>
        <text class="panel-desc">使用微信授权快速登录</text>
      </view>
      
      <!-- 添加授权登录按钮 -->
      <button class="login-btn wechat-btn" bindtap="onWechatAuthLogin" disabled="{{isLoading}}">
        <image class="btn-icon" src="/images/wechat-white.png" mode="aspectFit"></image>
        <text>{{isLoading ? '登录中...' : '微信授权登录'}}</text>
      </button>
      
      <view class="login-tips">
        <text>• 首次登录将自动创建账户</text>
        <text>• 我们将获取您的头像和昵称信息</text>
      </view>
    </view>

    <!-- QQ登录 -->
    <view class="login-panel" wx:if="{{currentTab === 'qq'}}">
      <view class="panel-header">
        <image class="login-icon" src="/images/qq-icon.png" mode="aspectFit"></image>
        <text class="panel-title">QQ快速登录</text>
        <text class="panel-desc">使用QQ账号快速登录</text>
      </view>
      
      <button class="login-btn qq-btn" bindtap="onQQLogin" disabled="{{isLoading}}">
        <image class="btn-icon" src="/images/qq-white.png" mode="aspectFit"></image>
        <text>{{isLoading ? '登录中...' : 'QQ授权登录'}}</text>
      </button>
      
      <view class="login-tips">
        <text>• 安全快速，无需输入密码</text>
        <text>• 支持QQ账号一键登录</text>
      </view>
    </view>

    <!-- 手机号登录 -->
    <view class="login-panel" wx:if="{{currentTab === 'phone'}}">
      <view class="panel-header">
        <image class="login-icon" src="/images/phone-icon.png" mode="aspectFit"></image>
        <text class="panel-title">手机号登录</text>
        <text class="panel-desc">使用手机号验证码登录</text>
      </view>
      
      <view class="form-section">
        <view class="input-group">
          <image class="input-icon" src="/images/phone.png" mode="aspectFit"></image>
          <input class="phone-input" placeholder="请输入手机号码" type="number" maxlength="11" 
                 value="{{phoneForm.phone}}" bindinput="onPhoneInput"/>
        </view>
        
        <view class="input-group">
          <image class="input-icon" src="/images/code.png" mode="aspectFit"></image>
          <input class="code-input" placeholder="请输入验证码" type="number" maxlength="6"
                 value="{{phoneForm.code}}" bindinput="onCodeInput"/>
          <button class="send-code-btn {{canSendCode ? '' : 'disabled'}}" 
                  bindtap="sendSmsCode" disabled="{{!canSendCode}}">
            <text>{{codeButtonText}}</text>
          </button>
        </view>
      </view>
      
      <button class="login-btn phone-btn" bindtap="onPhoneLogin" 
              disabled="{{isLoading || !phoneForm.phone || !phoneForm.code}}">
        <image class="btn-icon" src="/images/phone-white.png" mode="aspectFit"></image>
        <text>{{isLoading ? '登录中...' : '验证码登录'}}</text>
      </button>
      
      <view class="login-tips">
        <text>• 未注册用户将自动创建账户</text>
        <text>• 验证码有效期5分钟</text>
      </view>
    </view>
  </view>

  <!-- 协议区域 -->
  <view class="agreement-section">
    <view class="agreement-check">
      <checkbox class="agreement-checkbox" checked="{{agreedToTerms}}" bindtap="toggleAgreement"/>
      <text class="agreement-text">
        我已阅读并同意
        <text class="link-text" bindtap="showUserAgreement">《用户协议》</text>
        和
        <text class="link-text" bindtap="showPrivacyPolicy">《隐私政策》</text>
      </text>
    </view>
  </view>

  <!-- 其他登录方式 -->
  <view class="other-login" wx:if="{{currentTab !== 'phone'}}">
    <view class="divider">
      <text>其他登录方式</text>
    </view>
    <view class="quick-login">
      <view class="quick-item" bindtap="switchTab" data-tab="phone">
        <image class="quick-icon" src="/images/phone-icon.png" mode="aspectFit"></image>
        <text>手机号</text>
      </view>
      <view class="quick-item" bindtap="onGuestLogin">
        <image class="quick-icon" src="/images/guest-icon.png" mode="aspectFit"></image>
        <text>游客体验</text>
      </view>
    </view>
  </view>

  <!-- 帮助区域 -->
  <view class="help-section">
    <view class="help-item" bindtap="showLoginHelp">
      <image class="help-icon" src="/images/help.png" mode="aspectFit"></image>
      <text>登录遇到问题？</text>
    </view>
    <view class="help-item" bindtap="contactService">
      <image class="help-icon" src="/images/service.png" mode="aspectFit"></image>
      <text>联系客服</text>
    </view>
  </view>
</view>

<!-- 加载遮罩 -->
<view class="loading-overlay" wx:if="{{isLoading}}">
  <view class="loading-content">
    <!-- 使用 wx.showLoading 替代 loading.gif -->
    <view class="loading-spinner"></view>
    <text class="loading-text">{{loadingText}}</text>
  </view>
</view>