# ===========================================
# Flask 股票数据服务 - 环境变量配置示例
# ===========================================

# 应用配置
NODE_ENV=development
FLASK_PORT=5000
FLASK_APP=app.py

# 跨域配置（与Node.js保持一致）
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080

# 数据源配置
STOCK_DATA_SOURCE=akshare

# 缓存配置
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/flask.log

# 数据库配置（如果需要）
DATABASE_URL=sqlite:///stock_data.db

# 微信云开发配置（必填，用于同步行情到微信端）
WX_APPID=your_appid_here
WX_SECRET=your_secret_here
WX_CLOUD_ENV=your_env_id_here
# 是否验证 SSL 证书（如果在某些受限网络下出现 SSLError，可设为 false）
WX_VERIFY_SSL=true

# API限流
API_RATE_LIMIT=100

# 第三方API密钥
AKSHARE_TOKEN=

# ===========================================
# 管理后台账号与权限（Flask /api/v1/auth）
# ===========================================
# 默认账号（仅用于开发/兜底，不建议生产使用明文密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_ROLE=admin

# 多账号配置（JSON，建议放到 .env.local 并按公司安全要求保管）
# 说明：
# - role 可选：viewer / editor / admin
# - password_hash 支持 pbkdf2_sha256$<iterations>$<salt_b64>$<hash_b64> 格式
# - password 字段仅用于开发临时配置，不建议生产使用
# ADMIN_USERS_JSON=[{"username":"alice","role":"admin","password_hash":"..."},{"username":"bob","role":"viewer","password":"dev-only"}]
