# ===========================================
# Flask 股票数据服务 - 环境变量配置示例
# ===========================================

# 应用配置
NODE_ENV=development
FLASK_PORT=5000
FLASK_APP=app.py

# 跨域配置（与Node.js保持一致）
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080

# 数据源配置
STOCK_DATA_SOURCE=akshare

# 缓存配置
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/flask.log

# 数据库配置（如果需要）
DATABASE_URL=sqlite:///stock_data.db

# 微信云开发配置（必填，用于同步行情到微信端）
WX_APPID=your_appid_here
WX_SECRET=your_secret_here
WX_CLOUD_ENV=your_env_id_here

# API限流
API_RATE_LIMIT=100

# 第三方API密钥
AKSHARE_TOKEN=
