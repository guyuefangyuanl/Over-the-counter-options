# ===========================================
# Flask 股票数据服务 - 环境变量配置示例
# ===========================================

# 应用配置
NODE_ENV=production
FLASK_PORT=5000
FLASK_APP=app.py

# 跨域配置
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,https://your-admin-domain.com

# 安全配置 (CRITICAL)
# 生产环境必须修改此密钥！建议使用 `openssl rand -hex 32` 生成
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=86400

# 数据源配置
STOCK_DATA_SOURCE=akshare

# 缓存配置
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/flask.log

# 数据库配置 (MongoDB)
# DATABASE_URL=mongodb://user:pass@localhost:27017/option_data

# 微信云开发配置（必填，用于同步行情到微信端）
WX_APPID=your_appid_here
WX_SECRET=your_secret_here
WX_CLOUD_ENV=your_env_id_here
# 是否验证 SSL 证书（如果在某些受限网络下出现 SSLError，可设为 false）
WX_VERIFY_SSL=true

# API限流
API_RATE_LIMIT=100

# ===========================================
# 管理后台账号与权限（Flask /api/v1/auth）
# ===========================================
# 默认账号（仅用于开发/兜底，不建议生产使用明文密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_ROLE=admin
